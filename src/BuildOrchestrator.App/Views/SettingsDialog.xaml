<UserControl x:Class="BuildOrchestrator.App.Views.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels"
             xmlns:app="clr-namespace:BuildOrchestrator.App"
             Visibility="Collapsed" Focusable="True">
  <!-- [D7/T66] İlk modal diyalog. Tam-kanama scrim (Brush.Scrim) uygulamayı kaplar; ortada 760px Ds.Dialog
       (Brush.SurfaceRaised — README §2.9'daki surface-overlay sapması burada KAYITLI, kod kazanır). Diyaloğun
       mantığı SettingsDraftViewModel'de (test edilebilir, WPF'siz); bu view ince kabuktur. BuildApp.jsx:988-1069. -->
  <!-- [D7 re-review][Fix1] Klavye odak tuzağı: scrim sadece FARE'yi bloklardı, Tab arka plandaki kontrollere
       kaçabiliyordu (ör. Settings açıkken Tab → arka plan Build → Space/Enter run başlatır). Cycle + IsFocusScope
       odağı bu alt-ağaçta HAPSEDER (bkz. SettingsDialog.xaml.cs Open() — ilk odak da buraya taşınır). -->
  <Grid x:Name="Scrim" Background="{DynamicResource Brush.Scrim}" MouseLeftButtonDown="OnScrimClick"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.ControlTabNavigation="Cycle"
        FocusManager.IsFocusScope="True">
    <!-- [DEĞİŞEN KURAL — design v1.13.1] Genişlik 620 → 760: üç dialog aynı 620 kalıbını paylaşıyordu, artık
         her biri büyüme yönüne göre ölçülüyor; Settings en çok büyüyecek olan (root + katman kartları, yarın
         MSBuild yolu/paralellik/worktree/bildirim). [design v1.14.0 · ruling task-D6] Kökte ARTIK MaxHeight
         YOK: eski 640 sabiti gövdenin (Grid.Row="1") kendi min(56vh,460px) sınırıyla (bkz. SettingsBodyHeight)
         hiç ÇAKIŞMAZ ama hiç BAĞLAMAZ da — gövde en çok 460 + başlık/footer'ın kendi Auto yüksekliği ≈576px'e
         ulaşır, 640 asla devreye girmeyen ölü bir tavan kalırdı (iki doğruluk kaynağı, kopya YASAK). Yükseklik
         artık TEK yerden, gövdenin kendi Min/MaxHeight'ından yönetilir. -->
    <Border Width="760" HorizontalAlignment="Center" VerticalAlignment="Center"
            Style="{DynamicResource Ds.Dialog}" MouseLeftButtonDown="OnDialogClick">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ BAŞLIK ============================ -->
        <TextBlock Grid.Row="0" Text="Settings" Margin="20,16,20,10"
                   FontSize="{DynamicResource FontSize.Lg}"
                   FontWeight="{DynamicResource FontWeight.Emphasis}"
                   Foreground="{DynamicResource Brush.TextPrimary}" />

        <!-- ============================ GÖVDE ============================
             [design v1.14.0 §2.9 · ruling task-D6] Kendi içinde kaydırılır: üst sınır min(pencere-yüksekliği ×
             56%, 460px) — hesap SettingsBodyHeight'ta (kopya YASAK), kablaj SettingsDialog.xaml.cs
             Open()/TrackHostWindowSize()'da (pencere yeniden boyutlandığında YENİDEN çağrılır). Alt taban
             300px MinHeight'a SABİT bağlanır (katman listesi boşken dialog çökmesin).
             VerticalScrollBarVisibility="Visible" (Auto DEĞİL): scrollbar sütunu HER ZAMAN ayrılır, prototipin
             `padding-right:10px / margin-right:-10px` hilesinin WPF karşılığı — bar gerektiğinde belirmesi
             içeriği daraltmaz. Kaydıracak şey yokken DS'in kendi IsEnabled=False tetikleyicisi track'i gizler
             (ScrollBarStyleTests — "restraint"), yani boşken çirkin dolu bir hap da GÖRÜNMEZ. -->
        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Visible"
                      MinHeight="{x:Static controls:SettingsBodyHeight.MinFloor}" Padding="20,0,20,4">
          <StackPanel>
            <!-- ============================ WORKSPACE (design v1.8.0 §2.9) ============================
                 Repository root ARTIK Settings'in bir parçası ve bölümlerin İLKİ: başlamak için gereken ayar
                 sayısı arttığından (kök + katmanlar) first-run bir klasör seçiciye değil buraya açılıyor.
                 Root boşken Save disabled — uygulamanın çalışması için zorunlu TEK ayar budur (CanSave).
                 [DEĞİŞEN KURAL] Bu bölüm eskiden en ALTTA "REPOSITORY" başlığıyla ve tek satırlık bir yol
                 etiketi + "Change…" düğmesiyle duruyordu; artık düzenlenebilir mono bir input + Browse…'dur. -->
            <TextBlock Text="WORKSPACE" Margin="0,0,0,6"
                       FontFamily="{x:Static controls:AppFonts.Ui}"
                       FontSize="{DynamicResource FontSize.2xs}"
                       FontWeight="{DynamicResource FontWeight.Emphasis}"
                       Foreground="{DynamicResource Brush.TextFaint}" />
            <TextBlock Text="Repository root — the folder that holds the OSYS solutions. Projects and the dependency graph are discovered from it on Sync."
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       FontSize="{DynamicResource FontSize.Xs}"
                       Foreground="{DynamicResource Brush.TextDim}" />
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Margin="10,0,0,0" Click="OnChangeRepository"
                      AutomationProperties.Name="{x:Static app:AccessibilityNames.BrowseRepositoryRoot}"
                      Style="{DynamicResource Ds.Button.Secondary.Sm}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                    <Canvas Width="24" Height="24">
                      <Path Data="{DynamicResource Icon.Folder}"
                            StrokeThickness="{DynamicResource Icon.Folder.StrokeThickness}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="Browse…" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBox x:Name="RepoRootInput" VerticalAlignment="Center"
                       Style="{DynamicResource Ds.Input}"
                       FontFamily="{x:Static controls:AppFonts.Mono}"
                       controls:DsChrome.Watermark="D:\src\osys"
                       AutomationProperties.Name="{x:Static app:AccessibilityNames.RepositoryRootInput}"
                       Text="{Binding RepositoryRoot, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <!-- 18px boşluk + 1px ayraç, sonra Layers (§2.9). -->
            <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource Brush.BorderSubtle}" />

            <!-- LAYERS caps + açıklama (BİREBİR; "Other" mono) -->
            <TextBlock Text="LAYERS" Margin="0,0,0,6"
                       FontFamily="{x:Static controls:AppFonts.Ui}"
                       FontSize="{DynamicResource FontSize.2xs}"
                       FontWeight="{DynamicResource FontWeight.Emphasis}"
                       Foreground="{DynamicResource Brush.TextFaint}" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       FontSize="{DynamicResource FontSize.Xs}"
                       Foreground="{DynamicResource Brush.TextDim}"><Run
                       Text="Projects are grouped by the first matching pattern (regex on the project name), top to bottom; card order is the layer order in the list. Non-matching projects fall under " /><Run
                       Text="Other" FontFamily="{x:Static controls:AppFonts.Mono}" /><Run Text="." /></TextBlock>

            <!-- Boş durum (kesikli kutu) — yalnız katman yokken -->
            <Grid x:Name="EmptyState">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Layers.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Rectangle Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4 3"
                         RadiusX="6" RadiusY="6" SnapsToDevicePixels="True" />
              <TextBlock Text="No layers yet — projects show as a single list in build order."
                         Margin="16,14" TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSize.Xs}"
                         Foreground="{DynamicResource Brush.TextDim}" />
            </Grid>

            <!-- Kolon başlıkları — yalnız katman varken -->
            <Grid Margin="30,0,34,4">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Layers.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <TextBlock Text="LAYER NAME" HorizontalAlignment="Left" Width="170"
                         FontFamily="{x:Static controls:AppFonts.Ui}"
                         FontSize="{DynamicResource FontSize.2xs}"
                         FontWeight="{DynamicResource FontWeight.Emphasis}"
                         Foreground="{DynamicResource Brush.TextFaint}" />
              <TextBlock Text="PATTERN" Margin="176,0,0,0" HorizontalAlignment="Left"
                         FontFamily="{x:Static controls:AppFonts.Ui}"
                         FontSize="{DynamicResource FontSize.2xs}"
                         FontWeight="{DynamicResource FontWeight.Emphasis}"
                         Foreground="{DynamicResource Brush.TextFaint}" />
            </Grid>

            <!-- Katman kartları — sürüklenebilir. Virtualization KAPALI (ItemsControl varsayılanı, A13.2). -->
            <ItemsControl x:Name="LayersList" ItemsSource="{Binding Layers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LayerRowViewModel}">
                  <Border Height="36" Margin="0,0,0,6" Padding="2,0,6,0" BorderThickness="1"
                          CornerRadius="{DynamicResource Radius.Md}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                        <Style.Triggers>
                          <!-- Sürüklenen kart: Brush.SurfaceRaised + Brush.BorderStrong (template-local, A13.2). -->
                          <DataTrigger Binding="{Binding IsDragging}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                      <!-- Grip: Mouse.Capture tabanlı sürükle (DragReorderBehavior; OLE DragDrop YASAK). -->
                      <Border DockPanel.Dock="Left" Width="20" Background="Transparent" Cursor="SizeAll"
                              controls:DragReorderBehavior.IsDragHandle="True">
                        <Border.ToolTip>
                          <ToolTip controls:AppTooltip.Side="Top">Drag to reorder</ToolTip>
                        </Border.ToolTip>
                        <Viewbox Width="16" Height="16">
                          <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource Icon.Grip}" Fill="{DynamicResource Brush.TextFaint}" />
                          </Canvas>
                        </Viewbox>
                      </Border>
                      <!-- Sil -->
                      <Button DockPanel.Dock="Right" Style="{DynamicResource Ds.IconButton}"
                              Click="OnRemoveLayer" AutomationProperties.Name="Delete layer">
                        <Button.ToolTip>
                          <ToolTip controls:AppTooltip.Side="Top">Delete layer</ToolTip>
                        </Button.ToolTip>
                        <Viewbox Width="14" Height="14">
                          <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource Icon.Trash}"
                                  StrokeThickness="{DynamicResource Icon.Trash.StrokeThickness}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <!-- Ad inputu (170px, sabit). [A13/T5] Kolon başlıkları (LAYER NAME / PATTERN) input'a
                           BAĞLI DEĞİLDİR (ayrı bir Grid'de, satır başına tekrarlamaz) ve watermark bir
                           ipucudur — ekran okuyucunun okuyacağı ad AÇIKÇA verilir. -->
                      <TextBox DockPanel.Dock="Left" Width="170" Margin="6,0,6,0" VerticalAlignment="Center"
                               Style="{DynamicResource Ds.Input}"
                               controls:DsChrome.Watermark="Layer name"
                               AutomationProperties.Name="{x:Static app:AccessibilityNames.LayerName}"
                               Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                      <!-- Regex inputu (mono, dolar; geçersizse kırmızı). Watermark bir ÖRNEK desendir
                           (`^OSYS\.Domain\.`), etiket değil — ad ayrıca verilir. -->
                      <TextBox Margin="0,0,6,0" VerticalAlignment="Center"
                               Style="{DynamicResource Ds.Input}"
                               FontFamily="{x:Static controls:AppFonts.Mono}"
                               controls:DsChrome.Watermark="^OSYS\.Domain\."
                               controls:DsChrome.IsInvalid="{Binding RegexInvalid}"
                               AutomationProperties.Name="{x:Static app:AccessibilityNames.LayerPattern}"
                               Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add layer (ghost). [A13/T5] Etiket Content'in İÇİNDEKİ TextBlock'tur; WPF'in buton peer'ı adı
                 yalnız string Content'ten türetir (ölçüldü: burada ad boş kalıyordu) → ad AÇIKÇA verilir. -->
            <Button HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnAddLayer"
                    AutomationProperties.Name="{x:Static app:AccessibilityNames.AddLayer}"
                    Style="{DynamicResource Ds.Button.Ghost.Sm}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                  <Canvas Width="24" Height="24">
                    <Path Data="{DynamicResource Icon.Plus}"
                          StrokeThickness="{DynamicResource Icon.Plus.StrokeThickness}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Add layer" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

          </StackPanel>
        </ScrollViewer>

        <!-- ============================ FOOTER ============================
             [design v1.10.0 §2.9] Solda: ghost `Load sample layers` · 1px ayraç · Export / Import / Clear ikon
             butonları. Üçü de yalnız FORMU değiştirir — Save'e kadar hiçbir şey uygulanmaz, onay dialogu da
             yoktur. Geri bildirim AYNI satırda 2.4 saniye durur (yeşil/kırmızı).
             [DEĞİŞEN KURAL] Sol düğmenin adı "Restore default layers" idi; §2.9 metni "Load sample layers"dır
             ve daha doğrudur: varsayılan konfigürasyon BOŞTUR, bu düğme örnek katmanları DOLDURUR. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
          <DockPanel Margin="20,12">
            <Button x:Name="SampleLayersButton" DockPanel.Dock="Left" Content="Load sample layers"
                    Click="OnLoadSampleLayers" Style="{DynamicResource Ds.Button.Ghost.Md}" />
            <Border DockPanel.Dock="Left" Width="1" Margin="10,4" Background="{DynamicResource Brush.BorderSubtle}" />
            <Button x:Name="ExportButton" DockPanel.Dock="Left" Style="{DynamicResource Ds.IconButton}"
                    Click="OnExport" ToolTip="Export settings…"
                    AutomationProperties.Name="{x:Static app:AccessibilityNames.ExportSettings}">
              <Viewbox Width="13" Height="13">
                <Canvas Width="24" Height="24">
                  <Path Data="{DynamicResource Icon.Download}"
                        StrokeThickness="{DynamicResource Icon.Download.StrokeThickness}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="ImportButton" DockPanel.Dock="Left" Margin="2,0,0,0"
                    Style="{DynamicResource Ds.IconButton}" Click="OnImport" ToolTip="Import settings…"
                    AutomationProperties.Name="{x:Static app:AccessibilityNames.ImportSettings}">
              <Viewbox Width="13" Height="13">
                <Canvas Width="24" Height="24">
                  <Path Data="{DynamicResource Icon.Upload}"
                        StrokeThickness="{DynamicResource Icon.Upload.StrokeThickness}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="ClearButton" DockPanel.Dock="Left" Margin="2,0,0,0"
                    Style="{DynamicResource Ds.IconButton}" Click="OnClear" ToolTip="Clear settings"
                    AutomationProperties.Name="{x:Static app:AccessibilityNames.ClearSettings}">
              <Viewbox Width="13" Height="13">
                <Canvas Width="24" Height="24">
                  <Path x:Name="ClearGlyph" Data="{DynamicResource Icon.Trash}"
                        StrokeThickness="{DynamicResource Icon.Trash.StrokeThickness}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Cancel" Click="OnCancel" Style="{DynamicResource Ds.Button.Secondary.Md}" />
              <Button x:Name="SaveButton" Content="Save" Click="OnSave" Margin="8,0,0,0"
                      IsEnabled="{Binding CanSave}" Style="{DynamicResource Ds.Button.Primary.Md}" />
            </StackPanel>
            <!-- Geri bildirim: aynı satırda, 2.4s (§2.9). Boşken yer kaplamaz. -->
            <TextBlock x:Name="FeedbackText" Margin="10,0,10,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       FontSize="{DynamicResource FontSize.Xs}" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
