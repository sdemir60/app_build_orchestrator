<controls:ModalDialog x:Class="BuildOrchestrator.App.Views.SettingsDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
                      xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels"
                      xmlns:app="clr-namespace:BuildOrchestrator.App"
                      DialogWidth="880" DialogHeight="576">
  <!-- [D7/T66 → design v1.19.0 §2.9 "sol raylı iki panel"] Kabuk üç dialogun ORTAK kabuğudur (Controls/ModalDialog
       + Ds.ModalDialog şablonu: scrim, çerçeve, köşe clip'i, odak tuzağı, Esc/scrim ile kapanma, giriş) — burada
       yalnız içerik ve ölçü durur. Diyaloğun mantığı SettingsDraftViewModel'de (test edilebilir, WPF'siz); bu view
       ince kabuktur.

       880×576 SABİT: gövde başlık satırı ile footer arasındaki alanı doldurur, sayfa kendi içinde kayar ve bölüm
       değişince dialog zıplamaz. Tek dış sınır kabuğun host − 48 kelepçesidir.
       [DEĞİŞEN KURAL — design v1.19.0] ESKİ düzen 760px genişlikte tek uzun kolondu (WORKSPACE · EXTERNAL PROJECTS ·
       LAYERS alt alta, aralarında ayraç) ve gövde yüksekliği pencerenin %56'sını 300–460px arasında izlerdi. Ayarlar
       çoğaldıkça tek kolon her eklemede sıkışıyordu; bölümler artık sol raydan seçilen sayfalardır. -->

  <controls:ModalDialog.Resources>
    <BooleanToVisibilityConverter x:Key="PageVisibility" />
  </controls:ModalDialog.Resources>

  <!-- ============================ BAŞLIK SATIRI ============================ -->
  <!-- Padding 12 12 12 18, altta border-subtle: `Settings` (14px/600) esner, sağda kapat (X) — Cancel ile aynı yol. -->
  <controls:ModalDialog.Head>
    <Border x:Name="HeadRow" Padding="18,12,12,12" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource Brush.BorderSubtle}">
      <DockPanel>
        <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnCancel"
                Style="{DynamicResource Ds.IconButton}" ToolTip="Close"
                AutomationProperties.Name="{x:Static app:AccessibilityNames.CloseSettings}">
          <Viewbox Width="12" Height="12">
            <Canvas Width="24" Height="24">
              <Path Data="{DynamicResource Icon.Close}"
                    StrokeThickness="{DynamicResource Icon.Close.StrokeThickness}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <TextBlock Text="Settings" VerticalAlignment="Center" Style="{DynamicResource Ds.Settings.PaneTitle}" />
      </DockPanel>
    </Border>
  </controls:ModalDialog.Head>

  <!-- ============================ FOOTER ============================
       [design v1.10.0 → v1.19.0 §2.9] Solda Export / Import / Clear ikon butonları. Üçü de yalnız FORMU değiştirir —
       Save'e kadar hiçbir şey uygulanmaz, onay dialogu da yoktur. Geri bildirim AYNI satırda 2.4 saniye durur
       (yeşil/kırmızı); geri bildirim yokken ve Save kapalıyken yerini tek satırlık NEDEN alır.
       [DEĞİŞEN KURAL — design v1.19.0] Soldaki ghost `Load sample layers` düğmesi ve ayracı KALKTI (ön-dolum yok). -->
  <controls:ModalDialog.Footer>
    <DockPanel>
      <Button x:Name="ExportButton" DockPanel.Dock="Left" Style="{DynamicResource Ds.IconButton}"
              Click="OnExport" ToolTip="Export settings — the whole form as a JSON file"
              AutomationProperties.Name="{x:Static app:AccessibilityNames.ExportSettings}">
        <Viewbox Width="13" Height="13">
          <Canvas Width="24" Height="24">
            <Path Data="{DynamicResource Icon.Download}"
                  StrokeThickness="{DynamicResource Icon.Download.StrokeThickness}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Canvas>
        </Viewbox>
      </Button>
      <Button x:Name="ImportButton" DockPanel.Dock="Left" Margin="2,0,0,0"
              Style="{DynamicResource Ds.IconButton}" Click="OnImport"
              ToolTip="Import settings — fill this form from a JSON file"
              AutomationProperties.Name="{x:Static app:AccessibilityNames.ImportSettings}">
        <Viewbox Width="13" Height="13">
          <Canvas Width="24" Height="24">
            <Path Data="{DynamicResource Icon.Upload}"
                  StrokeThickness="{DynamicResource Icon.Upload.StrokeThickness}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Canvas>
        </Viewbox>
      </Button>
      <Button x:Name="ClearButton" DockPanel.Dock="Left" Margin="2,0,0,0"
              Style="{DynamicResource Ds.IconButton}" Click="OnClear" ToolTip="Clear settings — empty the form"
              AutomationProperties.Name="{x:Static app:AccessibilityNames.ClearSettings}">
        <Viewbox Width="13" Height="13">
          <Canvas Width="24" Height="24">
            <Path x:Name="ClearGlyph" Data="{DynamicResource Icon.Trash}"
                  StrokeThickness="{DynamicResource Icon.Trash.StrokeThickness}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Canvas>
        </Viewbox>
      </Button>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel" Style="{DynamicResource Ds.Button.Secondary.Md}" />
        <Button x:Name="SaveButton" Content="Save" Click="OnSave" Margin="8,0,0,0"
                IsEnabled="{Binding CanSave}" Style="{DynamicResource Ds.Button.Primary.Md}" />
      </StackPanel>
      <!-- Geri bildirim ve neden AYNI yuvayı paylaşır: neden yalnız geri bildirim satırı boşken görünür. Neden metni
           taslaktan gelir (SaveBlockedReason — Save açıkken null ve satır Collapsed). -->
      <Grid Margin="10,0" VerticalAlignment="Center">
        <TextBlock x:Name="FeedbackText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   FontSize="{DynamicResource FontSize.Xs}" />
        <TextBlock x:Name="BlockedReasonText" Text="{Binding SaveBlockedReason}"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   FontSize="{DynamicResource FontSize.Xs}" Foreground="{DynamicResource Brush.TextFaint}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=FeedbackText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Save açıkken neden YOK: boş metinli görünür bir satır bırakılmaz (sonraki tetikleyici önce gelir). -->
                <DataTrigger Binding="{Binding SaveBlockedReason}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DockPanel>
  </controls:ModalDialog.Footer>

  <!-- ============================ GÖVDE: RAY + SAYFA ============================ -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Bölüm rayı (196px): surface zemin (dialogdan bir kademe koyu — iki panel okuması buradan gelir), sağda
         border-subtle, padding 10 8. Sıra General · Workspace · External projects · Layers; sayaçlar taslaktan
         CANLI okunur (Tag → Ds.Settings.RailItem şablonu, yalnız >0 iken görünür). Açılış bölümü kod-tarafıdır
         (Open). Bölüm değişince (tıklama ya da ShowSection) sayfa en üstten başlar: sayfalar TEK ScrollViewer'ı
         paylaşır ve önceki sayfanın kaydırma payı yeniye taşınmamalı (OnSectionChecked). -->
    <Border x:Name="Rail" Grid.Column="0" Width="196" Padding="8,10" BorderThickness="0,0,1,0"
            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderSubtle}">
      <StackPanel ToggleButton.Checked="OnSectionChecked">
        <RadioButton x:Name="GeneralRailItem" Content="General" Style="{DynamicResource Ds.Settings.RailItem}" />
        <RadioButton x:Name="WorkspaceRailItem" Content="Workspace" Style="{DynamicResource Ds.Settings.RailItem}" />
        <RadioButton x:Name="ExternalRailItem" Content="External projects" Tag="{Binding Externals.Count}"
                     Style="{DynamicResource Ds.Settings.RailItem}" />
        <RadioButton x:Name="LayersRailItem" Content="Layers" Tag="{Binding Layers.Count}"
                     Style="{DynamicResource Ds.Settings.RailItem}" />
      </StackPanel>
    </Border>

    <!-- Sayfa: dikey kayar. Prototipin `20px 20px 24px` padding'i kayan içeriğin kenar boşluğudur (ScrollViewer.Padding
         kaymayan bir iç çerçeve olurdu — About/What's new ile AYNI karar). Her an TAM BİR sayfa görünür (rayın
         seçimine bağlı).
         VerticalScrollBarVisibility="Visible" (Auto DEĞİL): scrollbar sütunu HER ZAMAN ayrılır — bar gerektiğinde
         belirmesi içeriği daraltmaz. Kaydıracak şey yokken DS'in kendi IsEnabled=False tetikleyicisi track'i gizler
         (ScrollBarStyleTests — "restraint"). -->
    <ScrollViewer x:Name="Body" Grid.Column="1" VerticalScrollBarVisibility="Visible">
      <Grid Margin="20,20,20,24">

        <!-- ============================ GENERAL ============================
             [design v1.19.0 §2.9] Gruplar ve satırlar GeneralSettingsCatalog'dan (taslak: GeneralGroups) doğar; her
             satır TEK şablonla çizilir (Ds.Settings.ToggleRow) — yeni ayar = kataloğa bir satır, burada düzen işi yok.
             Grup: caps başlık (Ds.Settings.GroupHeading) → 5px → satırlar; gruplar arası 22px. Yalnız Pull before
             build davranışa bağlıdır; diğer dört anahtar henüz yalnız taslaktır (SettingsDraftViewModel.GeneralGroups). -->
        <StackPanel x:Name="GeneralPage"
                    Visibility="{Binding IsChecked, ElementName=GeneralRailItem, Converter={StaticResource PageVisibility}}">
          <TextBlock Text="General" Style="{DynamicResource Ds.Settings.PaneTitle}" />
          <TextBlock Text="How the app starts and behaves. Every setting applies when you save."
                     Style="{DynamicResource Ds.Settings.PaneDescription}" />
          <ItemsControl x:Name="GeneralGroupsList" ItemsSource="{Binding GeneralGroups}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:GeneralSettingGroupViewModel}">
                <StackPanel x:Name="Group" Margin="0,22,0,0">
                  <TextBlock Text="{Binding Title}" Style="{DynamicResource Ds.Settings.GroupHeading}" />
                  <ItemsControl Margin="0,5,0,0" Focusable="False" ItemsSource="{Binding Rows}"
                                ItemTemplate="{DynamicResource Ds.Settings.ToggleRowTemplate}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="Group" Property="Margin" Value="0" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ============================ WORKSPACE ============================
             Repository root, uygulamanın çalışması için zorunlu TEK ayardır: boşken Save kapalıdır (SaveBlockedReason).
             Kök, bir klasör seçiciye değil buraya sorulur — başlamak için gereken ayar sayısı birden fazladır. -->
        <StackPanel x:Name="WorkspacePage"
                    Visibility="{Binding IsChecked, ElementName=WorkspaceRailItem, Converter={StaticResource PageVisibility}}">
          <TextBlock Text="Workspace" Style="{DynamicResource Ds.Settings.PaneTitle}" />
          <TextBlock Text="The folder that holds the solutions. Projects and the dependency graph are discovered from it on Sync."
                     Style="{DynamicResource Ds.Settings.PaneDescription}" />
          <TextBlock Text="REPOSITORY ROOT" Margin="0,0,0,7" Style="{DynamicResource Ds.Settings.CapsHeading}" />
          <!-- Grid (DockPanel DEĞİL): input ağaçta Browse'dan ÖNCE gelir — Tab sırası input → Browse ve açılış odağı
               sayfanın ilk girdisine (input'a) düşer (ModalDialog.InitialFocusScope). -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Watermark bir ÖRNEK yoldur, ürüne özel değildir; ad ayrıca verilir. -->
            <TextBox x:Name="RepoRootInput" Grid.Column="0" VerticalAlignment="Center"
                     Style="{DynamicResource Ds.Input}"
                     FontFamily="{x:Static controls:AppFonts.Mono}"
                     controls:DsChrome.Watermark="D:\src\myapp"
                     AutomationProperties.Name="{x:Static app:AccessibilityNames.RepositoryRootInput}"
                     Text="{Binding RepositoryRoot, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Click="OnChangeRepository"
                    AutomationProperties.Name="{x:Static app:AccessibilityNames.BrowseRepositoryRoot}"
                    Style="{DynamicResource Ds.Button.Secondary.Md}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                  <Canvas Width="24" Height="24">
                    <Path Data="{DynamicResource Icon.Folder}"
                          StrokeThickness="{DynamicResource Icon.Folder.StrokeThickness}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Browse…" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Text="Required — nothing is discovered without it." Margin="0,9,0,0"
                     FontSize="{DynamicResource FontSize.2xs}" Foreground="{DynamicResource Brush.TextFaint}" />
        </StackPanel>

        <!-- ============================ EXTERNAL PROJECTS ============================
             Kart = yol (klasör / .sln / .csproj). Diyalog yolu TARAMAZ: liste Save'de UiState'e yazılır
             (SettingsDraftViewModel.CommitAsync) ve her Sync/Build komutuyla motora gider; taranan projeler ve çalışma
             kopyası kökü Core'da her koşuda yeniden çözülür (ARCHITECTURE §10.6). Kartın altındakiler ayrılmış
             "External" katmanına girer: build-order'da ana repo projelerinden önce gelirler. Kart sırası yalnız
             çalışma kopyalarının güncellenme sırasıdır. PaneHead metni git-only uyarlamadır (TFVC kaldırıldı).
             [DEĞİŞEN KURAL — design v1.19.0] ESKİ: sayfanın başında Pull before build kural satırı (hairline + caps
             etiket + switch, açıklama tooltip'te) dururdu; anahtar General'ın BUILD grubuna taşındı. -->
        <StackPanel x:Name="ExternalPage"
                    Visibility="{Binding IsChecked, ElementName=ExternalRailItem, Converter={StaticResource PageVisibility}}">
          <TextBlock Text="External projects" Style="{DynamicResource Ds.Settings.PaneTitle}" />
          <TextBlock Text="Projects outside the repository root — a folder, a solution or a project file; the git working copy is found from the path. They are built before everything else."
                     Style="{DynamicResource Ds.Settings.PaneDescription}" />

          <!-- Boş durum — Layers'ın PAYLAŞTIĞI kutu (Ds.Settings.EmptyState*). -->
          <Grid x:Name="ExternalEmptyState">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Externals.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Rectangle Style="{DynamicResource Ds.Settings.EmptyStateRectangle}" />
            <TextBlock Text="No external projects — only what is discovered under the repository root is built."
                       Style="{DynamicResource Ds.Settings.EmptyStateText}" />
          </Grid>

          <!-- Kartlar — Layers'la AYNI kart/grip/sil stilleri ve AYNI sürükle-bırak (DragReorderBehavior), AYRI koleksiyon
               (iki liste bağımsız sıralanır). Tek kolon: kolon başlığı YOK. Virtualization KAPALI (A13.2). -->
          <ItemsControl x:Name="ExternalsList" ItemsSource="{Binding Externals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ExternalRowViewModel}">
                <Border Style="{DynamicResource Ds.Settings.Card}">
                  <DockPanel LastChildFill="True">
                    <ContentControl Style="{DynamicResource Ds.Settings.CardGrip}" />
                    <Button Style="{DynamicResource Ds.Settings.CardRemove}" Click="OnRemoveExternal"
                            AutomationProperties.Name="Remove external project">
                      <Button.ToolTip>
                        <ToolTip controls:AppTooltip.Side="Top">Remove external project</ToolTip>
                      </Button.ToolTip>
                    </Button>
                    <TextBox Margin="6,0,6,0" VerticalAlignment="Center"
                             Style="{DynamicResource Ds.Input}"
                             FontFamily="{x:Static controls:AppFonts.Mono}"
                             controls:DsChrome.Watermark="C:\src\shared\MyApp.Common\MyApp.Common.csproj"
                             AutomationProperties.Name="{x:Static app:AccessibilityNames.ExternalProjectPath}"
                             Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Add external project" Click="OnAddExternal"
                  AutomationProperties.Name="Add external project"
                  Style="{DynamicResource Ds.Settings.AddRow}" />

          <!-- [design v1.19.0 §2.9] Pull before build General'a taşındı; burada NEREYE gittiği ve açık/kapalı olduğu
               yazılır (taslaktan CANLI). marginTop 20, paddingTop 14, üstte 1px border-subtle; sarmalı satır, gap 6 —
               ghost düğmenin −6 solu kendi iç boşluğunu metne yaklaştırır. Düğme rayı General'a alır. -->
          <Border x:Name="PullBeforeBuildNote" Margin="0,20,0,0" Padding="0,14,0,0" BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource Brush.BorderSubtle}">
            <WrapPanel>
              <TextBlock x:Name="PullBeforeBuildSummary" Margin="0,0,6,0" VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSize.Xs}" Foreground="{DynamicResource Brush.TextDim}"><Run
                         Text="Card order sets the order the working copies are updated. Updating them before a build is " /><Run>
                  <Run.Style>
                    <Style TargetType="Run">
                      <Setter Property="Text" Value="off" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PullExternalsBeforeBuild}" Value="True">
                          <Setter Property="Text" Value="on" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Run.Style>
                </Run><Run Text="." /></TextBlock>
              <Button x:Name="PullBeforeBuildLink" Content="Pull before build" Margin="-6,0,0,0"
                      VerticalAlignment="Center" Click="OnShowGeneral" Style="{DynamicResource Ds.Button.Ghost.Sm}" />
            </WrapPanel>
          </Border>
        </StackPanel>

        <!-- ============================ LAYERS ============================ -->
        <StackPanel x:Name="LayersPage"
                    Visibility="{Binding IsChecked, ElementName=LayersRailItem, Converter={StaticResource PageVisibility}}">
          <TextBlock Text="Layers" Style="{DynamicResource Ds.Settings.PaneTitle}" />
          <TextBlock Style="{DynamicResource Ds.Settings.PaneDescription}"><Run
                     Text="Projects are grouped by the first matching pattern (regex on the project name), top to bottom. Non-matching projects fall under " /><Run
                     Text="Other" FontFamily="{x:Static controls:AppFonts.Mono}" /><Run Text="." /></TextBlock>

          <!-- Boş durum (kesikli kutu) — kayıtlı katman yokken taslak BOŞ açılır (ön-dolum yok). -->
          <Grid x:Name="EmptyState">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Layers.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Rectangle Style="{DynamicResource Ds.Settings.EmptyStateRectangle}" />
            <TextBlock Text="No layers yet — projects show as a single list in build order."
                       Style="{DynamicResource Ds.Settings.EmptyStateText}" />
          </Grid>

          <!-- Kolon başlıkları — yalnız katman varken; padding 0 34 5 30, LAYER NAME 170 + 6 aralık + PATTERN. -->
          <Grid x:Name="LayerColumnHeader" Margin="30,0,34,5">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Layers.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <TextBlock Text="LAYER NAME" HorizontalAlignment="Left" Width="170" Style="{DynamicResource Ds.Settings.CapsHeading}" />
            <TextBlock Text="PATTERN" Margin="176,0,0,0" HorizontalAlignment="Left" Style="{DynamicResource Ds.Settings.CapsHeading}" />
          </Grid>

          <!-- Katman kartları — sürüklenebilir. Virtualization KAPALI (ItemsControl varsayılanı, A13.2). -->
          <ItemsControl x:Name="LayersList" ItemsSource="{Binding Layers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:LayerRowViewModel}">
                <Border Style="{DynamicResource Ds.Settings.Card}">
                  <DockPanel LastChildFill="True">
                    <ContentControl Style="{DynamicResource Ds.Settings.CardGrip}" />
                    <Button Style="{DynamicResource Ds.Settings.CardRemove}" Click="OnRemoveLayer"
                            AutomationProperties.Name="Delete layer">
                      <Button.ToolTip>
                        <ToolTip controls:AppTooltip.Side="Top">Delete layer</ToolTip>
                      </Button.ToolTip>
                    </Button>
                    <!-- Ad inputu (170px). [A13/T5] Kolon başlıkları input'a BAĞLI DEĞİLDİR ve watermark bir ipucudur —
                         ekran okuyucunun okuyacağı ad AÇIKÇA verilir. [design v1.19.0] Watermark satır indeksinin
                         placeholder'ıdır (LayerPlaceholders; sürükle-bırak sonrası yeni indekse göre). -->
                    <TextBox DockPanel.Dock="Left" Width="170" Margin="6,0,6,0" VerticalAlignment="Center"
                             Style="{DynamicResource Ds.Input}"
                             controls:DsChrome.Watermark="{Binding NamePlaceholder}"
                             AutomationProperties.Name="{x:Static app:AccessibilityNames.LayerName}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Regex inputu (mono, esnek; geçersizse kırmızı). -->
                    <TextBox Margin="0,0,6,0" VerticalAlignment="Center"
                             Style="{DynamicResource Ds.Input}"
                             FontFamily="{x:Static controls:AppFonts.Mono}"
                             controls:DsChrome.Watermark="{Binding PatternPlaceholder}"
                             controls:DsChrome.IsInvalid="{Binding RegexInvalid}"
                             AutomationProperties.Name="{x:Static app:AccessibilityNames.LayerPattern}"
                             Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Add layer" Click="OnAddLayer"
                  AutomationProperties.Name="{x:Static app:AccessibilityNames.AddLayer}"
                  Style="{DynamicResource Ds.Settings.AddRow}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</controls:ModalDialog>
