<!-- [worktree] Branch karar kartı: branch chip'inden seçilen branch'e geçiş kirli ağaçta durunca açılır. Kök taban tipi PopoverBase'tir
     (IsOpen + giriş + Esc + VM takası orada). Kabuk (Ds.Popover, 360px, dolgu 0) ve yerleşim (branch chip'inin 8px üstü, Popup) ActionBar.xaml'
     dedir; burada yalnız gövde vardır: iki blok, aralarında 1px border — Exit kartının ailesi (ExitCard.xaml). İçerik
     RunViewModel.PendingBranchSwitch'tir (BranchSwitchCard.xaml.cs RefreshContent); metinler BranchSwitchText'ten. -->
<views:PopoverBase x:Class="BuildOrchestrator.App.Views.BranchSwitchCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildOrchestrator.App"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels"
             xmlns:views="clr-namespace:BuildOrchestrator.App.Views"
             AutomationProperties.Name="{x:Static local:AccessibilityNames.BranchSwitchCard}">
  <StackPanel>
    <!-- (1) DURUM — padding 13 16 14: caps etiket (11px text-faint); 8px altında tek cümle (13px/500 text-primary). -->
    <Border Padding="16,13,16,14">
      <StackPanel>
        <controls:TrackedTextBlock x:Name="PART_Heading" Text="{x:Static vm:BranchSwitchText.Heading}"
                                   FontSize="{DynamicResource FontSize.2xs}" FontWeight="{DynamicResource FontWeight.Emphasis}"
                                   Foreground="{DynamicResource Brush.TextFaint}" />
        <TextBlock x:Name="PART_Sentence" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Sm}"
                   FontWeight="{DynamicResource FontWeight.Emphasis}" Foreground="{DynamicResource Brush.TextPrimary}" />
      </StackPanel>
    </Border>

    <!-- (2) KARAR — padding 12 16 14: sonuç satırı (12px text-dim, satır 1.5) · 12px altında sağa yaslı Cancel (secondary sm) + diğer
         kopya (secondary sm) + Stash and switch (primary sm), aralarında 8. -->
    <Border Padding="16,12,16,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}">
      <StackPanel>
        <TextBlock x:Name="PART_Outcome" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight"
                   LineHeight="{DynamicResource LineHeight.Normal12}" FontSize="{DynamicResource FontSize.Xs}"
                   Foreground="{DynamicResource Brush.TextDim}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="PART_Cancel" Style="{DynamicResource Ds.Button.Secondary.Sm}"
                  Content="{x:Static vm:BranchSwitchText.Cancel}" />
          <Button x:Name="PART_OtherCopy" Style="{DynamicResource Ds.Button.Secondary.Sm}" Margin="8,0,0,0" />
          <Button x:Name="PART_Stash" Style="{DynamicResource Ds.Button.Primary.Sm}" Margin="8,0,0,0"
                  Content="{x:Static vm:BranchSwitchText.Stash}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</views:PopoverBase>
