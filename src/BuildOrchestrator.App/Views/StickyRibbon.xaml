<UserControl x:Class="BuildOrchestrator.App.Views.StickyRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls">
  <!-- [D2/T38+T39+T70] design-v1 sticky şerit (BuildApp.jsx:778-812 birebir): 32px içerik satırı + 2px global
       progress. Faz metni/chip'ler/hata kümesi ve progress dolgusu/genişlik-geçişi/belirsiz-mod KOD-TARAFI
       (StickyRibbon.xaml.cs) — saf-XAML Storyboard motion sözleşmesince İMKANSIZ (MotionTokens.cs). İçerik
       yerleşimi ve 2px ölçüsü/renkleri burada; mantık kontrolde kopyalanmaz (RibbonText saf çekirdek). -->
  <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1"
          Background="{DynamicResource Brush.SurfaceBase}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- İçerik satırı: yükseklik 32, padding '0 12', slotlar arası boşluk 10 (BuildApp.jsx:780). -->
      <Grid x:Name="PART_ContentRow" Grid.Row="0" Height="32" Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />  <!-- [v1.11.0] kalıcı işlem pill'i -->
          <ColumnDefinition Width="Auto" />  <!-- statü glyph'i (yalnız pill YOKKEN) -->
          <ColumnDefinition Width="Auto" />  <!-- faz metni -->
          <ColumnDefinition Width="Auto" />  <!-- building chip'leri -->
          <ColumnDefinition Width="*" />     <!-- esnek boşluk -->
          <ColumnDefinition Width="Auto" />  <!-- hata kümesi (sağa yaslı) -->
        </Grid.ColumnDefinitions>

        <!-- [design v1.11.0 §2.2 · §9-9] KALICI İŞLEM PILL'İ: mono caps, 19px, 1px çerçeve; koşarken amber
             (amber-soft zemin), bitince nötrleşir ama BİR SONRAKİ İŞLEME KADAR KALIR. Spinner / sonuç glyph'i
             pill'in İÇİNDE, metnin hemen sağında (6px). Zemin/çerçeve/metin rengi kod-tarafı sürülür. -->
        <Border x:Name="PART_OpPill" Grid.Column="0" Height="19" Padding="7,0" MaxWidth="280"
                VerticalAlignment="Center" Visibility="Collapsed" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Xs}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PART_OpText" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.2xs}" />
            <controls:StatusGlyph x:Name="PART_OpGlyph" Size="11" Margin="6,0,0,0"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
            <controls:BuildingSpinner x:Name="PART_OpSpinner" Size="11" Margin="6,0,0,0"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <controls:StatusGlyph x:Name="PART_PhaseGlyph" Grid.Column="1" Size="13"
                              VerticalAlignment="Center" Visibility="Collapsed" />

        <!-- Margin kod-tarafında (RefreshText) glyph görünürlüğüne koşullu set edilir — D2 review fix Finding 5:
             glyph varken 10 (glyph→metin gap), glyph collapsed olunca 0 (metin ilk flex item, leading gap yok). -->
        <!-- [E5/T47] Faz metni bir LIVE REGION'dur: ekran okuyucu faz değişimini (empty→boot→…→done|stopped)
             duyurur. Duyuru YALNIZ faz/hata değişiminde tetiklenir (elapsed tick'te DEĞİL — spam olmasın);
             bkz. StickyRibbon.AnnouncePhase. -->
        <TextBlock x:Name="PART_PhaseText" Grid.Column="2" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Assertive"
                   FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.Xs}"
                   Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" />

        <StackPanel x:Name="PART_BuildingChips" Grid.Column="3" Margin="10,0,0,0" Orientation="Horizontal"
                    VerticalAlignment="Center" />

        <!-- [E2/T37] Engine-died kalıcı hata modu aksiyonu: banner/toast YOK — şerit-içi "Restart engine".
             Görünürlüğü EngineDiedMessage'a bağlı (RefreshText); ölmüş engine'i RestartEngineCommand yeniden başlatır. -->
        <Button x:Name="PART_RestartEngine" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="12,0,0,0" Visibility="Collapsed" Content="Restart engine"
                Style="{DynamicResource Ds.Button.Secondary.Sm}"
                Command="{Binding RestartEngineCommand}" />

        <!-- [design v1.11.0 §2.2] Döngü kümesi KALDIRILDI: turuncu UI'dan çıktı ve döngü bilgisi satırdaki tek
             amber üçgende + alt bardaki ⚠ filtresinde yaşıyor. -->

        <StackPanel x:Name="PART_FailureCluster" Grid.Column="5" Orientation="Horizontal"
                    VerticalAlignment="Center" />
      </Grid>

      <!-- Global progress: yükseklik Size.ProgressHeight (2), Radius.None, track Brush.Surface (brief). Dolgu
           per-instance brush (A13.2); genişlik geçişi ve belirsiz-mod kod-tarafı. -->
      <Border x:Name="PART_ProgressTrack" Grid.Row="1"
              Height="{DynamicResource Size.ProgressHeight}"
              CornerRadius="{DynamicResource Radius.None}"
              Background="{DynamicResource Brush.Surface}"
              ClipToBounds="True" SnapsToDevicePixels="True">
        <Border x:Name="PART_ProgressIndicator" HorizontalAlignment="Left" Width="0">
          <Border.RenderTransform>
            <TranslateTransform x:Name="PART_IndicatorTranslate" />
          </Border.RenderTransform>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>
