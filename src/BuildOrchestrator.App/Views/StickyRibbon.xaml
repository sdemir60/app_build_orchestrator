<UserControl x:Class="BuildOrchestrator.App.Views.StickyRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls">
  <!-- [D2/T38+T39+T70] design-v1 sticky şerit (BuildApp.jsx:778-812 birebir): 32px içerik satırı + 2px global
       progress. Faz metni/chip'ler/hata kümesi ve progress dolgusu/genişlik-geçişi/belirsiz-mod KOD-TARAFI
       (StickyRibbon.xaml.cs) — saf-XAML Storyboard motion sözleşmesince İMKANSIZ (MotionTokens.cs). İçerik
       yerleşimi ve 2px ölçüsü/renkleri burada; mantık kontrolde kopyalanmaz (RibbonText saf çekirdek). -->
  <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1"
          Background="{DynamicResource Brush.SurfaceBase}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- İçerik satırı: yükseklik 32, padding '0 12', slotlar arası boşluk 10 (BuildApp.jsx:780). -->
      <Grid x:Name="PART_ContentRow" Grid.Row="0" Height="32" Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />  <!-- statü glyph'i (yalnız done) -->
          <ColumnDefinition Width="Auto" />  <!-- faz metni -->
          <ColumnDefinition Width="Auto" />  <!-- building chip'leri -->
          <ColumnDefinition Width="*" />     <!-- esnek boşluk -->
          <ColumnDefinition Width="Auto" />  <!-- hata kümesi (sağa yaslı) -->
        </Grid.ColumnDefinitions>

        <controls:StatusGlyph x:Name="PART_PhaseGlyph" Grid.Column="0" Size="13"
                              VerticalAlignment="Center" Visibility="Collapsed" />

        <TextBlock x:Name="PART_PhaseText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                   FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.Xs}"
                   Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" />

        <StackPanel x:Name="PART_BuildingChips" Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal"
                    VerticalAlignment="Center" />

        <StackPanel x:Name="PART_FailureCluster" Grid.Column="4" Orientation="Horizontal"
                    VerticalAlignment="Center" />
      </Grid>

      <!-- Global progress: yükseklik Size.ProgressHeight (2), Radius.None, track Brush.Surface (brief). Dolgu
           per-instance brush (A13.2); genişlik geçişi ve belirsiz-mod kod-tarafı. -->
      <Border x:Name="PART_ProgressTrack" Grid.Row="1"
              Height="{DynamicResource Size.ProgressHeight}"
              CornerRadius="{DynamicResource Radius.None}"
              Background="{DynamicResource Brush.Surface}"
              ClipToBounds="True" SnapsToDevicePixels="True">
        <Border x:Name="PART_ProgressIndicator" HorizontalAlignment="Left" Width="0">
          <Border.RenderTransform>
            <TranslateTransform x:Name="PART_IndicatorTranslate" />
          </Border.RenderTransform>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>
