<UserControl x:Class="BuildOrchestrator.App.Views.EventStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls">
  <!-- [D3/T?] design-v1 Event stream paneli (BuildApp.jsx:639-737). DataContext bir RunViewModel'dir
       (ShellRoot'tan miras). Panel = PanelHead ("{n} events" sayacı) + kaydırılan tampon (render dilimi 150,
       satırlar KOD-tarafı EventStreamRow — parıltı/seçim/daktilo motion sözleşmesince kod-tarafı) + altta canlı
       aktif satır + alta-yapışma pill'i (BottomAnchorBehavior/LatestPill — T59, yeniden yazılmaz, tüketilir). -->
  <DockPanel>
    <!-- "{n} events" sayacı (TAM tampon ≤260, render dilimi DEĞİL) RightContent'e KOD-tarafı konur — başka bir
         kontrolün content namescope'una x:Name'li öğe yerleştirilemez (MC3093). -->
    <controls:PanelHeader x:Name="PART_Header" DockPanel.Dock="Top" Text="EVENT STREAM" />

    <Grid Background="{DynamicResource Brush.SurfaceBase}">
      <ScrollViewer x:Name="PART_Scroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="0,4">
        <StackPanel>
          <!-- Boş-durum: hiç tampon satırı ve canlı aktif satır yokken "No events yet." (BuildApp.jsx:705-707).
               Görünürlük kod-tarafı yönetilir (RefreshEmptyState). Idle-cursor prompt (proto 726-735) BU DALGADA YOK. -->
          <TextBlock x:Name="PART_Empty" Text="No events yet." Margin="10,6" Visibility="Collapsed"
                     FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.Xs}"
                     Foreground="{DynamicResource Brush.TextFaint}" />

          <!-- Tampon satırları (EventStreamRow'lar kod-tarafı eklenir/silinir — StreamEvents ile birebir). -->
          <StackPanel x:Name="PART_Rows" />

          <!-- Aktif satır: saat + imleç (12px kolon) + daktilo "{name} building…". BuildApp.jsx:713-725. -->
          <Grid x:Name="PART_ActiveLine" MinHeight="24" Margin="10,0" Background="Transparent"
                Cursor="Hand" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="PART_ActiveTime" VerticalAlignment="Center" Margin="0,0,8,0"
                         FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.Xs}"
                         Foreground="{DynamicResource Brush.TextFaint}" />
              <Border Width="12" Margin="0,0,8,0" VerticalAlignment="Center">
                <Rectangle x:Name="PART_ActiveCursor" Width="7" Height="13" HorizontalAlignment="Center"
                           Fill="{DynamicResource Brush.AmberText}" />
              </Border>
              <TextBlock x:Name="PART_ActiveText" VerticalAlignment="Center" TextWrapping="NoWrap"
                         FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.Xs}"
                         Typography.NumeralAlignment="Tabular"
                         Foreground="{DynamicResource Brush.AmberText}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- `⌄ latest` pill — panel alt-ortası, görünürlük BottomAnchorBehavior.ShowPill'e bağlı (T59). -->
      <controls:LatestPill x:Name="PART_Pill" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</UserControl>
