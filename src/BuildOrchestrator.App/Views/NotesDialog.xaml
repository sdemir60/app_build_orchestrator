<controls:ModalDialog x:Class="BuildOrchestrator.App.Views.NotesDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
                      xmlns:services="clr-namespace:BuildOrchestrator.App.Services"
                      DialogWidth="720" DialogHeight="600">
  <!-- [design v1.13.0/v1.19.0 §2.11 · D4/T9] What's new — kendi diyalogu (title bar'daki kendi butonu ve
       Ctrl+F1). Kabuk üç dialogun ORTAK kabuğudur (Controls/ModalDialog + Ds.ModalDialog şablonu); burada
       yalnız içerik ve ölçü durur. [v1.19.0] 720×600 SABİT: gövde başlık ile footer arasındaki alanı doldurur
       ve kendi içinde kayar, Earlier versions açılınca dialog uzamaz.

       Liste kurma kodu NotesDialog.xaml.cs'tedir. Sürüm numarası AppIdentity.Version'dan, notlar
       ReleaseNotes'tan gelir; burada hiçbir metin YENİDEN YAZILMAZ. -->

  <!-- ============================ BAŞLIK SATIRI ============================ -->
  <!-- [v1.19.0 §2.11] Padding 20/18/16 (üst/yan/alt), altta border-subtle. Solda başlık + 3px altında açıklama;
       sağda mono sürüm çipi. Eski iki satırlı INSTALLED VERSION bloğu ve onun scrollbar'a hizalanan 28px sağ
       padding'i KALKTI — sağ kenar sabit 18px.

       [KORUNAN SAPMA] §2.11 başlık için 15px der; FontSize.Md (14) çizilir. DS ölçeğinde 15px adımı YOKTUR
       (§1.2: 11 · 12 · 13 · 14 · 16 · 20) ve tasarımın kendi prototipi de `text-md` token'ını kullanır. -->
  <controls:ModalDialog.Head>
    <Border Padding="18,20,18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.BorderSubtle}">
      <DockPanel>
        <Border DockPanel.Dock="Right" Height="20" Padding="7,0" Margin="12,0,0,0" VerticalAlignment="Center"
                BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}"
                CornerRadius="{DynamicResource Radius.Xs}" Background="{DynamicResource Brush.Surface}">
          <TextBlock Text="{x:Static services:AppIdentity.Version}" VerticalAlignment="Center"
                     FontFamily="{x:Static controls:AppFonts.Mono}"
                     FontSize="{DynamicResource FontSize.Xs}"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="What's new"
                     FontSize="{DynamicResource FontSize.Md}"
                     FontWeight="{DynamicResource FontWeight.Heading}"
                     Foreground="{DynamicResource Brush.TextPrimary}" />
          <TextBlock Text="Release notes for Build Orchestrator." Margin="0,3,0,0"
                     FontSize="{DynamicResource FontSize.Xs}"
                     Foreground="{DynamicResource Brush.TextDim}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </controls:ModalDialog.Head>

  <!-- ============================ FOOTER ============================ -->
  <!-- [§2.11] Yalnız sağda secondary Close — Copy diagnostics About'ta kalır, buraya gelmez. Şeridin padding'i
       ve üst çizgisi kabuğundur. -->
  <controls:ModalDialog.Footer>
    <DockPanel>
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Close" Click="OnClose"
              Style="{DynamicResource Ds.Button.Secondary.Md}" />
    </DockPanel>
  </controls:ModalDialog.Footer>

  <!-- ============================ GÖVDE ============================ -->
  <!-- [v1.19.0 §2.11] Kalan alanı doldurur, kendi içinde kayar. Prototipteki scroll kutusunun `22px 18px 24px`
       padding'i burada kayan içeriğin kenar boşluğudur: ScrollViewer.Padding kaymayan bir iç çerçeve olurdu
       (içerik viewport'un 22px altında kesilirdi). Sticky sol kolonun ofseti ScrollChanged'de yazılır
       (NotesDialog.xaml.cs, StickyColumn). -->
  <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" ScrollChanged="OnBodyScrollChanged">
    <StackPanel x:Name="BodyList" Margin="18,22,18,24">
      <StackPanel x:Name="WhatsNewRows" />
      <!-- [v1.19.0 §2.11] Katlı kısım: sürüm bloklarıyla AYNI 84/26 grid'in SAĞ kolonunda; üstte 22px + 1px
           border-subtle + 14px. Blok yalnız katlanacak sürüm varken görünür (kod-tarafı, BuildWhatsNew).
           Butonun sol margin'i -10, Ds.Button.Ghost.Sm'nin kendi 10px yatay padding'ini iptal eder — etiket
           madde kolonuyla hizalanır. -->
      <Border x:Name="EarlierVersionsBlock" Visibility="Collapsed" Margin="0,22,0,0" Padding="0,14,0,0"
              BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.BorderSubtle}">
        <!-- Kolonlar (84 · 26 · kalan) kod-tarafında sürüm bloklarıyla AYNI yardımcıdan kurulur
             (NotesDialog.AddBlockColumns — tek tanım yeri). -->
        <Grid x:Name="EarlierVersionsGrid">
          <Button x:Name="EarlierVersionsButton" Grid.Column="2" HorizontalAlignment="Left" Margin="-10,0,0,0"
                  Click="OnShowEarlierVersions"
                  AutomationProperties.Name="Show earlier versions"
                  Style="{DynamicResource Ds.Button.Ghost.Sm}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="{DynamicResource Icon.Down}"
                        StrokeThickness="{DynamicResource Icon.Down.StrokeThickness}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
              <TextBlock x:Name="EarlierVersionsLabel" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</controls:ModalDialog>
