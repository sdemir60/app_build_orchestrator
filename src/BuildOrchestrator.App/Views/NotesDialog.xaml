<UserControl x:Class="BuildOrchestrator.App.Views.NotesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:services="clr-namespace:BuildOrchestrator.App.Services"
             xmlns:views="clr-namespace:BuildOrchestrator.App.Views"
             Visibility="Collapsed" Focusable="True">
  <!-- [design v1.13.0/v1.13.1 §2.11 · D4/T9] What's new — kendi diyalogu. About'un dördüncü sekmesiydi
       (design v1.9.0); v1.13.0 onu ÇIKARDI: kendi title bar butonu (sparkle, dişli ile ⓘ arasında) ve kendi
       kısayolu (Ctrl+F1, toggle) var. Kabuk About/Settings ile BİREBİR aynıdır (full-bleed Brush.Scrim +
       620px Ds.Dialog + odak tuzağı + Esc/scrim ile kapanma) — ama About'un kimlik/logo bloğu ve Segment'i
       YOK: dialogun tek işi var.

       Liste kurma kodu (BuildWhatsNew/BuildVersionBlock/BuildCategory) About'tan TAŞINMIŞTIR, kopyalanmamıştır
       (kopya YASAK, CLAUDE.md) — bkz. NotesDialog.xaml.cs. Liste KURALLARI v1.9.0'dan DEĞİŞMEDİ; yalnız iki
       şey değişti (v1.13.1): CURRENT metni nötr INSTALLED çipine döndü, Earlier versions butonu içerik koluna
       hizalandı. Sürüm numarası AppIdentity.Version'dan, notlar ReleaseNotes'tan gelir; burada hiçbir metin
       YENİDEN YAZILMAZ. -->
  <Grid x:Name="Scrim" Background="{DynamicResource Brush.Scrim}" MouseLeftButtonDown="OnScrimClick"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.ControlTabNavigation="Cycle"
        FocusManager.IsFocusScope="True">
    <Border x:Name="DialogShell" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center"
            Style="{DynamicResource Ds.Dialog}" MouseLeftButtonDown="OnDialogClick">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ BAŞLIK SATIRI ============================ -->
        <!-- [§2.11] Padding 16/28/12/18 (üst/sağ/alt/sol) — sağ BİLEREK 28px (18+10): gövdenin 10px'lik
             scrollbar'ı (Controls.xaml'in implicit ScrollBar stili, tüm uygulamada aynı genişlik) içeriği
             içe alır; sürüm bloğu böylece aşağıdaki listenin tarih sütunuyla tam sağa hizalanır. CSS
             `align-items: flex-end` + `margin-bottom: 3px` burada satırın kendisinde VerticalAlignment=Bottom
             (iki kolon da) + sürüm bloğunun alt marjı 3 ile karşılanır: mono sürüm satırının taban çizgisi
             soldaki açıklama satırının taban çizgisiyle hizalanır.

             [KORUNAN SAPMA] §2.11 hem `What's new` başlığı hem sürüm numarası için 15px ister; ikisi de
             FontSize.Md (14) çizilir. DS ölçeğinde 15px adımı YOKTUR (§1.2: 11 · 12 · 13 · 14 · 16 · 20) ve
             tasarımın KENDİ prototipi de her iki yerde `text-md` (14px) token'ını kullanır — sapma
             prototiple uyum yönündedir. Caps etiketin 10px'i de ölçek dışı ama tasarım kaynağında da ham bir
             sayıdır; tek tanım yeri NotesDialog.CapsLabelPx'tir (INSTALLED çipiyle PAYLAŞILIR,
             kopya YASAK). -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
          <DockPanel Margin="18,16,28,12">
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="12,0,0,3">
              <controls:TrackedTextBlock Text="INSTALLED VERSION" HorizontalAlignment="Right"
                                         FontSize="{x:Static views:NotesDialog.CapsLabelPx}"
                                         Foreground="{DynamicResource Brush.TextFaint}" />
              <TextBlock Text="{x:Static services:AppIdentity.Version}" Margin="0,2,0,0"
                         HorizontalAlignment="Right"
                         FontFamily="{x:Static controls:AppFonts.Mono}"
                         FontSize="{DynamicResource FontSize.Md}"
                         FontWeight="{DynamicResource FontWeight.Emphasis}"
                         Foreground="{DynamicResource Brush.TextPrimary}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="What's new"
                         FontSize="{DynamicResource FontSize.Md}"
                         FontWeight="{DynamicResource FontWeight.Heading}"
                         Foreground="{DynamicResource Brush.TextPrimary}" />
              <TextBlock Text="Release notes for Build Orchestrator." Margin="0,2,0,0"
                         FontSize="{DynamicResource FontSize.Xs}"
                         Foreground="{DynamicResource Brush.TextDim}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ============================ GÖVDE ============================ -->
        <!-- [§2.11] Yükseklik SABİT 400px (MIN değil) — Earlier versions açıldığında dialog uzayıp ekranın
             altına/üstüne yapışmasın, liste kendi içinde kaysın. Sürüm listesi zamanla uzayacağı için bu
             sabit kutu kalıcı çözümdür (About'un eski What's new sekmesinden devralınan gerekçe — bkz.
             NotesDialogTests.The_body_height_is_fixed_at_400px, Height==400.0 arayışı MinHeight'tan böyle
             ayrışır). -->
        <Grid Grid.Row="1" Height="400" Margin="18,14,18,18">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel x:Name="WhatsNewRows" />
              <!-- [v1.13.1] Sol margin -10, Ds.Button.Ghost.Sm'nin kendi 10px yatay padding'ini iptal eder —
                   etiket madde metinleriyle tam sola hizalanır (üst margin 10 korunur). -->
              <Button x:Name="EarlierVersionsButton" HorizontalAlignment="Left" Margin="-10,10,0,0"
                      Visibility="Collapsed" Click="OnShowEarlierVersions"
                      AutomationProperties.Name="Show earlier versions"
                      Style="{DynamicResource Ds.Button.Ghost.Sm}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ============================ FOOTER ============================ -->
        <!-- [§2.11] Yalnız sağda secondary Close — Copy diagnostics About'ta kalır, buraya gelmez. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
          <DockPanel Margin="16,12">
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Close" Click="OnClose"
                    Style="{DynamicResource Ds.Button.Secondary.Md}" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
