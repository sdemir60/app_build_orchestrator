<UserControl x:Class="BuildOrchestrator.App.Views.MaintenanceBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    [design v1.7.0 §2.7-2] Bakım grubu (BuildApp.jsx:1929-1959): Clean · Optimize · Resolve cycles.
    Chip ağırlığında TEK kutu — yükseklik 24, surface-raised zemin, 1px border, radius-xs, overflow hidden.
    Düğmelerin kendi kenarı/köşesi YOKTUR: çerçeveyi kutu taşır, düğmeler onun içinde kesilir.

    İçerik (ikon, tooltip, enable, komut) KOD-TARAFI kurulur — ActionBar/StickyRibbon deseni. Ölçüler
    prototipte literaldir (token değil), bu yüzden kod-tarafında `const` olarak kaynak satırıyla durur.
  -->
  <Border x:Name="PART_Root" Height="24" ClipToBounds="True" VerticalAlignment="Center"
          Background="{DynamicResource Brush.SurfaceRaised}"
          BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
          CornerRadius="{DynamicResource Radius.Xs}">
    <!-- [design v1.17.0 §9 fix round 1 · I-2] Her düğme kendi HER ZAMAN etkin Border'ına sarılır: koşarken
         disabled olan düğmenin ÜSTÜNDE fare gezerken WPF mouse-over'ı düğmenin KENDİSİNE değil en yakın ETKİN
         ATAYA yönlendirir — o ata bu Border'dır (düğmenin ebeveyni). DsChrome.WireHoverProxy (MaintenanceBox.
         Build) Border'ın MouseEnter/Leave'ini düğmenin IsHoverProxy'sine yansıtır. Sarmalayıcı AYRI olmak
         ZORUNDADIR (kutunun tamamını saran tek bir Border DEĞİL) — aksi halde bir düğmenin üstündeki hover,
         komşusunun aktif-hover'ını da yanlışlıkla tetiklerdi. -->
    <StackPanel x:Name="PART_Strip" Orientation="Horizontal">
      <Border Background="Transparent"><Button x:Name="PART_Clean" /></Border>
      <Border x:Name="PART_Sep1" Width="1" Height="14" Background="{DynamicResource Brush.Border}" />
      <Border Background="Transparent"><Button x:Name="PART_Optimize" /></Border>
      <Border x:Name="PART_Sep2" Width="1" Height="14" Background="{DynamicResource Brush.Border}" />
      <Border Background="Transparent"><Button x:Name="PART_Resolve" /></Border>
    </StackPanel>
  </Border>
</UserControl>
