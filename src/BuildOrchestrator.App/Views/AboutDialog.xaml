<controls:ModalDialog x:Class="BuildOrchestrator.App.Views.AboutDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
                      xmlns:services="clr-namespace:BuildOrchestrator.App.Services"
                      xmlns:app="clr-namespace:BuildOrchestrator.App"
                      DialogWidth="620">
  <!-- [design v1.19.0 §2.10] About. Kabuk üç dialogun ORTAK kabuğudur (Controls/ModalDialog + Ds.ModalDialog
       şablonu: scrim, çerçeve, köşe clip'i, odak tuzağı, Esc/scrim ile kapanma, giriş) — burada yalnız içerik ve
       ölçü durur. Genişlik 620px; yükseklik içerikten doğar (sabit 284px gövde), üst sınırı kabuğun host − 48
       kelepçesidir.

       Sekmeli gövde: üç içerik sınıfı (kimlik / ortam / kısayol) birbirine bakmaz. Sekme anahtarı Ds.Segment'in
       md boyudur (Ds.Segment.Md) — action bar'ın Debug/Release seçicisiyle AYNI bileşen.

       Gösterilen HİÇBİR metin burada üretilmez: kimlik AppIdentity'den, sürüm/motor/telif satırları ile ortam
       satırları DiagnosticsReport'tan (tek model), kısayollar ShortcutCatalog'dan gelir (kopya YASAK). -->

  <controls:ModalDialog.Resources>
    <!-- Caps grup başlığı (Environment ve Shortcuts sekmeleri): 11px/500 text-dim, altında 7px. Değerler
         TrackedTextBlock'a YEREL yazılır — kurucusu Foreground'u yerel kaynak referansıyla kurduğu için bir
         Style setter'ı onu ezemezdi. -->
    <DataTemplate x:Key="GroupTitle">
      <controls:TrackedTextBlock Text="{Binding}" Margin="0,0,0,7" HorizontalAlignment="Left"
                                 FontSize="{DynamicResource FontSize.2xs}"
                                 FontWeight="{DynamicResource FontWeight.Emphasis}"
                                 Foreground="{DynamicResource Brush.TextDim}" />
    </DataTemplate>

    <!-- Üç sekmenin satırı en az 27px — ölçünün TEK yeri (Diagnostics ve Shortcuts satırları bu stili kullanır). -->
    <Style x:Key="AboutRow" TargetType="DockPanel">
      <Setter Property="MinHeight" Value="27" />
    </Style>

    <!-- Tanı satırı — About sekmesinin kimlik satırları ve Environment'ın iki grubu AYNI şablonu kullanır: etiket
         124px 12px text-dim, 18px aralık, değer mono 12px. Kısa değer taşmaz; tekerlek o durumda ebeveyne devredilir.
         Değer hücresi kırpılmaz, yatay kayar.
         [DEĞİŞEN KURAL — design v1.13.1 §2.10] ESKİ: TextTrimming="CharacterEllipsis" ile kırpılır, tam metin
         ToolTip'te dururdu. "Ellipsis + title ipucu" olarak denendi, İSTENMEDİ — tam metni okumanın zaten bir yolu
         var (footer'daki Copy diagnostics). YENİ: satır KIRILMAZ, yatay kayar; çubuk GÖRÜNMEZ (Hidden) ve dikey
         ASLA kaymaz (Disabled — tek satır içerik). Tekerlek yönlendirmesi OnEnvironmentValueWheel'dedir
         (AboutDialog.xaml.cs): hücre GERÇEKTEN taşıyorsa yatay kaydırır, taşmıyorsa olayı ebeveyne DEVREDER. -->
    <DataTemplate x:Key="DiagnosticsRow">
      <DockPanel Style="{StaticResource AboutRow}">
        <TextBlock DockPanel.Dock="Left" Width="124" Text="{Binding Label}" VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSize.Xs}"
                   Foreground="{DynamicResource Brush.TextDim}" />
        <ScrollViewer Margin="18,0,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Focusable="False" VerticalAlignment="Center" PreviewMouseWheel="OnEnvironmentValueWheel">
          <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                     FontFamily="{x:Static controls:AppFonts.Mono}"
                     FontSize="{DynamicResource FontSize.Xs}"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>
  </controls:ModalDialog.Resources>

  <!-- ============================ KİMLİK BLOĞU ============================ -->
  <!-- [design v1.19.0 §2.10] Başlık SATIRI YOK — yerine kimlik bloğu (padding 20/18/20). Solda ürün markası 28px
       (1px aşağı) · 13px · ürün adı (16px/600) + 9px + mono SÜRÜM ÇİPİ · 4px altında tagline. Sağda firma kilidi:
       1×28 ayraç · 13px · caps LICENSED TO + 6px altında firma logosu (13px, %80). Eski `{sürüm} · {telif}` mono
       satırı KALKTI: sürüm çipte, telif About sekmesinin Copyright satırındadır. -->
  <controls:ModalDialog.Head>
    <Border Padding="18,20,18,20">
      <DockPanel>
        <!-- Firma kilidi. Firma logosu opsiyoneldir — yoksa bu blok tamamen düşer. -->
        <StackPanel x:Name="CompanyLock" DockPanel.Dock="Right" Orientation="Horizontal"
                    VerticalAlignment="Top" Margin="13,1,0,0">
          <Rectangle Width="1" Height="28" Margin="0,0,13,0" VerticalAlignment="Center"
                     Fill="{DynamicResource Brush.BorderSubtle}" SnapsToDevicePixels="True" />
          <StackPanel VerticalAlignment="Center">
            <controls:TrackedTextBlock Text="LICENSED TO" HorizontalAlignment="Right"
                                       FontFamily="{x:Static controls:AppFonts.Ui}"
                                       FontSize="{DynamicResource FontSize.2xs}"
                                       Foreground="{DynamicResource Brush.TextFaint}" />
            <controls:BrandLogo Height="13" Opacity="0.8" Margin="0,6,0,0" HorizontalAlignment="Right" />
          </StackPanel>
        </StackPanel>

        <controls:AppMark DockPanel.Dock="Left" Height="28" VerticalAlignment="Top" Margin="0,1,13,0" />

        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static services:AppIdentity.Product}" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSize.Lg}"
                       FontWeight="{DynamicResource FontWeight.Heading}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />
            <!-- Sürüm çipi: 19px, yatay padding 6, 1px border-strong, radius-xs, surface zemin, mono 11px. -->
            <Border x:Name="VersionChip" Height="19" Padding="6,0" Margin="9,0,0,0" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}"
                    CornerRadius="{DynamicResource Radius.Xs}" Background="{DynamicResource Brush.Surface}">
              <TextBlock Text="{x:Static services:AppIdentity.Version}" VerticalAlignment="Center"
                         FontFamily="{x:Static controls:AppFonts.Mono}"
                         FontSize="{DynamicResource FontSize.2xs}"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{x:Static services:AppIdentity.Tagline}" Margin="0,4,0,0" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSize.Xs}"
                     Foreground="{DynamicResource Brush.TextDim}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </controls:ModalDialog.Head>

  <!-- ============================ SEKMELER ============================ -->
  <!-- [design v1.19.0 §2.10] Kendi bandında: padding 6/18/14, altta TAM GENİŞLİK 1px border-subtle. Sıra mantıksal:
       About → Environment → Shortcuts; her açılış About'ta başlar (kod-tarafı, Open). Renkler DS varsayılanı. -->
  <controls:ModalDialog.Tabs>
    <Border x:Name="TabBand" Padding="18,6,18,14" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource Brush.BorderSubtle}">
      <ItemsControl Style="{DynamicResource Ds.Segment.Md}">
        <RadioButton x:Name="AboutTab" GroupName="about" IsChecked="True"
                     Style="{DynamicResource Ds.Segment.Item}" Content="About" />
        <RadioButton x:Name="EnvironmentTab" GroupName="about" Checked="OnEnvironmentTabChecked"
                     Style="{DynamicResource Ds.Segment.Item}" Content="Environment" />
        <RadioButton x:Name="ShortcutsTab" GroupName="about"
                     Style="{DynamicResource Ds.Segment.Item}" Content="Shortcuts" />
      </ItemsControl>
    </Border>
  </controls:ModalDialog.Tabs>

  <!-- ============================ FOOTER ============================ -->
  <!-- Şeridin padding'i (12px 18px) ve üst çizgisi kabuğundur. -->
  <controls:ModalDialog.Footer>
    <DockPanel>
      <!-- Copy diagnostics: ikon + etiket. Başarılı kopyada ikon ✓'ye, renk başarı tonuna döner — ikisini de
           kod-tarafı sürer. Sol margin −10: ghost sm'nin 10px iç boşluğunu iptal eder, etiket 18px gutter'a oturur.
           Etiket Content'in İÇİNDEKİ bir TextBlock'tur; WPF'in buton peer'ı adı yalnız string Content'ten türetir →
           ad AÇIKÇA verilir. -->
      <Button x:Name="CopyButton" DockPanel.Dock="Left" Margin="-10,0,0,0" Click="OnCopyDiagnostics"
              AutomationProperties.Name="{x:Static app:AccessibilityNames.CopyDiagnostics}"
              Style="{DynamicResource Ds.Button.Ghost.Sm}">
        <StackPanel Orientation="Horizontal">
          <Viewbox Width="13" Height="13" Margin="0,0,6,0">
            <Canvas Width="24" Height="24">
              <Path x:Name="CopyGlyph" />
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="CopyLabelText" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <!-- Close bir MUTASYON değildir → Secondary (Primary bir commit ima ederdi). -->
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Close" Click="OnClose"
              Style="{DynamicResource Ds.Button.Secondary.Md}" />
    </DockPanel>
  </controls:ModalDialog.Footer>

  <!-- ============================ GÖVDE ============================ -->
  <!-- [design v1.19.0 §2.10] SABİT 284px: sekme değişince dialogun boyu ve footer'ın yeri OYNAMAZ; uzun içerik
       kendi panelinde kayar. Prototipteki `14px 18px 20px` padding kayan içeriğin kenar boşluğudur
       (ScrollViewer.Padding kaymayan bir iç çerçeve olurdu — NotesDialog ile AYNI karar). Görünürlük Style'dan
       gelir: yerel bir Visibility ataması Style setter'ını EZER, bu yüzden panellerde yerel değer YOKTUR. -->
  <Grid x:Name="Body" Height="284">

    <!-- ABOUT: tanım paragrafı · hairline · Version/Engine/Copyright · What's new butonu -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=AboutTab}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <StackPanel Margin="18,14,18,20">
        <!-- 13px text-secondary, satır yüksekliği 1.62 (LineHeight.Reading13 — What's new maddeleriyle ORTAK),
             en çok 470px. -->
        <TextBlock x:Name="OverviewText" Text="{x:Static services:AppIdentity.Overview}"
                   MaxWidth="470" HorizontalAlignment="Left" TextWrapping="Wrap"
                   LineStackingStrategy="BlockLineHeight" LineHeight="{DynamicResource LineHeight.Reading13}"
                   FontSize="{DynamicResource FontSize.Sm}"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <Border Height="1" Margin="0,18,0,14" Background="{DynamicResource Brush.BorderSubtle}" />
        <ItemsControl x:Name="IdentityRows" ItemTemplate="{StaticResource DiagnosticsRow}" />
        <!-- What's new in {sürüm}: ghost sm, sol margin −10 (etiket satır etiketleriyle hizalı). About KAPANIR ve
             istek bildirilir; What's new'i MainWindow açar (OnNotesRequested — okunmadı noktası orada söner).
             Etiket ve UIA adı kod-tarafı (ReleaseNotes.WhatsNewInLabel — cümlenin tek yeri). -->
        <Button x:Name="WhatsNewButton" HorizontalAlignment="Left" Margin="-10,14,0,0" Click="OnWhatsNew"
                Style="{DynamicResource Ds.Button.Ghost.Sm}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource Icon.WhatsNew}"
                      StrokeThickness="{DynamicResource Icon.WhatsNew.StrokeThickness}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock x:Name="WhatsNewLabel" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <!-- ENVIRONMENT: RUNTIME · PATHS -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=EnvironmentTab}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <StackPanel Margin="18,14,18,20">
        <StackPanel Margin="0,0,0,16">
          <ContentPresenter Content="{x:Static services:DiagnosticsReport.RuntimeTitle}"
                            ContentTemplate="{StaticResource GroupTitle}" />
          <ItemsControl x:Name="RuntimeRows" ItemTemplate="{StaticResource DiagnosticsRow}" />
        </StackPanel>
        <StackPanel Margin="0,0,0,16">
          <ContentPresenter Content="{x:Static services:DiagnosticsReport.PathsTitle}"
                            ContentTemplate="{StaticResource GroupTitle}" />
          <ItemsControl x:Name="PathsRows" ItemTemplate="{StaticResource DiagnosticsRow}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- SHORTCUTS: BUILD · APPLICATION (grup bilgisi ShortcutCatalog'da) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=ShortcutsTab}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <ItemsControl x:Name="ShortcutGroups" Margin="18,14,18,20">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,16">
              <ContentPresenter Content="{Binding Title}" ContentTemplate="{StaticResource GroupTitle}" />
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- Satır en az 27px: solda açıklama 13px text-secondary, sağda Ds.Kbd'ler (4px arayla). -->
                    <DockPanel Style="{StaticResource AboutRow}">
                      <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Gestures}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <ContentControl Content="{Binding}" Margin="4,0,0,0" Style="{DynamicResource Ds.Kbd}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- Global kısayol kaydı çakışmada SESSİZCE düşer (HotkeyRegistration); kullanıcının bunu
                           anlamasının tek yolu bu nottur. -->
                      <TextBlock DockPanel.Dock="Right" Text="unavailable" VerticalAlignment="Center"
                                 Margin="8,0,0,0"
                                 FontSize="{DynamicResource FontSize.2xs}"
                                 Foreground="{DynamicResource Brush.TextFaint}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Unavailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap"
                                 FontSize="{DynamicResource FontSize.Sm}"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</controls:ModalDialog>
