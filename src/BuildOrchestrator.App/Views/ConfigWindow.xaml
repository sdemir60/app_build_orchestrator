<Window x:Class="BuildOrchestrator.App.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="560"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,10,0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Root directory" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                         Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Browse…" Width="80" Height="30" Margin="6,0,0,0"
                        Command="{Binding BrowseRootCommand}" />
            </Grid>

            <TextBlock Text="Build configuration" />
            <ComboBox ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" />

            <TextBlock Text="Performance mode" />
            <ComboBox ItemsSource="{Binding Performances}" SelectedItem="{Binding Performance}" />

            <TextBlock Text="Branch working mode" />
            <ComboBox ItemsSource="{Binding BranchModes}" SelectedItem="{Binding BranchMode}" />

            <TextBlock Text="Log level" />
            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" />

            <TextBlock Text="Dependent (downstream) mode" />
            <ComboBox ItemsSource="{Binding DependentModes}" SelectedItem="{Binding DependentMode}" />

            <TextBlock Text="Cache location (optional)" />
            <TextBox Height="30" VerticalContentAlignment="Center"
                     Text="{Binding CacheLocation, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="Reduced motion" Margin="0,14,0,0" Foreground="{StaticResource TextPrimary}"
                      IsChecked="{Binding ReducedMotion}" />
            <CheckBox Content="Start with Windows (autostart)" Margin="0,8,0,0" Foreground="{StaticResource TextPrimary}"
                      IsChecked="{Binding AutoStart}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="Save" Width="90" Height="32" Command="{Binding SaveCommand}"
                    Style="{StaticResource ActionButton}" />
        </StackPanel>
    </Grid>
</Window>
