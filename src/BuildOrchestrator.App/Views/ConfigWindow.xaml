<Window x:Class="BuildOrchestrator.App.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings" Foreground="{StaticResource TextBrush}" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,16" />

            <TextBlock Text="Workspace root" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Browse..."
                        Margin="8,0,0,0" Click="Browse_OnClick" />
                <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="6,4" />
            </DockPanel>

            <UniformGrid Columns="2" Margin="0,0,0,8">
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="Build configuration" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding BuildConfigurations}" SelectedItem="{Binding BuildConfiguration}" />
                </StackPanel>
                <StackPanel Margin="8,0,0,8">
                    <TextBlock Text="Performance" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding PerformanceModes}" SelectedItem="{Binding Performance}" />
                </StackPanel>
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="Branch work mode" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding BranchWorkModes}" SelectedItem="{Binding BranchWorkMode}" />
                </StackPanel>
                <StackPanel Margin="8,0,0,8">
                    <TextBlock Text="Dependent mode" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding DependentModes}" SelectedItem="{Binding DependentMode}" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Cache location" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,4" />
            <TextBox Text="{Binding CacheLocation, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,0,14" />

            <CheckBox Content="Start with Windows" Foreground="{StaticResource TextBrush}"
                      IsChecked="{Binding AutoStart}" Margin="0,4" />
            <CheckBox Content="Minimize to tray" Foreground="{StaticResource TextBrush}"
                      IsChecked="{Binding MinimizeToTray}" Margin="0,4" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Cancel" Width="100" Margin="0,0,8,0"
                    Click="Cancel_OnClick" />
            <Button Style="{StaticResource AccentButton}" Content="Save" Width="100" Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</Window>
