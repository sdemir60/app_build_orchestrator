<Window x:Class="BuildOrchestrator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:beh="clr-namespace:BuildOrchestrator.App.Behaviors"
        xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels"
        xmlns:conv="clr-namespace:BuildOrchestrator.App.Converters"
        Title="Build Orchestrator" Height="760" Width="1180"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="B2V" />
        <conv:InverseBoolConverter x:Key="Inv" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="380" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="3*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- ============ LEFT: project cards + stats ============ -->
        <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Virtualized card list (Section 7: virtualization must stay on). -->
                <ListBox x:Name="ProjectList" Grid.Row="0"
                         Background="Transparent" BorderThickness="0"
                         Margin="6,8"
                         ItemsSource="{Binding ProjectsView}"
                         ItemContainerStyle="{StaticResource ProjectCardStyle}"
                         beh:AutoFocusBehavior.Enabled="True"
                         beh:AutoFocusBehavior.ActiveId="{Binding ActiveProjectId}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding CardClickedCommand}"
                                      CommandParameter="{Binding SelectedItem, ElementName=ProjectList}" />
                    </ListBox.InputBindings>
                </ListBox>

                <!-- Bottom-left: Sync + stat labels -->
                <Border Grid.Row="1" Background="#22000000" CornerRadius="0,0,10,10" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <Button ToolTip="Sync / Re-analyze" Command="{Binding SyncCommand}"
                                Style="{StaticResource CardIconButton}" Width="34" Height="34"
                                Foreground="{StaticResource AccentBrush}">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                        </Button>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource StatLabel}" Command="{Binding FilterCommand}" CommandParameter="All">
                                <TextBlock><Run Text="Total: " /><Run Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" /></TextBlock>
                            </Button>
                            <Button Style="{StaticResource StatLabel}" Command="{Binding FilterCommand}" CommandParameter="Built">
                                <TextBlock><Run Text="Built: " /><Run Text="{Binding BuiltCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" /></TextBlock>
                            </Button>
                            <Button Style="{StaticResource StatLabel}" Command="{Binding FilterCommand}" CommandParameter="Succeeded">
                                <TextBlock><Run Text="OK: " /><Run Text="{Binding SucceededCount}" FontWeight="Bold" Foreground="#35C759" /></TextBlock>
                            </Button>
                            <Button Style="{StaticResource StatLabel}" Command="{Binding FilterCommand}" CommandParameter="Failed">
                                <TextBlock><Run Text="Fail: " /><Run Text="{Binding FailedCount}" FontWeight="Bold" Foreground="#E53E3E" /></TextBlock>
                            </Button>
                            <Button Style="{StaticResource StatLabel}" Command="{Binding FilterCommand}" CommandParameter="Skipped">
                                <TextBlock><Run Text="Skip: " /><Run Text="{Binding SkippedCount}" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" /></TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ============ RIGHT: console + actions ============ -->
        <Border Grid.Column="2" Background="{StaticResource ConsoleBackground}" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Console header: status + full-log toggle -->
                <Grid Grid.Row="0" Margin="12,10,12,6">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="Full log" Foreground="{StaticResource TextSecondary}"
                                  IsChecked="{Binding Console.ErrorsOnly, Converter={StaticResource Inv}}"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                        <CheckBox Content="Reduced motion" Foreground="{StaticResource TextSecondary}"
                                  IsChecked="{Binding ReducedMotion}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="Settings"
                                Style="{StaticResource CardIconButton}" Click="OnSettingsClick" />
                    </StackPanel>
                </Grid>

                <!-- Console output: virtualized, auto-follow -->
                <ListBox x:Name="ConsoleList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0" Margin="8,0"
                         ItemsSource="{Binding Console.Visible}"
                         beh:AutoFollowBehavior.Enabled="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="12" TextWrapping="NoWrap"
                                       Foreground="{Binding IsError, Converter={StaticResource ErrorToBrush}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom-right: branch + Build/Rebuild morphing to Stop -->
                <Border Grid.Row="2" Background="#11FFFFFF" CornerRadius="0,0,10,10" Padding="12,10">
                    <Grid>
                        <ComboBox HorizontalAlignment="Left" Width="240" Height="32"
                                  ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch}"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource Inv}}"
                                  ToolTip="Branch (built in an isolated worktree)" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Idle: Build + Rebuild -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="Build" Command="{Binding BuildCommand}" Style="{StaticResource ActionButton}" />
                                <Button Content="Rebuild" Command="{Binding RebuildCommand}" Style="{StaticResource ActionButton}"
                                        Background="#3A3D43" />
                            </StackPanel>

                            <!-- Running: Stop (morph) -->
                            <Button Content="■  Stop" Command="{Binding StopCommand}"
                                    Background="#E53E3E">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
