<UserControl x:Class="BuildOrchestrator.App.Views.ProjectRowActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:views="clr-namespace:BuildOrchestrator.App.Views"
             HorizontalAlignment="Right" VerticalAlignment="Center">
  <!-- [L1/It-5 perf] Proje kartının hover eylemleri (folder + VS ikonları) ve VS seçim popover'ı. Markup
       ProjectRow.xaml'den BİREBİR taşındı — görsel/davranış AYNI, değişen tek şey NE ZAMAN kurulduğu:
       ProjectRow bu kökü İLK HOVER'da bir kez inşa edip sağ bloğa ekler (ProjectRow.xaml.cs EnsureActions).
       Öncesinde her satırda hevesle kurulan 16 nesne (2 Button + 2 ToolTip + 2 Viewbox/Canvas/Path + Popup
       alt-ağacı) hiç hover edilmese bile ödeniyordu; 191 satırda ~3056 nesne. Sticky/follow aritmetiğine
       (LayoutMetrics/FollowScrollController/ScrollArbiter) HİÇ girmez: hover bloğu Collapsed doğar ve satır
       yüksekliği (36px) PART_Root'ta sabittir. -->
  <Grid>
    <!-- Hover ikonları (sha'nın YERİNE aynı blokta): [design v1.11.0 §2.4-4] play (14px) · ⋯ (13px) ·
         folder (13px) · VS (13px). Play/⋯ ÖNDEDİR: play satırın BİRİNCİL eylemidir ve bu yüzden bir tık
         büyüktür (§3.8). Play, YALNIZ o projeyi derleyen kapsamlı koşuyu başlatır (RunViewModel.BuildProjectCommand);
         koşunun HEDEFİ olan satırda aynı yuvada kırmızı Stop durur (§3.8: "kapsam hedefi satırında play
         kırmızı Stop'a döner ve hover olmadan da görünür") — ikisi hiçbir zaman birlikte görünmez, kablaj ve
         görünürlük ProjectRow.ApplyActionState'tedir. -->
    <StackPanel x:Name="PART_HoverIcons" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Center" Visibility="Collapsed">
      <Button x:Name="PART_BuildButton" Style="{DynamicResource Ds.IconButton}"
              AutomationProperties.Name="Build this project">
        <Viewbox Width="14" Height="14">
          <Canvas Width="24" Height="24">
            <Path Data="{DynamicResource Icon.Play}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Canvas>
        </Viewbox>
      </Button>
      <!-- [design §3.8] Stop: play ile AYNI boy (birincil eylem), kırmızı (prototipin status-fail-text
           rengi), varsayılan gizli. UIA adı ve tooltip'i kod-tarafı AccessibilityNames'ten yazılır (kopya YASAK). -->
      <Button x:Name="PART_StopButton" Style="{DynamicResource Ds.IconButton}" Visibility="Collapsed">
        <Viewbox Width="14" Height="14">
          <Canvas Width="24" Height="24">
            <Path x:Name="PART_StopIcon" Data="{DynamicResource Icon.Stop}"
                  Fill="{DynamicResource Brush.StatusFailText}" />
          </Canvas>
        </Viewbox>
      </Button>
      <ToggleButton x:Name="PART_MoreButton" Style="{DynamicResource Ds.IconButton.Toggle}" Margin="2,0,0,0"
                    AutomationProperties.Name="More build actions">
        <Viewbox Width="13" Height="13">
          <Canvas Width="24" Height="24">
            <Path Data="{DynamicResource Icon.More}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
          </Canvas>
        </Viewbox>
      </ToggleButton>
      <Button x:Name="PART_RevealButton" Style="{DynamicResource Ds.IconButton}" Margin="2,0,0,0"
              AutomationProperties.Name="Reveal in Explorer" ToolTip="Reveal in Explorer">
        <Viewbox Width="13" Height="13">
          <Canvas Width="24" Height="24">
            <Path Data="{DynamicResource Icon.FolderOpen}"
                  StrokeThickness="{DynamicResource Icon.FolderOpen.StrokeThickness}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Canvas>
        </Viewbox>
      </Button>
      <Button x:Name="PART_VsButton" Style="{DynamicResource Ds.IconButton}" Margin="2,0,0,0"
              AutomationProperties.Name="Open in Visual Studio" ToolTip="Open in Visual Studio">
        <Viewbox Width="13" Height="13">
          <Canvas Width="24" Height="24">
            <Path Data="{DynamicResource Icon.Vs}"
                  StrokeThickness="{DynamicResource Icon.Vs.StrokeThickness}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Canvas>
        </Viewbox>
      </Button>
    </StackPanel>

    <!-- [design v1.11.0 §2.4-4 · §9-6] Satır menüsü (Build · Rebuild · Clean). ⋯ düğmesi ve satıra sağ tık
         AYNI popup'ı açar.

         YERLEŞİM BURADA DEĞİL: menü ⋯ düğmesine değil SATIRIN sağ kenarına çakılır ve listenin görünür
         alanına kelepçelenir (BuildApp.jsx:609/:659/:661-664). İkisi de satırın kendi ölçüsünü ve üstündeki
         ScrollViewer'ı bilmeyi gerektirir → çapa ve geri çağrı ProjectRow.EnsureActions'ta kurulur, karar
         Controls/RowMenuPlacement'ta yaşar. -->
    <Popup x:Name="PART_RowMenu" StaysOpen="False" AllowsTransparency="True"
           Placement="Custom" PopupAnimation="None"
           IsOpen="{Binding IsChecked, ElementName=PART_MoreButton, Mode=TwoWay}">
      <views:ProjectRowMenu x:Name="PART_RowMenuContent" />
    </Popup>

    <!-- [E1/T67] Birden çok solution içeren proje için Open-in-VS seçim popover'ı (D6 popover deseni:
         Ds.Popover chrome · StaysOpen=False dışa-tık-kapan · PopIn 140ms). Satırlar kod-tarafı kurulur
         (BranchPopover deseni). Tek/sıfır solution'da açılmaz. -->
    <Popup x:Name="PART_VsChooser" StaysOpen="False" AllowsTransparency="True"
           Placement="Bottom" PlacementTarget="{Binding ElementName=PART_VsButton}"
           PopupAnimation="None" VerticalOffset="4">
      <Border x:Name="PART_VsChooserContent" Style="{DynamicResource Ds.Popover}" MinWidth="220" MaxWidth="360">
        <StackPanel>
          <TextBlock Text="OPEN IN VISUAL STUDIO" Margin="4,2,4,8"
                     FontFamily="{x:Static controls:AppFonts.Ui}"
                     FontSize="{DynamicResource FontSize.2xs}"
                     FontWeight="{DynamicResource FontWeight.Emphasis}"
                     Foreground="{DynamicResource Brush.TextFaint}" />
          <StackPanel x:Name="PART_VsChooserRows" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
