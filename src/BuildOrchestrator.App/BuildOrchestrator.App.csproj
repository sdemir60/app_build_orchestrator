<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BuildOrchestrator.Core\BuildOrchestrator.Core.csproj" />
    <ProjectReference Include="..\BuildOrchestrator.Contracts\BuildOrchestrator.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RunViewModel'deki test-only race senkronizasyon kancası (Fix wave 1, Finding 2 regression testi) için. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>BuildOrchestrator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- [A13.2] PerMonitorV2 DPI (px→DIP 1:1); T65 A/B'si için de önkoşul. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildOrchestrator.Supervisor\BuildOrchestrator.Supervisor.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopySupervisorOutput" AfterTargets="Build">
    <!-- Tüm dosyaları eşle ama RecursiveDir'i TFM klasörü olmadan hesapla [it0-devir] -->
    <ItemGroup>
      <_SupervisorFiles Include="..\BuildOrchestrator.Supervisor\bin\$(Configuration)\**\*.*" />
      <!-- RecursiveDir'den TFM dizinini çıkart (ilk / öncesi) [it0-devir] -->
      <_SupervisorFiles>
        <CopyRecursiveDir Condition="'%(RecursiveDir)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('%(RecursiveDir)', '^[^\\]+\\(.*)$', '$1'))</CopyRecursiveDir>
        <CopyRecursiveDir Condition="'%(RecursiveDir)' == ''"></CopyRecursiveDir>
      </_SupervisorFiles>
    </ItemGroup>
    <!-- stale birikimi önle: hedef supervisor klasörünü kopya öncesi sil [it0-devir] -->
    <RemoveDir Directories="$(OutDir)supervisor" />
    <Copy SourceFiles="@(_SupervisorFiles)" DestinationFolder="$(OutDir)supervisor\%(CopyRecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="Fonts\*.otf" />
    <!-- CompositeFont XML de gömülmeli: pack URI ile "#Geist Mono Console" ailesini çözebilmek için [T56] -->
    <Resource Include="Fonts\*.CompositeFont" />
  </ItemGroup>

</Project>
