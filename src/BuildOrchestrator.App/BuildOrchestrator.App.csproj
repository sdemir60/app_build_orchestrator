<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BuildOrchestrator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildOrchestrator.Contracts\BuildOrchestrator.Contracts.csproj" />
    <ProjectReference Include="..\BuildOrchestrator.Core\BuildOrchestrator.Core.csproj" />
  </ItemGroup>

  <!-- Build the Worker first, but do not reference its assembly directly -->
  <ItemGroup>
    <ProjectReference Include="..\BuildOrchestrator.Worker\BuildOrchestrator.Worker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy the Worker's full output into <AppOutDir>\Worker\ so the app can spawn it -->
  <Target Name="CopyWorkerOutput" AfterTargets="Build">
    <PropertyGroup>
      <WorkerOutDir>$(MSBuildThisFileDirectory)..\BuildOrchestrator.Worker\bin\$(Configuration)\net8.0\</WorkerOutDir>
    </PropertyGroup>
    <ItemGroup>
      <WorkerFiles Include="$(WorkerOutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)"
          DestinationFiles="@(WorkerFiles->'$(OutDir)Worker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(WorkerOutDir)')" />
  </Target>

</Project>
