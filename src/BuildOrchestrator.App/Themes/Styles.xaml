<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:BuildOrchestrator.App.Converters"
    xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels"
    xmlns:contracts="clr-namespace:BuildOrchestrator.Contracts;assembly=BuildOrchestrator.Contracts">

    <conv:StatusToBrushConverter x:Key="StatusToBrush" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:ErrorToBrushConverter x:Key="ErrorToBrush" />

    <!-- Palette -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1F22" />
    <SolidColorBrush x:Key="PanelBackground" Color="#26282C" />
    <SolidColorBrush x:Key="CardBackground" Color="#2D2F34" />
    <SolidColorBrush x:Key="CardBorder" Color="#3A3D43" />
    <SolidColorBrush x:Key="ConsoleBackground" Color="#000000" />
    <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA0A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#299BF0" />

    <!-- Project card: animations use ONLY RenderTransform (scale) + Opacity (Section 7). -->
    <Style x:Key="ProjectCardStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Opacity="1">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Status accent bar -->
                            <Border Grid.Column="0" Width="4" CornerRadius="2"
                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}}" />

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4"
                                            Background="#5A3A00"
                                            Visibility="{Binding IsInCycle, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding CycleMembersTooltip}">
                                        <TextBlock Text="Cycle" FontSize="10" Foreground="#FFC451" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SolutionName}" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE838;" FontFamily="Segoe MDL2 Assets" ToolTip="Open in File Explorer"
                                        Style="{StaticResource CardIconButton}"
                                        Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="&#xE7AC;" FontFamily="Segoe MDL2 Assets" ToolTip="Open in Visual Studio"
                                        Style="{StaticResource CardIconButton}"
                                        Command="{Binding DataContext.OpenInVsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Active card: gentle scale-up + bring to front (carousel feel). -->
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Building: subtle pulsing border opacity. -->
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:ProjectStatus.Building}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PulseSb">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.78" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseSb" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Succeeded: quick glow (opacity blip). -->
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:ProjectStatus.Succeeded}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         From="0.6" To="1.0" Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>

                        <!-- Failed: short horizontal shake via render transform. -->
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:ProjectStatus.Failed}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX">
                                            <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.0" />
                                            <LinearDoubleKeyFrame Value="1.04" KeyTime="0:0:0.06" />
                                            <LinearDoubleKeyFrame Value="0.97" KeyTime="0:0:0.12" />
                                            <LinearDoubleKeyFrame Value="1.0" KeyTime="0:0:0.20" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>

                        <!-- Skipped: fade + desaturate (opacity only). -->
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:ProjectStatus.Skipped}">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small icon button used on cards. -->
    <Style x:Key="CardIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3A3D43" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action button (Build/Rebuild/Stop). -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clickable stat label. -->
    <Style x:Key="StatLabel" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
