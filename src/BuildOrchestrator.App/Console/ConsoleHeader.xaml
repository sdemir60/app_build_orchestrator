<UserControl x:Class="BuildOrchestrator.App.Console.ConsoleHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:app="clr-namespace:BuildOrchestrator.App">
  <!-- [T56/3a → v1.18.0 §9 "Konsol başlığı ve `Back` satırı"] Konsol panel başlığı — README §9 v1.18.0 alt
       bölümüyle BİREBİR: 28px sabit, 10px yatay padding, öğeler arası 8px, zemin surface, alt 1px
       border-subtle. İki hâl aynı kabuktadır: anlatı (caps "CONSOLE" + sağda N lines) ve proje-log (Back +
       proje adı + statü glyph/adı + [dep-issue] + [cycle] solda, Copy log + N lines sağda).

       Sol/sağ ayrımı DIŞ Grid'in iki sütunuyladır (* / Auto): sağ blok (Copy log + N lines) HER ZAMAN tam
       genişliğindedir — asla kırpılmaz. Sol taraf kendi İÇ Grid'inde tek bir "*" sütuna sahiptir (proje adı);
       Back, statü glyph'i/adı ve rozetler Auto'dur, yani panel daraldığında kısalan TEK öğe proje adıdır. -->
  <Border Height="28" Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
    <Grid Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- SOL: moda göre değişen içerik — aynı hücrede iki dal, yalnız biri görünür. -->
      <Grid Grid.Column="0">
        <controls:TrackedTextBlock x:Name="ConsoleLabel" Text="Console" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" />

        <Grid x:Name="ProjectLogGroup" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />  <!-- Back -->
            <ColumnDefinition Width="*" />     <!-- proje adı: panel daralınca kısalan TEK öğe -->
            <ColumnDefinition Width="Auto" />  <!-- statü glyph'i -->
            <ColumnDefinition Width="Auto" />  <!-- statü adı -->
            <ColumnDefinition Width="Auto" />  <!-- dependency issue rozeti -->
            <ColumnDefinition Width="Auto" />  <!-- dependency cycle rozeti -->
          </Grid.ColumnDefinitions>

          <!-- [README §9 v1.18.0] DS Button ghost/sm (24px yükseklik). İçeriği (Icon.Back + "Back")
               code-behind kurulur: ikon butonun Foreground'unu İZLER (currentColor — hover'da
               text-secondary→text-primary birlikte değişir, bkz. ctor). margin-left -6, ghost'un kendi 10px
               iç boşluğunu optik olarak geri alır — bu tasarımın PARÇASIDIR, kırpma değil. -->
          <Button x:Name="BackButton" Grid.Column="0" Style="{DynamicResource Ds.Button.Ghost.Sm}"
                  Margin="-6,0,0,0" VerticalAlignment="Center" Click="OnBackClick"
                  AutomationProperties.Name="{x:Static app:AccessibilityNames.BackButton}" />

          <!-- Tam proje adı — Mono 12px, panel daralınca TEK kısalan öğe (TextTrimming). -->
          <TextBlock x:Name="ProjectNameText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="12"
                     Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />

          <!-- Statü glyph'i — 13px çizilmiş StatusGlyph; building'de kontrolün kendi BuildingSpinner'ı döner. -->
          <controls:StatusGlyph x:Name="StatusGlyphIcon" Grid.Column="2" Size="13" Margin="8,0,0,0"
                                 VerticalAlignment="Center" />

          <TextBlock x:Name="StatusNameText" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="11" />

          <!-- [README §9] amber KONTUR üçgeni (Icon.AlertTri, 8px) + 11px metin; tooltip code-behind kurulur
               (RowWarning.DepIssueDetail — tek doğruluk kaynağı, satırın "+N" kısaltmasından AYRI). Data/Stroke/
               StrokeThickness doğrudan DynamicResource — sabit renk, kod-tarafı IconPaint GEREKMEZ (CopyLogGlyph'in
               aksine bu ikisi hiç DEĞİŞMEZ); ayrıca bu XAML-yerel bağ, koşulsuz kendi kendine çözülür (Collapsed
               dalda bile) — code-behind bir tetikleyici (ShowProjectLog) beklemez. -->
          <StackPanel x:Name="DepIssueBadge" Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0"
                      VerticalAlignment="Center" Visibility="Collapsed" Cursor="Arrow">
            <Viewbox Width="8" Height="8" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path x:Name="DepIssueGlyph" Data="{DynamicResource Icon.AlertTri}"
                      Stroke="{DynamicResource Brush.AmberText}"
                      StrokeThickness="{DynamicResource Icon.AlertTri.StrokeThickness}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="dependency issue" Margin="5,0,0,0" FontSize="11"
                       Foreground="{DynamicResource Brush.AmberText}" />
          </StackPanel>

          <!-- [README §9] Döngü rozeti — sıradaki uyarı, dep-issue ile AYNI ANDA görünebilir (satırdaki tek
               üçgenin aksine, başlıkta ikisinin de kendi slotu var). Tooltip metni RowWarning.InCycle'dan
               (satırın döngü tooltip'iyle AYNI cümle, kopya YASAK). -->
          <StackPanel x:Name="CycleBadge" Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0"
                      VerticalAlignment="Center" Visibility="Collapsed" Cursor="Arrow">
            <Viewbox Width="8" Height="8" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path x:Name="CycleGlyph" Data="{DynamicResource Icon.AlertTri}"
                      Stroke="{DynamicResource Brush.AmberText}"
                      StrokeThickness="{DynamicResource Icon.AlertTri.StrokeThickness}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="dependency cycle" Margin="5,0,0,0" FontSize="11"
                       Foreground="{DynamicResource Brush.AmberText}" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- SAĞ: Copy log (yalnız proje-log modunda, log varken) + N lines (TAM tampon uzunluğu — Ek A #23;
           render dilimi DEĞİL). Auto sütunda durur — asla kırpılmaz. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- [3b/Ek A #3 → v1.18.0] DS IconButton (22×22, sm ölçüsü zaten budur). İkon fontu YOK: Icon.Copy →
             başarılı kopyada Icon.Check + "Copied" tooltip (1400ms), ikisi de Icons.xaml'den çizilmiş
             geometri (bkz. ConsoleHeader.xaml.cs). Foreground override AboutDialog.CopyButton ile AYNI
             desendir (kopya YASAK): SetResourceReference DsTransition'ın hover fırçasını geçici olarak alır. -->
        <Button x:Name="CopyLogButton" Style="{DynamicResource Ds.IconButton}" Visibility="Collapsed"
                Click="OnCopyLogClick" AutomationProperties.Name="{x:Static app:AccessibilityNames.CopyLog}">
          <Viewbox Width="12" Height="12">
            <Canvas Width="24" Height="24">
              <Path x:Name="CopyLogGlyph" />
            </Canvas>
          </Viewbox>
        </Button>
        <TextBlock x:Name="LinesText" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                   Foreground="{DynamicResource Brush.TextFaint}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
