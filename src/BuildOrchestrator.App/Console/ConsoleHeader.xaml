<UserControl x:Class="BuildOrchestrator.App.Console.ConsoleHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls">
  <!-- [T56/3a] Konsol panel başlığı — design-v1 §2.5 PanelHead: 28px, surface zemin, alt 1px border-subtle.
       İki mod: Anlatı (caps "CONSOLE" etiketi) ve Proje-log (← Back + proje adı + statü glyph/adı + ▲ badge).
       Sağda mono "N lines" (TAM tampon uzunluğu — Ek A #23; render dilimi DEĞİL). -->
  <Border Height="28" Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
    <DockPanel Margin="10,0" LastChildFill="True">
      <!-- Sağ: N lines (en sağda) -->
      <TextBlock x:Name="LinesText" DockPanel.Dock="Right" VerticalAlignment="Center"
                 FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                 Foreground="{DynamicResource Brush.TextFaint}" />
      <!-- [3b/Ek A #3] Copy log butonu — yalnız proje-log modunda (log varken) görünür; N lines'ın SOLUNDA.
           [T64] İkon fontu YOK: Icon.Copy → başarılı kopyada Icon.Check + "Copied" tooltip (1400ms), ikisi de
           Icons.xaml'den çizilmiş geometri (bkz. ConsoleHeader.xaml.cs). 24'lük viewBox 12px'e Viewbox ile
           küçültülür — böylece stroke da birlikte küçülür (Path.Stretch stroke'u ölçeklemez).
           DynamicResource: headless test host'unda (merge zinciri yok) StaticResource throw ederdi. -->
      <Button x:Name="CopyLogButton" DockPanel.Dock="Right" Visibility="Collapsed" Click="OnCopyLogClick"
              Background="Transparent" BorderThickness="0" Padding="4,0" Margin="0,0,8,0" Cursor="Hand"
              VerticalAlignment="Center" ToolTip="Copy log"
              Foreground="{DynamicResource Brush.TextSecondary}">
        <Viewbox Width="12" Height="12">
          <Canvas Width="24" Height="24">
            <Path x:Name="CopyLogGlyph" Data="{DynamicResource Icon.Copy}" StrokeThickness="1.8"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Canvas>
        </Viewbox>
      </Button>
      <!-- Sol: moda göre değişen içerik -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:TrackedTextBlock x:Name="ConsoleLabel" Text="Console" VerticalAlignment="Center" />

        <Button x:Name="BackButton" Content="&#x2190; Back" Visibility="Collapsed"
                Background="Transparent" BorderThickness="0" Padding="2,0" Margin="-2,0,0,0"
                Foreground="{DynamicResource Brush.TextSecondary}" Cursor="Hand"
                VerticalAlignment="Center" Click="OnBackClick" />
        <TextBlock x:Name="ProjectNameText" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusGlyphText" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontSize="12" />
        <TextBlock x:Name="StatusNameText" Visibility="Collapsed" Margin="5,0,0,0" VerticalAlignment="Center"
                   FontSize="11" />
        <StackPanel x:Name="DepIssueBadge" Orientation="Horizontal" Visibility="Collapsed"
                    Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#x25B2;" FontSize="10" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.StatusFailText}" />
          <TextBlock Text="dependency issue" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.StatusFailText}" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
