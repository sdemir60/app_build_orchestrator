<UserControl x:Class="BuildOrchestrator.App.Console.ConsoleHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:app="clr-namespace:BuildOrchestrator.App">
  <!-- [T56/3a → v1.18.0 §9] Konsol panel başlığı: 28px sabit, 10px yatay padding, zemin surface, alt 1px border-subtle. İki
       hâl aynı kabuktadır: anlatı (caps "CONSOLE" + sağda N lines, anlatı kompakt yazılıyorsa yanında "compact") ve proje-log
       (solda proje adı, sağda Copy log + N lines).

       [DEĞİŞEN KURAL — kullanıcı kararı 2026-10-25] Proje-log hâlinin solunda eskiden Back + ad + statü glyph'i + statü
       sözcüğü + dependency issue / dependency cycle rozetleri dururdu; kullanıcı proje sayfasında bunlara gerek görmedi ve
       yalnız ad kaldı. Gerekçe ve eski iddialar: ConsoleHeaderDesignTests'in sınıf özeti. Anlatıya dönüş seçimin kendi
       yollarıdır (aynı satıra/düğüme yeniden tık, grafın boş zemini, Esc).

       Sol/sağ ayrımı DIŞ Grid'in iki sütunuyladır (* / Auto): sağ blok (Copy log + N lines) HER ZAMAN tam genişliğindedir —
       asla kırpılmaz. Ad sol sütunun KENDİSİDİR: sütun kalan alanı alır, ad o alanda sola yaslı durur (kutusu metnin doğal
       genişliğinde, panele gerilmez) ve sığmazsa TextTrimming ile kısalır. Adın yanında başka öğe kalmadığı için genişliğini
       elle hesaplamaya gerek yoktur. -->
  <Border Height="28" Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
    <Grid x:Name="RootGrid" Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- SOL: moda göre değişen içerik — aynı hücrede iki öğe, yalnız biri görünür. -->
      <controls:TrackedTextBlock x:Name="ConsoleLabel" Grid.Column="0" Text="Console" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />

      <!-- Tam proje adı — Mono 12px. Sol sütunun kalan payına sığmazsa kısalır (TextTrimming). -->
      <TextBlock x:Name="ProjectNameText" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Center"
                 HorizontalAlignment="Left" FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="12"
                 Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />

      <!-- SAĞ: Copy log (yalnız proje-log modunda, log varken) + N lines (TAM tampon uzunluğu — Ek A #23;
           render dilimi DEĞİL) + compact (yalnız anlatı modunda, kompakt yazılırken). Auto sütunda durur — asla kırpılmaz. -->
      <StackPanel x:Name="RightBlock" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- [3b/Ek A #3 → v1.18.0] DS IconButton (22×22, sm ölçüsü zaten budur). İkon fontu YOK: Icon.Copy →
             başarılı kopyada Icon.Check + "Copied" tooltip (1400ms), ikisi de Icons.xaml'den çizilmiş
             geometri (bkz. ConsoleHeader.xaml.cs). Foreground override AboutDialog.CopyButton ile AYNI
             desendir (kopya YASAK): SetResourceReference DsTransition'ın hover fırçasını geçici olarak alır. -->
        <Button x:Name="CopyLogButton" Style="{DynamicResource Ds.IconButton}" Visibility="Collapsed"
                Click="OnCopyLogClick" AutomationProperties.Name="{x:Static app:AccessibilityNames.CopyLog}">
          <Viewbox Width="12" Height="12">
            <Canvas Width="24" Height="24">
              <Path x:Name="CopyLogGlyph" />
            </Canvas>
          </Viewbox>
        </Button>
        <TextBlock x:Name="LinesText" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                   Foreground="{DynamicResource Brush.TextFaint}" />
        <!-- [idle-memory · dalga 2 · spec §6.5] "compact": anlatıyı kompakt kip yazıyorsa sayacın hemen sağında — sayaçla AYNI
             tipografi (mono 11, soluk), öğeler arası 8px. Yalnız anlatı modunda ve workspace varken görünür; görünürlük
             kod-tarafıdır (SetCompact · ApplyCompactTag). -->
        <TextBlock x:Name="CompactText" Text="compact" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                   Foreground="{DynamicResource Brush.TextFaint}" Visibility="Collapsed" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
