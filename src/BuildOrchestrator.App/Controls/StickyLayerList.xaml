<UserControl x:Class="BuildOrchestrator.App.Controls.StickyLayerList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:views="clr-namespace:BuildOrchestrator.App.Views">
  <!-- [T58] Sticky overlay mimarisi (feasibility §3.3 — tasarımın en zor layout parçası): liste ScrollViewer'ının
       üstünde overlay ItemsControl (Canvas). Yapışık başlık kümesi salt aritmetikle (LayoutMetrics: 36px satır +
       24px başlık kümülatif tablosu) hesaplanır; overlay item'ları in-flow başlıkla AYNI DataTemplate + opak
       zemin (Brush.Surface) → geçiş görünmez.

       Satır akışı SANALLAŞTIRILMIŞTIR (FixedHeightVirtualizingPanel): yalnız görünür pencereye düşen satırlar
       realize olur. WPF'in kendi VirtualizingStackPanel'i BURADA KULLANILAMAZ — o, realize edilmemiş öğeleri
       ORTALAMA yükseklikle tahmin eder ve karışık 36/24 tabloda scroll ekseni yukarıdaki kümülatif aritmetikten
       kayardı (yapışık başlık + follow + seçim-scroll üçü de o tabloyu okur). Panel yüksekliği tahmin etmez,
       EntryHeightSelector ile SORAR → VerticalOffset ile tablo asla ayrışmaz. -->
  <UserControl.Resources>
    <!-- [v1.17.0 §2.4 "Katman başlıkları tıklanabilir"] Başlık artık bir gezinme kontrolü: dinlenme
         surface/border-subtle/text-faint, hover surface-raised/border/text-secondary, geçiş mevcut 120ms
         altyapısı (DsTransition — Ds.Bar.Chip ile AYNI desen). İmleç Hand; tıklama StickyLayerList.xaml.cs'teki
         HeaderRoot_MouseLeftButtonUp'a kablıdır (in-flow VE overlay AYNI şablonu paylaştığından TEK kablo
         ikisine de yeter). -->
    <Style x:Key="Ds.LayerHeader" TargetType="Border">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="controls:DsTransition.AnimatedBackground" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="controls:DsTransition.AnimatedBorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="controls:DsTransition.AnimatedBackground" Value="{DynamicResource Brush.SurfaceRaised}" />
          <Setter Property="controls:DsTransition.AnimatedBorderBrush" Value="{DynamicResource Brush.Border}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Başlığın İKİ metin parçası (caps ad + mono sayı) AYNI hover dilini konuşur; TargetType=FrameworkElement
         olduğundan tek stil hem TrackedTextBlock'a hem düz TextBlock'a uygulanır (kopya YASAK) — DsTransition.
         AnimatedForeground zaten öğe TÜRÜNE göre doğru DP'yi bulur (bkz. DsTransition.ForegroundTarget).
         Hover, Border'ın (ATA) IsMouseOver'ını DataTrigger ile okur — Style.Triggers başka bir öğeyi
         HEDEFLEYEMEZ, bu yüzden zemin/kenar Border'ın kendi tetikleyicisinde, metin burada AYRI ama AYNI
         sinyalden beslenir. -->
    <Style x:Key="Ds.LayerHeader.Text" TargetType="FrameworkElement">
      <Setter Property="controls:DsTransition.AnimatedForeground" Value="{DynamicResource Brush.TextFaint}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
          <Setter Property="controls:DsTransition.AnimatedForeground" Value="{DynamicResource Brush.TextSecondary}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- design-v1 §2.4: katman başlığı 24px, caps 11px (TrackedTextBlock — letter-spacing 0.07em) + mono satır
         sayısı. In-flow VE overlay AYNI bu şablonu (tek nesne) kullanır — bkz. StickyLayerList.xaml.cs. -->
    <DataTemplate x:Key="HeaderTemplate">
      <Border Height="{x:Static controls:LayoutMetrics.DefaultHeaderHeight}" Style="{StaticResource Ds.LayerHeader}"
              BorderThickness="0,0,0,1"
              ToolTip="{Binding Name, Converter={x:Static controls:StickyLayerList.JumpTooltipConverter}}"
              MouseLeftButtonDown="HeaderRoot_MouseLeftButtonDown"
              MouseLeftButtonUp="HeaderRoot_MouseLeftButtonUp">
        <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
          <controls:TrackedTextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                      Style="{StaticResource Ds.LayerHeader.Text}" />
          <TextBlock Text="{Binding RowCount}" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                     Style="{StaticResource Ds.LayerHeader.Text}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- design-v1 §2.4: satır 36px (yükseklik ProjectRow kökünde LayoutMetrics.DefaultRowHeight'a bağlı — sticky
         aritmetiği bunu varsayar). Tam 7-slot kart It-4b/D1: Views/ProjectRow. Item = ProjectRowViewModel. -->
    <DataTemplate x:Key="RowTemplate">
      <views:ProjectRow />
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.SurfaceBase}">
    <!-- Liste: sanallaştırılmış, PİKSEL scroll → VerticalOffset(px) = LayoutMetrics içerik Y'si (birebir).
         CanContentScroll KAPALI KALIR (varsayılan): kaydırmayı yine BU ScrollViewer yürütür, panel ona gerçek
         toplam yüksekliği bildirir ve yalnız görünür pencereyi realize eder — mevcut scroll tesisatı
         (ScrollAnimator, bottom-anchor, follow-mode) hiç değişmez. -->
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- [E5/T47] Satırlar (ProjectRow, Focusable) Tab ile ulaşılır; ok tuşları satırlar arası gezinir
           (DirectionalNavigation=Contained → odak liste içinde kalır, başlıklar odaklanamaz → atlanır). -->
      <ItemsControl x:Name="Flow"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabNavigation="Continue"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:FixedHeightVirtualizingPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>

    <!-- Overlay: yapışık başlıklar (StuckHeader) Canvas.Top=PinnedY(i×24)'te; in-flow ile AYNI HeaderTemplate.
         Genişlik = viewport (scrollbar hariz) ki başlık şeridi tam satır genişliğinde in-flow başlığı örtsün.
         [v1.17.0 §2.4 — DEĞİŞEN KURAL] Overlay artık hit-test'e AÇIK: kullanıcı çoğunlukla yapışık başlığa
         tıklar, o da tıklanabilir olmalı. Canvas'ın kendi Background'ı YOKTUR (null) → başlık bandının ALTINDAKİ
         boş alan yine WPF'in "null Background hit-test etmez" kuralıyla şeffaf kalır ve satır hover/tıklaması
         Scroll'a ulaşmaya devam eder; yalnız OPAK başlık Border'ları (gerçek Background) hit-testable'dır.
         Tekerlek istisnası: Overlay, Scroll'un ATASI değil KARDEŞİdir — imleç yığılmış başlık bandındayken bir
         wheel olayı doğal olarak Scroll'a hiç uğramaz; StickyLayerList.xaml.cs bunu ForwardWheelToScroll ile
         elle Scroll'a yeniden yükseltir. -->
    <ItemsControl x:Name="Overlay" ItemTemplate="{StaticResource HeaderTemplate}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="0" />
          <Setter Property="Canvas.Top" Value="{Binding PinnedY}" />
          <Setter Property="Width" Value="{Binding ViewportWidth, ElementName=Scroll}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
    </ItemsControl>
  </Grid>
</UserControl>
