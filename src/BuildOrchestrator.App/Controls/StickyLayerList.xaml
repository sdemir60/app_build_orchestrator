<UserControl x:Class="BuildOrchestrator.App.Controls.StickyLayerList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls">
  <!-- [T58] Sticky overlay mimarisi (feasibility §3.3 — tasarımın en zor layout parçası): liste ScrollViewer'ının
       üstünde overlay ItemsControl (Canvas). Yapışık başlık kümesi salt aritmetikle (LayoutMetrics: 36px satır +
       24px başlık kümülatif tablosu) hesaplanır; overlay item'ları in-flow başlıkla AYNI DataTemplate + opak
       zemin (Brush.Surface) → geçiş görünmez. Virtualization KAPALI (§4.1 drift). -->
  <UserControl.Resources>
    <!-- design-v1 §2.4: katman başlığı 24px, caps 11px (TrackedTextBlock — letter-spacing 0.07em) + mono satır
         sayısı. In-flow VE overlay AYNI bu şablonu (tek nesne) kullanır — bkz. StickyLayerList.xaml.cs. -->
    <DataTemplate x:Key="HeaderTemplate">
      <Border Height="{x:Static controls:LayoutMetrics.DefaultHeaderHeight}" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
          <controls:TrackedTextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RowCount}" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                     Foreground="{DynamicResource Brush.TextFaint}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- design-v1 §2.4: satır 36px, alt çizgi border-subtle. Tam kart (statü şeridi/dot/ikonlar/ETA) It-4b —
         burada sticky'yi gözle doğrulamaya yetecek minimal satır (ad). -->
    <DataTemplate x:Key="RowTemplate">
      <Border Height="{x:Static controls:LayoutMetrics.DefaultRowHeight}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
        <TextBlock Text="{Binding Name}" Margin="12,0" VerticalAlignment="Center"
                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.SurfaceBase}">
    <!-- Liste: virtualization KAPALI (§4.1), pixel scroll → VerticalOffset(px) = LayoutMetrics içerik Y'si. -->
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Flow"
                    VirtualizingPanel.IsVirtualizing="False" VirtualizingPanel.ScrollUnit="Pixel">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>

    <!-- Overlay: yapışık başlıklar (StuckHeader) Canvas.Top=PinnedY(i×24)'te; in-flow ile AYNI HeaderTemplate.
         IsHitTestVisible=False → scroll'u bloklamaz. Genişlik = viewport (scrollbar hariz) ki başlık şeridi tam
         satır genişliğinde in-flow başlığı örtsün. -->
    <ItemsControl x:Name="Overlay" IsHitTestVisible="False" ItemTemplate="{StaticResource HeaderTemplate}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="0" />
          <Setter Property="Canvas.Top" Value="{Binding PinnedY}" />
          <Setter Property="Width" Value="{Binding ViewportWidth, ElementName=Scroll}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
    </ItemsControl>
  </Grid>
</UserControl>
