<UserControl x:Class="BuildOrchestrator.App.Controls.TrayBuildIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             Background="Transparent">
  <!--
    ================== TEPSİ DERLEME GÖSTERGESİ — marka animasyonu ==================

    Kaynak: `.claude/outputs/2026-08-05-05-06-logo-animation-v1.3.0/BuildOrchestratorIcon.xaml`
    (+ aynı klasördeki README'nin zamanlama tablosu ve entegrasyon notları).

    ZAMAN ÇİZELGESİ VERBATİM TAŞINIR. Aşağıdaki KeyTime/KeySpline/mesafe değerleri bir tasarım token'ı
    DEĞİLDİR — 3 saniyelik bir sanat eseridir; `Duration.*` rampası (80–280 ms arası arayüz geçişleri) ile
    aynı dilde konuşmaz ve ona bağlanamaz. Bu, `AppMark`'ın SVG'den birebir taşınan geometrisiyle aynı
    statüdedir: kaynak sanat yeniden yorumlanmaz. Motion guard'ının XAML süre yasağı bu dosya için
    gerekçeli ve DAR bir istisna taşır (NoHardcodedMotionTests); kod tarafına TEK bir ms literali yazılmaz —
    bekleme ve koşullar storyboard'un `Completed` olayından akar.

    Reduced-motion bu çizelgeyi kısaltmaz, HİÇ BAŞLATMAZ: kapalıyken kontrol duruş karesinde durur
    (aşağıdaki TABAN DEĞERLER zaten o karedir).

    ─ AKIŞ ─────────────────────────────────────────────────────────────────────────────────
    GİRİŞ  (0–1.34s)  Amber şevron en solda soluk belirir, sağa süzülür. Şevron siluetini takip eden bir
                      kaplama (SweepShift) şeritleri SİLEREK açar; şeritler kendi gecikmeleriyle peşinden
                      gelir — şevron onları seriyormuş gibi görünür.
    DURUŞ  (1.34–2.10s)  Orijinal logo karesi.
    ÇIKIŞ  (2.10–3.00s)  Şevron ilk hareket eder ve hızlanarak uzaklaşır; şeritler farklı hız/mesafelerle
                      peşinden gider. Hepsinin SAĞ UCU aynı noktada (x=250.5) yok olur; her parçanın solması
                      340 ms sürer ve tam kendi hareketinin bittiği anda 0'a iner — damla damla kaybolurlar.
    ────────────────────────────────────────────────────────────────────────────────────────

    TABAN DEĞERLER = DURUŞ KARESİ. Kaynak asset kendini `Loaded`'da başlattığı için taban değerleri GİRİŞ
    karesine (şevron X=-170, opaklık 0) kurmuştu. Burada döngüyü kod başlatır ve `Stop()` her zaman tabana
    döner; taban duruş karesi olunca "statik işaret" ayrı bir kompozisyon gerektirmez — bir Stop() yeter.
    Bu yüzden aşağıda hiçbir öğe başlangıç X'i / opaklığı taşımaz (varsayılanlar 0 ve 1'dir); giriş konumunu
    storyboard'un t=0 karesi verir.
  -->

  <UserControl.Resources>
    <!-- Silme maskesi: soldan gelen geniş bir figür; sağ kenarı şevronun siluetini izler. SABİT bir geometridir
         — hareketi taşıyan şey maske tuvalinin RENDER dönüşümüdür (SweepShift), geometrinin kendi Transform'u
         DEĞİL: canlı katmanlı pencere Clip geometrisinin animasyonlu Transform'unu yeniden boyamıyordu.
         Şevronun PAYLAŞILAN geometrisi burada kullanılamaz — bu figür şevronun kendisi değil, onun izini taşıyan
         bir maskedir. Hem Clip'in taban değeri hem turun başındaki keyframe AYNI kaynağı okur. -->
    <PathGeometry x:Key="StripsMaskGeometry"
                  Figures="M -600 -30 L 158.5 -30 L 158.5 83 L 147 95 L 152 104 L 186 140 L 186 148 L 151 184 L 148 196 L 158.5 203 L 158.5 320 L -600 320 Z"/>

    <Storyboard x:Key="TrayLoop" Duration="0:0:3">

      <!-- ===== ŞEVRON: kayma ===== -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChevronShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-170"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.100" Value="-170"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.150" Value="0" KeySpline="0.14,0.62 0.2,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.100" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.800" Value="110" KeySpline="0.34,0 0.68,0.6"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== ŞEVRON: opaklık ===== -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1" KeySpline="0.32,0.5 0.4,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.460" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.800" Value="0" KeySpline="0.45,0.15 0.6,1"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== SİLME KAPLAMASI: şevronla BİREBİR aynı =====
           KRİTİK (deliverable README): bu animasyonun KeyTime ve KeySpline değerleri ChevronShift ile birebir
           aynı OLMAK ZORUNDA — "şevron şeritleri siliyor" etkisinin tamamı bu senkrona bağlıdır. Biri
           değişirse diğeri de değişir (pin: TrayBuildIndicatorTests.Sweep_and_chevron_share_the_exact_same_keyframes). -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-170"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.100" Value="-170"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.150" Value="0" KeySpline="0.14,0.62 0.2,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.100" Value="0"/>
        <!-- Çıkışta kaplama şevrondan daha uzağa gider (260): şerit yolları uzadığı için, aksi halde bir
             şerit kaplamanın kenarına takılıp kesilirdi. Giriş kısmı şevronla BİREBİR aynı kalmalı. -->
        <SplineDoubleKeyFrame KeyTime="0:0:2.800" Value="260" KeySpline="0.34,0 0.68,0.6"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== TELAFİ: şeritler kaplamayla birlikte KAYMASIN =====
           Kaplama maske tuvalini render dönüşümüyle kaydırır; şeritler o tuvalin içinde durduğu için aynı
           miktar TERS yönde geri alınır. Değerler kaplamanınkinin TERSİ, zaman ve eğri birebir aynı — ikisinin
           toplamı her an sıfırdır (pin: TrayBuildIndicatorTests
           .The_sweep_moves_the_mask_as_a_render_transform_and_the_strips_stay_put). -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepCounterShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="170"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.100" Value="170"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.150" Value="0" KeySpline="0.14,0.62 0.2,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.100" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.800" Value="-260" KeySpline="0.34,0 0.68,0.6"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== MASKE: turun başında konur, kaplama yerine oturduğu an (1.150) bırakılır =====
           0'daki keyframe ZORUNLU: storyboard yeniden başlarken keyframe'siz bir başlangıç kökenini önceki turun
           SON değerinden (null) alır ve şeritler maskesiz başlardı. Düşme zamanı kaplamanın giriş keyframe'iyle
           aynı olmak ZORUNDA (pin: TrayBuildIndicatorTests.The_mask_drops_on_the_sweeps_own_rest_keyframe). -->
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StripsMask" Storyboard.TargetProperty="Clip" Duration="0:0:3">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource StripsMaskGeometry}"/>
        <DiscreteObjectKeyFrame KeyTime="0:0:1.150" Value="{x:Null}"/>
      </ObjectAnimationUsingKeyFrames>

      <!-- ===== AMBER ŞERİT ===== -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AmberShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-89"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.200" Value="-89"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.180" Value="0" KeySpline="0.16,0.7 0.22,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.130" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.780" Value="80" KeySpline="0.42,0 0.75,0.5"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StripAmberRect" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.440" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.780" Value="0" KeySpline="0.45,0.15 0.6,1"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== BEYAZ ŞERİT ===== -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WhiteShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-72"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.260" Value="-72"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.220" Value="0" KeySpline="0.12,0.66 0.18,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.175" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.840" Value="88" KeySpline="0.42,0 0.75,0.5"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StripWhiteRect" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.500" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.840" Value="0" KeySpline="0.45,0.15 0.6,1"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== ÜST KOYU ŞERİT ===== -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TopDarkShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-43"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.300" Value="-43"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.260" Value="0" KeySpline="0.16,0.7 0.22,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.225" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.890" Value="142" KeySpline="0.45,0 0.78,0.52"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StripTopDarkRect" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.550" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.890" Value="0" KeySpline="0.45,0.15 0.6,1"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== GÜMÜŞ ŞERİT ===== -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SilverShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-35"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.360" Value="-35"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.300" Value="0" KeySpline="0.12,0.66 0.18,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.275" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.940" Value="128" KeySpline="0.45,0 0.78,0.52"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StripSilverRect" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.600" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:2.940" Value="0" KeySpline="0.45,0.15 0.6,1"/>
      </DoubleAnimationUsingKeyFrames>

      <!-- ===== ORTA KOYU ŞERİT ===== (son parça: 3.000'de kaybolur, döngü tam o anda başa döner) -->
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MidDarkShift" Storyboard.TargetProperty="X" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-21"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.400" Value="-21"/>
        <SplineDoubleKeyFrame KeyTime="0:0:1.340" Value="0" KeySpline="0.16,0.7 0.22,1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.325" Value="0"/>
        <SplineDoubleKeyFrame KeyTime="0:0:3.000" Value="160" KeySpline="0.42,0 0.75,0.5"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StripMidDarkRect" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:2.660" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:3.000" Value="0" KeySpline="0.45,0.15 0.6,1"/>
      </DoubleAnimationUsingKeyFrames>

    </Storyboard>
  </UserControl.Resources>

  <Viewbox Stretch="Uniform">
    <!-- Sahne tasarımcının BANDI: dış Canvas (Stage) önizlemenin viewBox="-30 76 375 134" değeriyle BİREBİR
         aynı ölçüde (.claude/outputs/2026-08-05-05-06-logo-animation-v1.3.0/Build Orchestrator Tray
         Indicator.dc.html) — genişlik/yükseklik TrayBuildIndicator.StageWidth/StageHeight'tan okunur, burada
         ikinci kez sayı yazılmaz. Asıl logo karesi (iç 286×286 canvas, Inner) bandın içine
         Canvas.Left="30" Canvas.Top="-76" ile yerleşir: iç koordinatın (-30,76) noktası bandın (0,0)'ına
         denk gelir, yani band iç koordinatta x −30..345 / y 76..210 aralığını gösterir. Döngünün çizdiği
         FİGÜRLER (şevron ve şeritlerin kendi geometrisi) bu aralığın içinde kalır — şevron −24..339.5
         arasında girip çıkar, şeritlerin yolu 30.5..250.5'tir, üstte ve altta 7'şer birim pay kalır
         (83→76, 203→210). Bu pay FİGÜRLER içindir: şevronun kendi DropShadowEffect'inin (ShadowDepth 2.6,
         BlurRadius 5.6) en dış bulanıklık ucu bandın kenarını ~1 birim aşabilir (bu ölçekte alt-piksel) —
         bant bunun için büyütülmedi, fark ekranda görünmez. Hiçbir yerde kırpma sınırı yoktur
         (ClipToBounds="False"): çerçeveleme bu iki Canvas'ın ölçüsünden ve onu saran overlay penceresinden
         gelir, parçalar giriş/çıkışta kesilmez. -->
    <Canvas x:Name="Stage"
            Width="{x:Static controls:TrayBuildIndicator.StageWidth}"
            Height="{x:Static controls:TrayBuildIndicator.StageHeight}"
            ClipToBounds="False" Background="Transparent">
      <Canvas x:Name="Inner" Canvas.Left="30" Canvas.Top="-76" Width="286" Height="286" ClipToBounds="False">

        <!-- Şeritler: şevron siluetiyle SİLİNEREK açılır (kaplama şevronla birlikte kayar). Maske YALNIZ
             GİRİŞE aittir: kaplama yerine oturduğu keyframe'de Clip düşer (storyboard'daki StripsMask
             animasyonu) ve döngünün geri kalanında şeritlerin üstünde kırpma yoktur. Gerekçe: canlı
             pencerede maske çıkışta amber şeridin duruşta gizli kalan ucunu açmıyor, şerit dik bir çizgide
             kesilmiş görünüyordu. Duruş karesi maskesiz de aynıdır — maske yalnız şevronun zaten örttüğü
             bölgeyi kırpıyordu (AppMark hiç maske kullanmaz ve aynı kareyi çizer). -->
        <Canvas x:Name="StripsMask" Width="286" Height="286" ClipToBounds="False"
                Clip="{StaticResource StripsMaskGeometry}">
          <Canvas.RenderTransform><TranslateTransform x:Name="SweepShift"/></Canvas.RenderTransform>

          <!-- Telafi katmanı: kaplamanın render dönüşümünü TERS yönde geri alır, şeritler yerinde kalır. -->
          <Canvas Width="286" Height="286" ClipToBounds="False">
            <Canvas.RenderTransform><TranslateTransform x:Name="SweepCounterShift"/></Canvas.RenderTransform>

            <!-- Gölge KIRPMADAN ÖNCE hesaplansın diye ayrı katman: Clip ile Effect aynı öğeye konursa
                 süpürme kenarında bir gölge çizgisi oluşur. -->
            <Canvas Width="286" Height="286" ClipToBounds="False">
              <Canvas.Effect>
                <!-- Opaklık 0.30: zemin YOK (masaüstü ne olursa olsun şeritler seçilebilmeli). Kaynak SVG'de
                     siyah bir tile üzerine 0.92 idi. -->
                <DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="4.8" Color="Black" Opacity="0.30"/>
              </Canvas.Effect>

              <Path x:Name="StripTopDarkRect" Data="{DynamicResource Brand.Pill.TopDark}"
                    Fill="{DynamicResource Brush.Brand.StripDim}">
                <Path.RenderTransform><TranslateTransform x:Name="TopDarkShift"/></Path.RenderTransform>
              </Path>

              <Path x:Name="StripAmberRect" Data="{DynamicResource Brand.Pill.Amber}"
                    Fill="{DynamicResource Brush.Amber}">
                <Path.RenderTransform><TranslateTransform x:Name="AmberShift"/></Path.RenderTransform>
              </Path>

              <Path x:Name="StripMidDarkRect" Data="{DynamicResource Brand.Pill.MidDark}"
                    Fill="{DynamicResource Brush.Neutral700}">
                <Path.RenderTransform><TranslateTransform x:Name="MidDarkShift"/></Path.RenderTransform>
              </Path>

              <Path x:Name="StripWhiteRect" Data="{DynamicResource Brand.Pill.White}"
                    Fill="{DynamicResource Brush.TextPrimary}">
                <Path.RenderTransform><TranslateTransform x:Name="WhiteShift"/></Path.RenderTransform>
              </Path>

              <Path x:Name="StripSilverRect" Data="{DynamicResource Brand.Pill.Silver}"
                    Fill="{DynamicResource Brush.TextSecondary}">
                <Path.RenderTransform><TranslateTransform x:Name="SilverShift"/></Path.RenderTransform>
              </Path>
            </Canvas>
          </Canvas>
        </Canvas>

        <!-- Amber şevron — kırpmanın DIŞINDA: şeritleri o siliyor. -->
        <Path x:Name="Chevron" Data="{DynamicResource Brand.Chevron}" Fill="{DynamicResource Brush.Brand.Chevron}">
          <Path.RenderTransform>
            <TranslateTransform x:Name="ChevronShift"/>
          </Path.RenderTransform>
          <Path.Effect>
            <DropShadowEffect ShadowDepth="2.6" Direction="270" BlurRadius="5.6" Color="Black" Opacity="0.32"/>
          </Path.Effect>
        </Path>

      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
