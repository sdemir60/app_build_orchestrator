<UserControl x:Class="BuildOrchestrator.App.Controls.LatestPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
             Focusable="False" IsHitTestVisible="True"
             Visibility="Collapsed">
  <!-- [T59] `⌄ latest` pill (design-v1 §2.5/§2.6 + Ek A-15) — panel alt-ortasında; bg surface-overlay,
       border-strong, radius-md (=overlay 8), popover gölgesi. Hover'da yüzey/metin bir adım açılır
       (surface-overlay→surface-raised, text-secondary→text-primary). Host (ConsoleView vb.) Visibility'yi
       BottomAnchorBehavior.ShowPill'e bağlar; Click → JumpToBottom (bkz. LatestPill.xaml.cs). -->
  <Button x:Name="PillButton" Click="OnClick" Cursor="Hand" Focusable="False"
          Padding="0" BorderThickness="0" Background="Transparent">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <!-- DynamicResource (StaticResource DEĞİL): headless test host'ta (Application/merged Tokens.xaml yok)
             DynamicResource sessizce çözümsüz kalır — StaticResource ise ApplyTemplate anında throw ederdi. -->
        <Border x:Name="Root" CornerRadius="{DynamicResource Radius.Overlay}"
                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                Effect="{DynamicResource Effect.PopoverShadow}"
                Padding="7,0,9,0" Height="22">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- [T64] Chevron ⌄ Geist Mono'da YOK: CompositeFont (Geist Mono Console) kullanılır — FamilyMap'i
                 sembolü Segoe UI Symbol'e düşürür (düz Mono bu eşlemeyi baypas eder → tofu riski). -->
            <TextBlock x:Name="Glyph" Text="&#x2304;" FontFamily="{x:Static controls:AppFonts.MonoConsole}" FontSize="11"
                       Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock x:Name="Label" Text="latest" FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Button.Template>
  </Button>
</UserControl>
