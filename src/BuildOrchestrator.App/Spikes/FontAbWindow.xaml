<Window x:Class="BuildOrchestrator.App.Spikes.FontAbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T65 — Font A/B (Geist / Geist Mono · Display|Ideal × ClearType|Grayscale)"
        Width="1500" Height="920"
        Background="{DynamicResource Brush.SurfaceBase}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!-- [T65/K9] Karar-kapısı spike penceresi: aynı design-v1 metin örnekleri 4 kombinasyonda yan yana.
         Örnek içerik code-behind'da tek yerden üretilir (4x XAML kopyası yerine). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Root" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        </Grid>
    </ScrollViewer>
</Window>
