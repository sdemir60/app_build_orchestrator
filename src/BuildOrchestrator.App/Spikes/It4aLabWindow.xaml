<Window x:Class="BuildOrchestrator.App.Spikes.It4aLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
        xmlns:appConsole="clr-namespace:BuildOrchestrator.App.Console"
        Title="It-4a Lab — UI primitifleri (dev-only)"
        Width="1400" Height="900"
        Background="{StaticResource Brush.SurfaceBase}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        WindowStartupLocation="CenterScreen">
    <!-- [It-4a Foundation] Dev-only lab kabuğu (it4a-lab bayrağı). [T56/3a] Konsol demo paneli: colorizer + hibrit
         typewriter + anlatı/proje-log mod geçişi + boş-durum metinleri gözle doğrulanır (prototiple yan yana). -->
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Height="28" Margin="0,0,0,12"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <controls:TrackedTextBlock Text="PROJECTS" VerticalAlignment="Center" />
                <Border Width="16" />
                <controls:TrackedTextBlock Text="EVENT STREAM" VerticalAlignment="Center" />
                <Border Width="16" />
                <controls:TrackedTextBlock Text="DEPENDENCY GRAPH" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- [T56/3a] Demo tetikleyicileri -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Console (T56 / 3a+3b)" Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="12" Margin="0,0,0,8" />
                <Button Content="Seed narrative (colorized)" Margin="0,0,0,6" Click="OnSeedNarrative" />
                <Button Content="Type active line (typewriter)" Margin="0,0,0,6" Click="OnTypeLine" />
                <Button Content="Project-log · Building (cascade + ▮)" Margin="0,0,0,6" Click="OnProjectLogBuilding" />
                <Button Content="Project-log · Failed + depIssue (cascade)" Margin="0,0,0,6" Click="OnProjectLogFailed" />
                <Button Content="Project-log · Skipped (empty)" Margin="0,0,0,6" Click="OnProjectLogSkipped" />
                <Button Content="Project-log · Queued (empty)" Margin="0,0,0,6" Click="OnProjectLogQueued" />
                <Button Content="Back to narrative" Margin="0,0,0,6" Click="OnBackToNarrative" />
                <TextBlock Text="Reduced-motion OS ayarında typewriter + kaskat INSTANT olmalı (blink/fade yok). Copy-log butonu başlıkta."
                           Foreground="{StaticResource Brush.TextFaint}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>

            <DockPanel Grid.Column="1">
                <appConsole:ConsoleHeader x:Name="LabHeader" DockPanel.Dock="Top" Margin="0,0,0,6" />
                <appConsole:ConsoleView x:Name="LabConsole" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
