<Window x:Class="BuildOrchestrator.App.Spikes.It4aLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
        Title="It-4a Lab — UI primitifleri (dev-only)"
        Width="1400" Height="900"
        Background="{StaticResource Brush.SurfaceBase}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        WindowStartupLocation="CenterScreen">
    <!-- [It-4a Foundation] Dev-only lab kabuğu (it4a-lab bayrağı, FontAbWindow deseni): DI/EngineHost
         kurulmaz, Supervisor spawn edilmez. T58/T59/T63 primitifleri sonraki task'larda buraya, temsili
         veriyle (Spikes/SampleGraphData.cs) eklenecek — bu task yalnız boş iskeleti + Foundation
         kaynaklarının (Motion.xaml/Tokens.xaml) burada da geçerli olduğunu gösteren bir yer tutucu ekler. -->
    <DockPanel Margin="16">
        <!-- [T57] TrackedTextBlock gözle doğrulama: panel başlığı şeridi (28px, design-v1 §PanelHead) —
             11px/500/0.07em/uppercase/text-faint caps etiketler, prototipteki panel başlıklarıyla
             yan yana karşılaştırılır. VerticalAlignment=Center ile dikey ortalama (feasibility §3.1:
             tek satırda LineHeight kullanılmaz). -->
        <Border DockPanel.Dock="Top" Height="28" Margin="0,0,0,12"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <controls:TrackedTextBlock Text="PROJECTS" VerticalAlignment="Center" />
                <Border Width="16" />
                <controls:TrackedTextBlock Text="EVENT STREAM" VerticalAlignment="Center" />
                <Border Width="16" />
                <controls:TrackedTextBlock Text="DEPENDENCY GRAPH" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Background="{StaticResource Brush.Surface}" CornerRadius="4">
            <TextBlock Text="It-4a Lab — kalan primitifler burada eklenecek (T58/T59/T63)"
                       Foreground="{StaticResource Brush.TextFaint}"
                       FontSize="13" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </DockPanel>
</Window>
