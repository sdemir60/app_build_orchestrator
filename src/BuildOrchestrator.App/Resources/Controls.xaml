  </Style>

  <!--
    Dialog: _ds_bundle.js:963-968 — 1px border-strong, radius-lg, overlay gölgesi.
    SAPMA (T60 brief'inde KAYITLI): zemin CSS `surface-raised` degiskenitır (_ds_bundle.js:965) — README §2.9
    "surface-overlay" der; KOD KAZANIR.
  -->
  <Style x:Key="Ds.Dialog" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
    <Setter Property="Effect" Value="{DynamicResource Effect.OverlayShadow}" />
    <Setter Property="TextElement.FontFamily" Value="{x:Static controls:AppFonts.Ui}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- ======================================= TOOLTIP ======================================= -->
  <!--
    [T61] _ds_bundle.js:1285-1348 (Tooltip.jsx) — surface-overlay zemin (:1331), 1px border-strong (:1332),
    radius-sm (:1333), elevation-popover gölge (:1334), padding '4px 8px' (:1335 — bileşenin KENDİ ölçüsü,
    token değil, kaynak satırıyla yazılır), font-sans/text-xs (:1337-1338).

    SAPMA (kayıtlı, task-B4-brief.md:41 harfiyen): gövde metni brief'in pinlediği Brush.TextSecondary'dir;
    kaynakta (:1339) text-primary'dir — yalnız kbd alt-metni (:1345) text-dim'dir. Brief TARTIŞMASIZ kazanır.

    A13.2 (feasibility otoritesi, harfiyen): WPF'in PlacementMode.Top/Bottom'u hedefi SOLA hizalar, ORTALAMAZ
    → Placement=Custom + CustomPopupPlacementCallback ZORUNLU (bkz. Controls/AppTooltip.cs). Tooltip AYRI bir
    HWND'dir — bu yüzden T65'in kök ClearTypeHint'i (Grayscale, MainWindow.xaml — BURADA DOKUNULMAZ) buraya
    sızmaz; yerel olarak BİLİNÇLİ şekilde ClearType'a döndürülür.

    ShowDuration int.MaxValue'ya (sonsuz) ayarlanır — DS'in web karşılığında `open` React state'i mouse
    ayrılana kadar sürer; WPF'in ~5sn varsayılan ShowDuration'ı bunu keserdi.

    Side: controls:AppTooltip.Side, DsChrome.Prefix'in TextBox üzerinde KENDİ KENDİNİ tetiklediği desenin
    AYNISIYLA, EXPLICIT bir <ToolTip> öğesinin KENDİSİNDE ilan edilir — otomatik sarılan düz-metin tooltip'ler
    (Side verilmemiş) varsayılan Top kalır.

    Bu stil bir ControlTemplate.Triggers/Storyboard TAŞIMAZ (Step 1 kararı, T60) — burada zaten animasyon
    istenmiyor (brief).
  -->
  <!-- [quiet] Grafın EKRAN KOORDİNATLI hover tooltip'i (design v1.3.0 §2.3). Native ToolTip DEĞİL: konumu
       §2.3'ün 8px/6px kuralına uyar ve kamera transform'unun dışındaki bir overlay Canvas'ında yaşar
       (GraphView.xaml). Görünüm sözlüğü kardeş ToolTip stiliyle AYNI token'lardan okur; burada yaşar ki
       panel dosyaları gölge taşımasın (AntiSlopTests.Only_floating_overlays_carry_a_drop_shadow) — bu bir
       FLOATING OVERLAY'dir, panelin kendisi değil. -->
  <Style x:Key="Ds.GraphOverlayTooltip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Effect" Value="{DynamicResource Effect.PopoverShadow}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{x:Static controls:AppFonts.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Xs}" />
    <!-- _ds_bundle.js:1335 `padding: '4px 8px'` → WPF Thickness(left,top,right,bottom). -->
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Effect" Value="{DynamicResource Effect.PopoverShadow}" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
    <!-- int.MaxValue — "sonsuz" (fare ayrılana kadar açık kalır). -->
    <Setter Property="ToolTipService.ShowDuration" Value="2147483647" />
    <Setter Property="Placement" Value="Custom" />
    <Setter Property="CustomPopupPlacementCallback" Value="{x:Static controls:AppTooltip.PlacementTop}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <!-- ToolTip'in kendi CornerRadius'u YOKTUR (Control'ün bir parçası değil) — Radius.Sm bu yüzden
               TemplateBinding değil, doğrudan token ile yazılır (SplitButton'ın DEĞİŞKEN köşe ihtiyacı
               burada yok, tek sabit değer — DsChrome.CornerRadius makinesi burada GEREKSİZ, YAGNI). -->
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Radius.Sm}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <!-- Varsayılan ContentSource="Content" — Content/ContentTemplate/ContentStringFormat
                 TemplatedParent'tan OLDUĞU GİBİ akar; canlı bağlı içerik (`Building — 24s`, `Copy → Copied`)
                 burada ENGELLENMEZ. -->
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="controls:AppTooltip.Side" Value="Bottom">
        <Setter Property="CustomPopupPlacementCallback" Value="{x:Static controls:AppTooltip.PlacementBottom}" />
      </Trigger>
      <Trigger Property="controls:AppTooltip.Side" Value="Left">
        <Setter Property="CustomPopupPlacementCallback" Value="{x:Static controls:AppTooltip.PlacementLeft}" />
      </Trigger>
      <Trigger Property="controls:AppTooltip.Side" Value="Right">
        <Setter Property="CustomPopupPlacementCallback" Value="{x:Static controls:AppTooltip.PlacementRight}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ====================================== SCROLLBAR ====================================== -->
  <!--
    BuildApp.jsx:35-38 `.bo-scroll` — tasarımın scrollbar sözleşmesi: 10px ray, track TRANSPARENT, thumb
    neutral-700 + 3px şeffaf kenar (background-clip: padding-box) + dış radius 5. WPF eşlemesi: ray 10px →
    ScrollBar Width/Height=10; thumb'ın GÖRÜNEN hap'ı = Border Margin=3 (3px kenar) + CornerRadius=2
    (dış 5 − kenar 3 = padding-box yarıçapı) + Brush.Neutral700 zemin → 4px'lik hap.
    Tüketiciler (prototip): proje listesi :476 · console :615 · event stream :704 · branch popover :839 —
    yani UYGULAMA GENELİ implicit stil doğru kapsamdır; README:14 scrollbar'ı "en yakın native karşılık"
    istisnasına açıkça devreder.
    Ok butonları YOK: webkit scrollbar'ında buton çizilmez (:36-38 yalnız track+thumb tanımlar) — ray'ın
    boş alanı sayfa-atlama davranışını korur (şeffaf RepeatButton'lar). Hover/drag: prototip tek renklidir;
    native etkileşim geri bildirimi README:14 gereği korunur — rampada BİR adım açık (Brush.Neutral600),
    Brush.SurfaceHover'ın "bir üst adım" desenine paralel; geçiş A13.2 gereği DsTransition ile. Amber DEĞİL:
    renk yalnız STATÜ taşır.
  -->

  <!-- ScrollViewer default şablonunun köşe karesi (Corner): SystemColors.ControlBrushKey'i DynamicResource
       ile okur (açık-tema grisi #f0f0f0) — iki bar'ın kesiştiği köşede koyu kabuğun ortasında parlardı.
       App kapsamında şeffaflaştırılır. DsSplitter ETKİLENMEZ (ctor'da explicit Background=Transparent,
       DsSplitter.cs:50); uygulamada başka native ControlBrush tüketicisi yoktur. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />

  <!-- Ray'ın boş alanı: görünmez ama hit-test alır (sayfa atlama). Background=Transparent (null DEĞİL) bu
       yüzden zorunludur. -->
  <Style x:Key="Ds.ScrollBar.PageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thumb: hover/drag geçişi A13.2 kuralıyla (DsTransition.AnimatedBackground → şablon TemplateBinding
       ile okur; ListBoxItem'daki desenin aynısı). -->
  <Style x:Key="Ds.ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="controls:DsTransition.AnimatedBackground" Value="{DynamicResource Brush.Neutral700}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- BuildApp.jsx:38 — Margin 3 = 3px şeffaf kenar; CornerRadius 2 = dış 5 − kenar 3. -->
          <Border Background="{TemplateBinding Background}" Margin="3" CornerRadius="2"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="controls:DsTransition.AnimatedBackground" Value="{DynamicResource Brush.Neutral600}" />
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
        <Setter Property="controls:DsTransition.AnimatedBackground" Value="{DynamicResource Brush.Neutral600}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate x:Key="Ds.ScrollBar.Vertical.Template" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource Ds.ScrollBar.PageButton}" Command="ScrollBar.PageUpCommand" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource Ds.ScrollBar.PageButton}" Command="ScrollBar.PageDownCommand" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource Ds.ScrollBar.Thumb}" />
        </Track.Thumb>
      </Track>
    </Grid>
    <ControlTemplate.Triggers>
      <!-- Kaydıracak şey yokken boş koyu hap kalıntısı görünmesin (restraint). -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="Ds.ScrollBar.Horizontal.Template" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource Ds.ScrollBar.PageButton}" Command="ScrollBar.PageLeftCommand" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource Ds.ScrollBar.PageButton}" Command="ScrollBar.PageRightCommand" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource Ds.ScrollBar.Thumb}" />
        </Track.Thumb>
      </Track>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Implicit: ScrollBar bir Control türevidir → bu stil ŞABLON SINIRLARINI geçer ve uygulamadaki HER
       scrollbar'a (StickyLayerList/EventStream ScrollViewer'ları, AvalonEdit console editor'ünün iç
       ScrollViewer'ı, popover/dialog ListBox'ları) kendiliğinden uygulanır — panel XAML'lerine dokunulmaz.
       Explicit stil verilmiş bir bar olursa implicit'i tamamen ezer. -->
  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template" Value="{StaticResource Ds.ScrollBar.Vertical.Template}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template" Value="{StaticResource Ds.ScrollBar.Horizontal.Template}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ========================= ÖZEL KONTROLLERİN VARSAYILAN ŞABLONLARI ========================= -->
  <!-- Anahtar `{x:Type …}`: DefaultStyleKey ile aranan implicit style'dır. Themes/Generic.xaml'e GEREK YOK —
       uygulama kaynakları tema sözlüğünden ÖNCE taranır. -->

  <Style x:Key="{x:Type controls:BuildingSpinner}" TargetType="controls:BuildingSpinner">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:BuildingSpinner">
          <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Stretch="Uniform">
            <Canvas Width="16" Height="16">
              <Path Data="{DynamicResource Icon.Spinner}"
                    StrokeThickness="{DynamicResource Icon.Spinner.StrokeThickness}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.RenderTransform>
                  <!-- _ds_bundle.js:1359 `transform-origin: center` — 16'lık kutunun merkezi. -->
                  <RotateTransform x:Name="PART_Rotation" CenterX="8" CenterY="8" />
                </Path.RenderTransform>
              </Path>
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type controls:StatusGlyph}" TargetType="controls:StatusGlyph">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:StatusGlyph">
          <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
            <!-- Geometriler 16'lık viewBox'tadır; Viewbox ölçekleyince stroke da birlikte küçülür. -->
            <Viewbox Stretch="Uniform">
              <Canvas Width="16" Height="16">
                <Path x:Name="PART_Ring" />
                <Path x:Name="PART_Inner" />
              </Canvas>
            </Viewbox>
            <controls:BuildingSpinner x:Name="PART_Spinner" Size="{TemplateBinding Size}"
                                      Foreground="{TemplateBinding Foreground}" Visibility="Collapsed" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type controls:WillBuildDot}" TargetType="controls:WillBuildDot">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:WillBuildDot">
          <!-- spacing.css dot-size:8px → Tokens.xaml `Size.DotSize`; halka 1px (colors.css:41). -->
          <Ellipse x:Name="PART_Dot"
                   Width="{DynamicResource Size.DotSize}" Height="{DynamicResource Size.DotSize}"
                   StrokeThickness="1" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type controls:SplitButton}" TargetType="controls:SplitButton"
         BasedOn="{StaticResource Ds.SplitButton}" />

  <!-- ================================ VARSAYILAN (IMPLICIT) ================================ -->
  <!--
    Buraya kadar uygulamada tek bir implicit style yoktu: stil VERİLMEMİŞ her Button/TextBox/ListBox WPF'in
    AÇIK-TEMA chrome'uyla (beyaz zemin, mavi odak) çiziliyordu — koyu kabuğun ortasında. Aşağıdakiler bunu
    kapatır. Açıkça `Style` verilmiş öğeler (MainWindow'un CaptionButton'ı, LatestPill'in kendi şablonlu
    butonu) ETKİLENMEZ — explicit style implicit'i tamamen ezer.
  -->
  <Style TargetType="Button" BasedOn="{StaticResource Ds.Button.Secondary.Md}" />
  <Style TargetType="TextBox" BasedOn="{StaticResource Ds.Input}" />

  <!--
    ListBox/ListBoxItem: DS'in gerçek satırı `ProjectRow`dur (_ds_bundle.js:1880+) ve D FAZININ işidir.
    Burada YALNIZCA WPF'in açık tema chrome'u token'larla nötrlenir — uydurma bir satır tasarımı YOK.
    Sanallaştırma A13.2 gereği KAPALI.
  -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{x:Static controls:AppFonts.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Ds.FocusVisual}" />
    <Setter Property="controls:DsTransition.AnimatedBackground" Value="Transparent" />
    <Setter Property="controls:DsTransition.AnimatedForeground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="controls:DsTransition.AnimatedBackground" Value="{DynamicResource Brush.SurfaceHover}" />
        <Setter Property="controls:DsTransition.AnimatedForeground" Value="{DynamicResource Brush.TextPrimary}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="controls:DsTransition.AnimatedBackground" Value="{DynamicResource Brush.AmberSoft}" />
        <Setter Property="controls:DsTransition.AnimatedForeground" Value="{DynamicResource Brush.TextPrimary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
