<UserControl x:Class="BuildOrchestrator.App.Graph.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels">
  <!-- [quiet] design v1.3.0 §2.3 dependency graph paneli. Düğüm görselleri kod tarafında
       (GraphView.xaml.cs) kurulur — testler doğrudan referans alabilsin ve statü değişiminde şablon
       yeniden kurulmasın diye. Burada yalnız panel kabuğu vardır. -->
  <DockPanel>
    <!-- Panel başlığı: 28px, surface, altta border-subtle; caps etiket + sağda mono sayaç.
         [A13/T3 fix-1 · C3] Yükseklik token'a CANLI bağlıdır (çıplak 28 literali DEĞİL — token kaysa
         başlık 28'de kalırdı). Kardeş panel başlıkları (Controls.PanelHeader) aynı token'ı okur. -->
    <Border DockPanel.Dock="Top" Height="{DynamicResource Size.PanelHeaderHeight}"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,0" LastChildFill="True">
        <!-- design-v1 §1.2: sayaç MAKİNE ÇIKTISIDIR → gömülü Geist Mono (sistem Consolas'ı DEĞİL). -->
        <TextBlock x:Name="CountsText" DockPanel.Dock="Right" VerticalAlignment="Center"
                   FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                   Foreground="{DynamicResource Brush.TextFaint}" />

        <controls:TrackedTextBlock x:Name="CaptionText" Text="DEPENDENCY GRAPH" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Zemin: surface-base, taşan graf kırpılır; boş alana tıklama seçimi kaldırır -->
    <Grid x:Name="Ground" ClipToBounds="True" Background="{DynamicResource Brush.SurfaceBase}">
      <!-- Dış Canvas ölçüde (0,0) bildirir: dünya, panelin istenen boyutunu ŞİŞİRMEZ. -->
      <Canvas x:Name="Viewport">
        <Canvas x:Name="World" />
      </Canvas>

      <!-- [quiet] §2.3: hover tooltip'i ve seçim ad etiketi EKRAN koordinatındadır. Kamera transform'unun
           ALTINDA yaşasalardı 5× zoom'da metin de 5× ölçeklenip bulanıklaşırdı — bu Canvas World'ün
           KARDEŞİDİR ve hiçbir RenderTransform taşımaz. İkisi de TEK, yeniden kullanılan birer öğedir;
           düğüm başına nesne kurulmaz. -->
      <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
        <Border x:Name="TooltipBox" Visibility="Collapsed"
                Style="{DynamicResource Ds.GraphOverlayTooltip}">
          <TextBlock x:Name="TooltipText"
                     FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="11"
                     Foreground="{DynamicResource Brush.TextPrimary}" />
        </Border>
      </Canvas>

      <!-- Sync öncesi boş durum: kesikli çerçeveli kutu (WPF Border dashed desteklemez → Rectangle) -->
      <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Rectangle Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"
                   StrokeDashArray="3 3" RadiusX="6" RadiusY="6" />
        <TextBlock x:Name="EmptyStateLabel" Text="{x:Static vm:InteractionText.GraphEmpty}" Margin="26,18"
                   FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
