<UserControl x:Class="BuildOrchestrator.App.Graph.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls">
  <!-- [T63] design-v1 §2.3 dependency graph paneli (Shapes yolu). Düğüm/kenar/rozet görselleri kod tarafında
       (GraphView.xaml.cs) kurulur — testler doğrudan referans alabilsin ve statü değişiminde şablon yeniden
       kurulmasın diye. Burada yalnız panel kabuğu vardır. -->
  <DockPanel>
    <!-- Panel başlığı: 28px, surface, altta border-subtle; caps etiket + sağda mono sayaç -->
    <Border DockPanel.Dock="Top" Height="28"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,0" LastChildFill="True">
        <TextBlock x:Name="CountsText" DockPanel.Dock="Right" VerticalAlignment="Center"
                   FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" />
        <controls:TrackedTextBlock Text="DEPENDENCY GRAPH" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Zemin: surface-base, taşan graf kırpılır; boş alana tıklama seçimi kaldırır -->
    <Grid x:Name="Ground" ClipToBounds="True" Background="{DynamicResource Brush.SurfaceBase}">
      <!-- Dış Canvas ölçüde (0,0) bildirir: 880×H'lik dünya, panelin istenen boyutunu ŞİŞİRMEZ. -->
      <Canvas x:Name="Viewport">
        <Canvas x:Name="World" />
      </Canvas>

      <!-- Sync öncesi boş durum: kesikli çerçeveli kutu (WPF Border dashed desteklemez → Rectangle) -->
      <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Rectangle Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"
                   StrokeDashArray="3 3" RadiusX="6" RadiusY="6" />
        <TextBlock x:Name="EmptyStateLabel" Text="Graph appears after Sync" Margin="26,18"
                   FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
