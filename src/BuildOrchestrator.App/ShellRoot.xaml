<UserControl x:Class="BuildOrchestrator.App.ShellRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
             xmlns:appConsole="clr-namespace:BuildOrchestrator.App.Console"
             xmlns:graph="clr-namespace:BuildOrchestrator.App.Graph"
             xmlns:views="clr-namespace:BuildOrchestrator.App.Views"
             xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels">
  <!--
    [T35] Pencere GÖVDESİ (design-v1 kök yerleşimi). Pencere kabuğu (WindowChrome/DWM/tray/hotkey/title bar
    + caption butonları) MainWindow'dadır; burada test edilebilir LAYOUT vardır. Kök grid = ribbon · gövde ·
    action bar (title bar 40px MainWindow'un satırıdır). Ölçü/renk token'dan (hardcode YASAK), cross-file
    kaynaklar DynamicResource (Controls.xaml sözleşmesi — headless yüklemede StaticResource patlardı).
  -->
  <Grid Background="{DynamicResource Brush.SurfaceBase}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />                                    <!-- sticky şerit + 2px progress (T37) -->
      <RowDefinition Height="*" />                                       <!-- gövde: 2×2 -->
      <RowDefinition Height="Auto" />                                   <!-- action bar (yüksekliği kontrolden: Size.ActionBarHeight=42) -->
    </Grid.RowDefinitions>

    <!-- [D2/T37-T39] Ribbon bölgesi: sticky durum şeridi + 2px global progress. DataContext (RunViewModel)
         MainWindow → ShellRoot → buraya miras kalır. -->
    <views:StickyRibbon x:Name="PART_Ribbon" Grid.Row="0" />

    <!-- ==================================== GÖVDE (2×2) ==================================== -->
    <Grid x:Name="Body" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="50*" />
        <ColumnDefinition Width="Auto" />        <!-- dikey ayraç kolonu -->
        <ColumnDefinition x:Name="RightColumn" Width="50*" />
      </Grid.ColumnDefinitions>

      <!-- ===== SOL KOLON: graf / yatay ayraç / proje listesi ===== -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="GraphRow" Height="50*" />
          <RowDefinition x:Name="LeftSplitterRow" Height="Auto" />
          <RowDefinition x:Name="ProjectsRow" Height="50*" />
        </Grid.RowDefinitions>

        <graph:GraphView x:Name="PART_Graph" Grid.Row="0" />

        <controls:DsSplitter x:Name="PART_LeftSplitter" Grid.Row="1" LineOrientation="Horizontal" />

        <!-- Projects paneli: PanelHeader + StickyLayerList + LatestPill (aynı Grid'de üst üste) -->
        <DockPanel Grid.Row="2">
          <controls:PanelHeader x:Name="PART_ProjectsHeader" DockPanel.Dock="Top" Text="PROJECTS">
            <controls:PanelHeader.LeftContent>
              <!-- [A13/T2 · 2.3] mono `build-order` etiketi + (aktif filtre varsa) kaldırılabilir chip
                   (design-v1 §2.4, BuildApp.jsx:1490-1493). Chip KOD-TARAFI kurulur: LeftContent bir
                   alt-namescope'tur, buraya x:Name/handler YAZILAMAZ (MC3093 — RightContent'teki filtre
                   TextBox'ıyla AYNI kısıt). Bkz. ShellRoot ctor. -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="build-order" VerticalAlignment="Center"
                           FontFamily="{x:Static controls:AppFonts.Mono}"
                           FontSize="{DynamicResource FontSize.2xs}"
                           Foreground="{DynamicResource Brush.TextFaint}" />
              </StackPanel>
            </controls:PanelHeader.LeftContent>
            <controls:PanelHeader.RightContent>
              <!-- Ds.Input.Sm (28px şeride sığması için sm ölçü) + büyüteç prefix (paddingLeft 26) + watermark.
                   [E5/T46] Ctrl+F bunu odaklar (MainWindow → Shell.FocusProjectFilter); içindeki Esc yalnız
                   sorguyu temizler + blur eder (OnFilterKeyDown, handled) — global Esc zincirine SIZMAZ. Text
                   iki-yönlü ProjectQuery'ye bağlı (filtre kaynağı — VisibleProjects bunu okur). PanelHeader.
                   RightContent bir alt-namescope olduğundan buraya x:Name/handler XAML'de YAZILAMAZ (MC3093) →
                   referans + PreviewKeyDown kod-tarafı bağlanır (ShellRoot ctor), erişim RightContent üzerinden. -->
              <TextBox Width="160" Style="{DynamicResource Ds.Input.Sm}" controls:DsChrome.Watermark="Filter…"
                       Text="{Binding ProjectQuery, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Filter projects">
                <controls:DsChrome.Prefix>
                  <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                      <Path Data="{DynamicResource Icon.Search}"
                            StrokeThickness="{DynamicResource Icon.Search.StrokeThickness}"
                            Stroke="{DynamicResource Brush.TextDim}"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                  </Viewbox>
                </controls:DsChrome.Prefix>
              </TextBox>
            </controls:PanelHeader.RightContent>
          </controls:PanelHeader>
          <Grid>
            <controls:StickyLayerList x:Name="PART_Projects" />

            <!-- [design v1.8.0 §2.4 · v1.10.0] FIRST RUN kurulum daveti (liste üstünde overlay; görünürlük
                 MainWindow'da ListInvite.Resolve ile). Metinler tek kaynaktan (InteractionText, x:Static) —
                 verbatim.
                 [DEĞİŞEN KURAL] Davet eskiden tek bir klasör seçiciye açılıyordu ("Pick a repository to get
                 started" + `Choose Folder`); v1.8.0 onu Settings'e yönlendirmeye çevirdi ve araya bir KURULUM
                 LİSTESİ koydu (Repository root → Not set · Layers → N defined/Optional), çünkü başlamak için
                 gereken ayar sayısı arttı. v1.10.0 ikinci bir düğme ekledi: `Import settings…`. -->
            <StackPanel x:Name="PART_ListInvite" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="292" Margin="24">
              <TextBlock Text="{x:Static vm:InteractionText.ConfigureWorkspaceTitle}"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSize.Sm}" FontWeight="{DynamicResource FontWeight.Emphasis}"
                         Foreground="{DynamicResource Brush.TextPrimary}" />
              <TextBlock Text="{x:Static vm:InteractionText.ConfigureWorkspaceSubtitle}" Margin="0,8,0,0"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSize.Xs}" Foreground="{DynamicResource Brush.TextFaint}" />

              <!-- Kurulum listesi: 292px kart, surface zemin + 1px border + radius-md; 30px satırlar,
                   aralarında border-subtle. Değerler mono (SetupRootValue/SetupLayersValue kod-tarafı). -->
              <Border Margin="0,14,0,0" Padding="0" CornerRadius="{DynamicResource Radius.Md}"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                  <DockPanel Height="30" Margin="10,0">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Text="{x:Static vm:InteractionText.SetupRepositoryRootLabel}"
                               FontSize="{DynamicResource FontSize.Xs}"
                               Foreground="{DynamicResource Brush.TextDim}" />
                    <TextBlock x:Name="PART_SetupRootValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               FontFamily="{x:Static controls:AppFonts.Mono}"
                               FontSize="{DynamicResource FontSize.Xs}"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                  </DockPanel>
                  <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}" />
                  <DockPanel Height="30" Margin="10,0">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Text="{x:Static vm:InteractionText.SetupLayersLabel}"
                               FontSize="{DynamicResource FontSize.Xs}"
                               Foreground="{DynamicResource Brush.TextDim}" />
                    <TextBlock x:Name="PART_SetupLayersValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               FontFamily="{x:Static controls:AppFonts.Mono}"
                               FontSize="{DynamicResource FontSize.Xs}"
                               Foreground="{DynamicResource Brush.TextFaint}" />
                  </DockPanel>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Center">
                <Button x:Name="PART_OpenSettings" Style="{DynamicResource Ds.Button.Primary.Md}"
                        AutomationProperties.Name="{x:Static vm:InteractionText.OpenSettingsButton}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                      <Canvas Width="24" Height="24">
                        <Path Data="{DynamicResource Icon.Gear}"
                              StrokeThickness="{DynamicResource Icon.Gear.StrokeThickness}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{x:Static vm:InteractionText.OpenSettingsButton}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="PART_ImportSettings" Margin="8,0,0,0"
                        Style="{DynamicResource Ds.Button.Secondary.Md}"
                        AutomationProperties.Name="{x:Static vm:InteractionText.ImportSettingsButton}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                      <Canvas Width="24" Height="24">
                        <Path Data="{DynamicResource Icon.Upload}"
                              StrokeThickness="{DynamicResource Icon.Upload.StrokeThickness}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{x:Static vm:InteractionText.ImportSettingsButton}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <TextBlock Text="{x:Static vm:InteractionText.ImportSettingsNote}" Margin="0,8,0,0"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSize.2xs}"
                         Foreground="{DynamicResource Brush.TextFaint}" />
            </StackPanel>

            <TextBlock x:Name="PART_NoProjects" Text="{x:Static vm:InteractionText.NoProjectsFound}"
                       Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                       FontSize="{DynamicResource FontSize.Xs}" Foreground="{DynamicResource Brush.TextFaint}" />

            <!-- [A13/T2 · 2.4] Projeler VAR ama filtre hiçbirini eşleştirmiyor (design-v1 §2.4,
                 BuildApp.jsx:511). "Hiç proje yok"tan (PART_NoProjects) AYRI bir durumdur ve prototipteki gibi
                 listenin ÜST-SOLUNDA, 20px dolguyla, text-xs/text-dim durur — ortalanmış boş-durum daveti
                 DEĞİL (o, veri yokluğunun dilidir). -->
            <TextBlock x:Name="PART_NoFilterMatch" Text="{x:Static vm:InteractionText.NoProjectsMatchFilter}"
                       Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Xs}" Foreground="{DynamicResource Brush.TextDim}" />

            <controls:LatestPill x:Name="PART_ProjectsPill" Visibility="Collapsed" />
          </Grid>
        </DockPanel>
      </Grid>

      <!-- ===== DİKEY AYRAÇ (kolon) ===== -->
      <controls:DsSplitter x:Name="PART_ColumnSplitter" Grid.Column="1" LineOrientation="Vertical" />

      <!-- ===== SAĞ KOLON: konsol / yatay ayraç / event stream ===== -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="ConsoleRow" Height="50*" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="StreamRow" Height="50*" />
        </Grid.RowDefinitions>

        <!-- Konsol paneli: ConsoleHeader (kendi başlığı) + ConsoleView (kendi pill'i var — ikinci pill YOK) -->
        <DockPanel Grid.Row="0">
          <appConsole:ConsoleHeader x:Name="PART_ConsoleHeader" DockPanel.Dock="Top" />
          <appConsole:ConsoleView x:Name="PART_ConsoleView" />
        </DockPanel>

        <controls:DsSplitter x:Name="PART_RightSplitter" Grid.Row="1" LineOrientation="Horizontal" />

        <!-- [D3] Event stream paneli: PanelHead ("{n} events") + tampon (render dilimi 150) + aktif satır + pill. -->
        <views:EventStreamView x:Name="PART_EventStream" Grid.Row="2" />
      </Grid>
    </Grid>

    <!-- ==================================== ACTION BAR (42px) ==================================== -->
    <!-- [D6/T40] Sync · sayaç chip'leri · branch/worktree popover'ları · Debug|Release · perf · Build split-button.
         DataContext (RunViewModel) MainWindow → ShellRoot → buraya miras kalır. -->
    <!-- Yükseklik token'dan KONTROLDE verilir (FrameworkElement.Height = Double → geçerli DynamicResource;
         PanelHeader.xaml deseni). RowDefinition.Height (GridLength) bir Double token'ı ALAMAZDI → satır Auto. -->
    <views:ActionBar x:Name="PART_ActionBar" Grid.Row="2" Height="{DynamicResource Size.ActionBarHeight}" />
  </Grid>
</UserControl>
