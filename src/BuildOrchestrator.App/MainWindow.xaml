<Window x:Class="BuildOrchestrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildOrchestrator.App"
        xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
        xmlns:views="clr-namespace:BuildOrchestrator.App.Views"
        xmlns:services="clr-namespace:BuildOrchestrator.App.Services"
        Title="{x:Static services:AppIdentity.Product}" Width="1400" Height="800" WindowState="Maximized"
        Icon="pack://application:,,,/BuildOrchestrator.App;component/Assets/app-icon.ico"
        MinWidth="{DynamicResource Size.WindowMinWidth}" MinHeight="{DynamicResource Size.WindowMinHeight}"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.SurfaceBase}" Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
  <!-- [T35 fold #1] WindowChrome ARTIK KOD-TARAFI kurulur (MainWindow ctor): CaptionHeight + title-bar satır
       yüksekliği tek kaynaktan (Size.TitleBarHeight token) türetilir; XAML'de 40px literali KALMADI. WindowChrome
       bir Freezable olduğundan DynamicResource onda güvenilir çözülmez — kod-tarafı kurulum kesin çalışır. -->
  <Window.Resources>
    <!-- Title bar buton şablonu (min/max/close). Üçü de sıradan WPF butonudur: hover şablonun kendi IsMouseOver
         trigger'ından gelir, tıklama Click'ten. Renkler token'dan (hardcode YASAK). -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- [T64] Caption glyph'leri çizilmiş 10x10 1px-stroke geometri (Icons.xaml). Stretch="None": geometri kendi
         viewBox'unda (0..10) çizilir, ölçeklenmez. Stroke butonun Foreground'unu izler. -->
    <Style x:Key="CaptionGlyph" TargetType="Path">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- [T35] Title bar layout seçici ikonu (16 viewBox). Kontur butonun Foreground'unu (Ds.IconButton
         AnimatedForeground) izler; kalınlık ikonun kardeş StrokeThickness anahtarından. -->
    <Style x:Key="TitleBarIcon" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>
  </Window.Resources>
  <Border x:Name="RootShell">
    <Grid>
      <Grid.RowDefinitions>
        <!-- [T35 fold #1] Title bar yüksekliği kod-tarafı Size.TitleBarHeight'tan gelir (literal YOK). -->
        <RowDefinition x:Name="TitleRow" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ==================================== TITLE BAR ==================================== -->
      <!-- [A13/T3 fix-1 · P1+P2] design-v1 DS TitleBar (_ds_bundle.js:1184-1196) TEK stil bloğunda hem zemini
           (background: var(surface-base) = #0e0e10) hem alt çizgiyi (borderBottom: 1px solid var(border-subtle))
           verir; bu yüzden ikisini de AYNI öğe taşır → Grid değil Border. Eskiden zemin Brush.Surface (#141417)
           idi ve alt çizgi HİÇ YOKTU (title bar ile gövde arasında ayırıcı yok). Pin: MainWindowRealizeTests. -->
      <Border x:Name="TitleBarRow" Grid.Row="0" Background="{DynamicResource Brush.SurfaceBase}"
              BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <!-- Caption pencere butonları (min/max/close) — kabuk makinesi -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="OnMinimize"
                    AutomationProperties.Name="Minimize">
              <Path Style="{StaticResource CaptionGlyph}" Data="{DynamicResource Icon.CaptionMinimize}" />
            </Button>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore">
              <!-- Data'yı VE AutomationProperties.Name'i CaptionGlyphs.BindMaxButton sürer (K8) -->
              <Path x:Name="MaxGlyph" Style="{StaticResource CaptionGlyph}" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="OnClose"
                    AutomationProperties.Name="Close">
              <Path Style="{StaticResource CaptionGlyph}" Data="{DynamicResource Icon.CaptionClose}" />
            </Button>
          </StackPanel>

          <!-- Layout seçici (quad/list/focus) + 1px ayraç + gear -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
            <ToggleButton x:Name="LayQuadButton" Style="{DynamicResource Ds.IconButton.Toggle}" Click="OnLayoutQuad"
                          AutomationProperties.Name="Default layout — graph + list · console + stream (splits reset)">
              <ToggleButton.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">Default layout — graph + list · console + stream (splits reset)</ToolTip>
              </ToggleButton.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="16" Height="16">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.LayQuad}"
                        StrokeThickness="{DynamicResource Icon.LayQuad.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </ToggleButton>
            <ToggleButton x:Name="LayListButton" Style="{DynamicResource Ds.IconButton.Toggle}" Click="OnLayoutList"
                          AutomationProperties.Name="List layout — graph hidden · console + stream equal">
              <ToggleButton.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">List layout — graph hidden · console + stream equal</ToolTip>
              </ToggleButton.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="16" Height="16">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.LayList}"
                        StrokeThickness="{DynamicResource Icon.LayList.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </ToggleButton>
            <ToggleButton x:Name="LayFocusButton" Style="{DynamicResource Ds.IconButton.Toggle}" Click="OnLayoutFocus"
                          AutomationProperties.Name="Console focus — graph hidden · compact stream">
              <ToggleButton.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">Console focus — graph hidden · compact stream</ToolTip>
              </ToggleButton.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="16" Height="16">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.LayFocus}"
                        StrokeThickness="{DynamicResource Icon.LayFocus.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </ToggleButton>
            <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Border}" Margin="5,0" VerticalAlignment="Center" />
            <Button x:Name="GearButton" Style="{DynamicResource Ds.IconButton}" Click="OnSettings"
                    AutomationProperties.Name="Settings">
              <Button.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">Settings — layer definitions</ToolTip>
              </Button.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.Gear}"
                        StrokeThickness="{DynamicResource Icon.Gear.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </Button>
            <!-- [About] Gear'ın SAĞINDA, aynı grupta: grup kullanım sıklığı azalan sırada dizilir
                 (layout > settings > about) ve Windows/Office geleneğinde Help/About uygulama komutlarının en
                 sonundadır. Tooltip metni ELLE yazılmaz — ShortcutCatalog'dan gelir (kopya YASAK), o yüzden
                 kod-tarafı kurulur (MainWindow ctor). -->
            <Button x:Name="InfoButton" Style="{DynamicResource Ds.IconButton}" Click="OnAbout"
                    AutomationProperties.Name="{x:Static local:AccessibilityNames.About}">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.Info}"
                        StrokeThickness="{DynamicResource Icon.Info.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </Button>
          </StackPanel>

          <!-- Logo + ürün adı + mono bağlam metni (sürükleme alanı — hit-test-visible DEĞİL) -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <!-- [T35 → About] Logo ARTIK Controls/BrandLogo.xaml'de (tek çizim yeri — About hero'su aynı
                 kontrolü 20px'te kullanır). Burada yalnız yüksekliği verilir: design-v1 README §1.1/§2.1
                 "Delta logosu (dark varyant, 15px yükseklik)". -->
            <controls:BrandLogo x:Name="TitleBarLogo" Height="15" VerticalAlignment="Center" />
            <!-- [About] Ürün adı ARTIK literal DEĞİL: AppIdentity onu Directory.Build.props'un <Product>
                 değerinden okur. About hero'su da AYNI kaynağı kullanır (kopya YASAK). -->
            <TextBlock Text="{x:Static services:AppIdentity.Product}" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="{DynamicResource FontSize.Xs}" Foreground="{DynamicResource Brush.TextDim}" />
            <!-- [A13/T2 · 2.1] design-v1 §2.1 bağlamı: mono 11px, gövde text-dim + worktree eki text-faint.
                 METİN ARTIK KOD-TARAFI sürülür (MainWindow.RefreshTitleContext → TitleBarContext) — XAML'de
                 literal YOKTUR. Eski hâlinde "no repository" burada DONMUŞTU: repo/branch/worktree hiçbir
                 zaman başlığa ulaşmıyordu. İki AYRI TextBlock zorunlu: tek Text literali iki ton veremez. -->
            <!-- [T2 fix-1 · m5] MaxWidth ZORUNLU: yatay StackPanel çocuklarını SONSUZ genişlikle ölçer, yani
                 MaxWidth olmadan TextTrimming HİÇ devreye girmez ve uzun bir repo/branch adı caption
                 butonlarının altına sert kesilirdi. 320/200 için otorite SESSİZDİR (kaynak: bu iki sayı T2'nin
                 kendi kararıdır); pinlenen sayı değil DAVRANIŞTIR — bkz. TitleBarContextTests. -->
            <TextBlock x:Name="ContextText" VerticalAlignment="Center" Margin="8,0,0,0"
                       MaxWidth="320" TextTrimming="CharacterEllipsis"
                       FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.2xs}"
                       Foreground="{DynamicResource Brush.TextDim}" />
            <!-- [T2 fix-2 · m5 kalıntısı — ÖLÇÜLDÜ, marj BİLEREK KORUNDU] Otorite (BuildApp.jsx:1436-1444) gövde
                 ve worktree ekini İKİ AYRI span olarak, ebeveyn `inline-flex` konteynerin `gap: 8` (8px) ile
                 ayırdığı iki kutu olarak kurar; ekin KENDİ metni yalnız `· {wtName}` (dot+space, ayraç ÖNÜNDE
                 fazladan boşluk YOK — bkz. BuildApp.jsx:1442). Yani CSS `gap:8` ile gövde-içi `" · "` metin
                 ayracı OTORİTEDE de FARKLI iki mekanizmadır (kutular-arası boşluk vs. metin-içi karakter) —
                 aynı genişlikte olmaları BEKLENMEZ. Bu Margin=8,0,0,0, `gap:8`'in WPF karşılığıdır; TitleBarContext.
                 WorktreeSuffix zaten "· {name}" döndürür (ek boşluk eklemez). Kaldırılacak bir kusur DEĞİL. -->
            <TextBlock x:Name="ContextWorktreeText" VerticalAlignment="Center" Margin="8,0,0,0"
                       Visibility="Collapsed" MaxWidth="200" TextTrimming="CharacterEllipsis"
                       FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.2xs}"
                       Foreground="{DynamicResource Brush.TextFaint}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ==================================== GÖVDE ==================================== -->
      <local:ShellRoot x:Name="Shell" Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True" />

      <!-- [D7/T66] İlk modal: Settings diyaloğu. Scrim tüm pencereyi (başlık bandı dahil) kaplar; caption
           bölgesi üzerinde de tıklama alsın diye IsHitTestVisibleInChrome=True. Varsayılan Collapsed. -->
      <views:SettingsDialog x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

      <!-- [About] İkinci modal: About diyaloğu. Settings ile AYNI katman kuralları — scrim tüm pencereyi
           (başlık bandı dahil) kaplar, caption bölgesinde de tıklama alsın diye IsHitTestVisibleInChrome=True.
           İkisi aynı anda AÇILAMAZ (MainWindow.AnyDialogOpen kapısı). Varsayılan Collapsed. -->
      <views:AboutDialog x:Name="AboutOverlay" Grid.Row="0" Grid.RowSpan="2"
                         WindowChrome.IsHitTestVisibleInChrome="True" />
    </Grid>
  </Border>
</Window>
