<Window x:Class="BuildOrchestrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:views="clr-namespace:BuildOrchestrator.App.Views"
        xmlns:vm="clr-namespace:BuildOrchestrator.App.ViewModels"
        Title="Build Orchestrator" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- ===== Project card template ===== -->
        <DataTemplate DataType="{x:Type vm:ProjectCardViewModel}">
            <ContentControl>
                <ContentControl.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.FocusCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </ContentControl.InputBindings>
                <Border x:Name="CardBorder" CornerRadius="10"
                        Margin="0,5,6,5" Padding="0" BorderThickness="1.4" BorderBrush="#262B36">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource CardColor}" />
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- status accent bar (thickens when selected) -->
                        <Border Grid.Column="0" x:Name="Accent" Width="6" CornerRadius="10,0,0,10"
                                Background="{Binding Status, Converter={StaticResource StatusToBrush}}" />

                        <StackPanel Grid.Column="1" x:Name="CardText" Margin="12,10"
                                    RenderTransformOrigin="0,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform X="0" />
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding SolutionName}" Foreground="{StaticResource SubtleTextBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                                <Border Background="#7C2D12" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                        ToolTip="{Binding CycleTooltip}"
                                        Visibility="{Binding InCycle, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Cycle" Foreground="#FDBA74" FontSize="10" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- hover actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                            <Button Style="{StaticResource ToolButton}" Padding="6,3" Margin="2,0"
                                    ToolTip="Open in Explorer"
                                    Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Content="&#128193;" />
                            <Button Style="{StaticResource ToolButton}" Padding="6,3" Margin="2,0"
                                    ToolTip="Open in Visual Studio"
                                    Command="{Binding DataContext.OpenInVSCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Content="VS" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource ProjectCardStyle}">
                        <Style.Triggers>
                            <!-- failed: shake -->
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ShakeStoryboard}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>

                            <!-- skipped: fade + desaturate -->
                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>

                            <!-- filtered out: collapse -->
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <DataTemplate.Triggers>
                <!-- selected (console scoped to this project): the accent bar thickens and the
                     text slides inward — quick, animated, no border. -->
                <DataTrigger Binding="{Binding IsConsoleFocused}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Accent"
                                                 Storyboard.TargetProperty="Width"
                                                 To="13" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="7" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#252B36" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Accent"
                                                 Storyboard.TargetProperty="Width"
                                                 To="6" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="CardText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.12" />
                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="{StaticResource CardColor}" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Tray icon (Section 2) -->
        <tb:TaskbarIcon x:Name="Tray" ToolTipText="Build Orchestrator"
                        TrayMouseDoubleClick="Tray_OnDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Click="TrayOpen_OnClick" />
                    <MenuItem Header="Stop Build" Command="{Binding StopCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Click="TrayExit_OnClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="320" MaxWidth="760" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="2,0,2,10">
                <TextBlock Text="Build Orchestrator" Foreground="{StaticResource TextBrush}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SyncStatus}" Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Style="{StaticResource ToolButton}" Content="Settings"
                        HorizontalAlignment="Right" DockPanel.Dock="Right" Click="Settings_OnClick" />
            </DockPanel>

            <!-- Left: project list (virtualized) -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12"
                    Padding="10" Margin="0,0,0,0">
                <ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Draggable divider between the project list and the console -->
            <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                          Style="{StaticResource ColumnSplitter}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- Right: console -->
            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource ConsoleBg}" CornerRadius="12"
                    Padding="6" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="6,4,6,6">
                        <TextBlock Text="Console" Foreground="{StaticResource SubtleTextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="ConsoleList" ItemsSource="{Binding Console.Lines}"
                             Background="Transparent" BorderThickness="0" Foreground="#D0D0D0"
                             FontFamily="Consolas, Lucida Console, Courier New, monospace" FontSize="12.5"
                             views:AutoScrollBehavior.Enabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextWrapping="NoWrap"
                                           Foreground="{Binding Converter={StaticResource LineToBrush}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Bottom-left: sync + counts -->
            <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12"
                    Margin="0,10,0,0" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="&#8635; Sync"
                            Command="{Binding SyncCommand}" Margin="0,0,8,0" />
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource CountLabel}" Command="{Binding ToggleFilterCommand}" CommandParameter="Total">
                            <TextBlock><Run Text="Total " Foreground="#8A93A3" /><Run Text="{Binding Total, Mode=OneWay}" Foreground="#E6E8EC" FontWeight="Bold" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource CountLabel}" Command="{Binding ToggleFilterCommand}" CommandParameter="Built">
                            <TextBlock><Run Text="Built " Foreground="#8A93A3" /><Run Text="{Binding Built, Mode=OneWay}" Foreground="#93C5FD" FontWeight="Bold" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource CountLabel}" Command="{Binding ToggleFilterCommand}" CommandParameter="Succeeded">
                            <TextBlock><Run Text="OK " Foreground="#8A93A3" /><Run Text="{Binding Succeeded, Mode=OneWay}" Foreground="#22C55E" FontWeight="Bold" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource CountLabel}" Command="{Binding ToggleFilterCommand}" CommandParameter="Failed">
                            <TextBlock><Run Text="Fail " Foreground="#8A93A3" /><Run Text="{Binding Failed, Mode=OneWay}" Foreground="#EF4444" FontWeight="Bold" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource CountLabel}" Command="{Binding ToggleFilterCommand}" CommandParameter="Skipped">
                            <TextBlock><Run Text="Skip " Foreground="#8A93A3" /><Run Text="{Binding Skipped, Mode=OneWay}" Foreground="#94A3B8" FontWeight="Bold" /></TextBlock>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Bottom-right: branch + build controls -->
            <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12"
                    Margin="0,10,0,0" Padding="8">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Left" Width="220" ItemsSource="{Binding Branches}"
                              SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name"
                              VerticalContentAlignment="Center" Margin="0,0,8,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Build/Rebuild visible when idle -->
                        <Button Style="{StaticResource ToolButton}" Content="Rebuild" Margin="0,0,8,0"
                                Command="{Binding RebuildCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <Button Style="{StaticResource AccentButton}" Content="Build" Width="110"
                                Command="{Binding BuildCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <!-- Stop morph visible while running -->
                        <Button Width="110" Content="&#9632; Stop" Command="{Binding StopCommand}"
                                Background="#EF4444" BorderBrush="#EF4444" Foreground="White"
                                Style="{StaticResource ToolButton}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
