<Window x:Class="BuildOrchestrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildOrchestrator.App"
        xmlns:controls="clr-namespace:BuildOrchestrator.App.Controls"
        xmlns:views="clr-namespace:BuildOrchestrator.App.Views"
        Title="Build Orchestrator" Width="1400" Height="800"
        Icon="pack://application:,,,/BuildOrchestrator.App;component/Assets/app-icon.ico"
        MinWidth="{DynamicResource Size.WindowMinWidth}" MinHeight="{DynamicResource Size.WindowMinHeight}"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.SurfaceBase}" Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
  <!-- [T35 fold #1] WindowChrome ARTIK KOD-TARAFI kurulur (MainWindow ctor): CaptionHeight + title-bar satır
       yüksekliği tek kaynaktan (Size.TitleBarHeight token) türetilir; XAML'de 40px literali KALMADI. WindowChrome
       bir Freezable olduğundan DynamicResource onda güvenilir çözülmez — kod-tarafı kurulum kesin çalışır. -->
  <Window.Resources>
    <!-- [T62] Title bar buton şablonu. GEREKÇE: maximize butonu Snap Layouts için WM_NCHITTEST'te HTMAXBUTTON
         döndürür → o bölge NON-CLIENT olur ve WPF'in IsMouseOver'ı ORADA HİÇ TETİKLENMEZ; hover görseli elle
         (MainWindow.SetMaxButtonHover → Button.Background) sürülmek zorundadır ve bunun için Background'ı
         gerçekten boyayan bir şablon gerekir. Renkler token'dan (hardcode YASAK). -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- [T64] Caption glyph'leri çizilmiş 10x10 1px-stroke geometri (Icons.xaml). Stretch="None": geometri kendi
         viewBox'unda (0..10) çizilir, ölçeklenmez. Stroke butonun Foreground'unu izler. -->
    <Style x:Key="CaptionGlyph" TargetType="Path">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- [T35] Title bar layout seçici ikonu (16 viewBox). Kontur butonun Foreground'unu (Ds.IconButton
         AnimatedForeground) izler; kalınlık ikonun kardeş StrokeThickness anahtarından. -->
    <Style x:Key="TitleBarIcon" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>
  </Window.Resources>
  <Border x:Name="RootShell">
    <Grid>
      <Grid.RowDefinitions>
        <!-- [T35 fold #1] Title bar yüksekliği kod-tarafı Size.TitleBarHeight'tan gelir (literal YOK). -->
        <RowDefinition x:Name="TitleRow" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ==================================== TITLE BAR ==================================== -->
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Surface}">
        <DockPanel LastChildFill="False">
          <!-- Caption pencere butonları (min/max/close) — kabuk makinesi (Snap hook MaxButton'a ad ile bağlanır) -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="OnMinimize"
                    AutomationProperties.Name="Minimize">
              <Path Style="{StaticResource CaptionGlyph}" Data="{DynamicResource Icon.CaptionMinimize}" />
            </Button>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore">
              <!-- Data'yı VE AutomationProperties.Name'i CaptionGlyphs.BindMaxButton sürer (K8) -->
              <Path x:Name="MaxGlyph" Style="{StaticResource CaptionGlyph}" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="OnClose"
                    AutomationProperties.Name="Close">
              <Path Style="{StaticResource CaptionGlyph}" Data="{DynamicResource Icon.CaptionClose}" />
            </Button>
          </StackPanel>

          <!-- Layout seçici (quad/list/focus) + 1px ayraç + gear -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
            <ToggleButton x:Name="LayQuadButton" Style="{DynamicResource Ds.IconButton.Toggle}" Click="OnLayoutQuad"
                          AutomationProperties.Name="Default layout — graph + list · console + stream (splits reset)">
              <ToggleButton.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">Default layout — graph + list · console + stream (splits reset)</ToolTip>
              </ToggleButton.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="16" Height="16">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.LayQuad}"
                        StrokeThickness="{DynamicResource Icon.LayQuad.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </ToggleButton>
            <ToggleButton x:Name="LayListButton" Style="{DynamicResource Ds.IconButton.Toggle}" Click="OnLayoutList"
                          AutomationProperties.Name="List layout — graph hidden · console + stream equal">
              <ToggleButton.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">List layout — graph hidden · console + stream equal</ToolTip>
              </ToggleButton.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="16" Height="16">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.LayList}"
                        StrokeThickness="{DynamicResource Icon.LayList.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </ToggleButton>
            <ToggleButton x:Name="LayFocusButton" Style="{DynamicResource Ds.IconButton.Toggle}" Click="OnLayoutFocus"
                          AutomationProperties.Name="Console focus — graph hidden · compact stream">
              <ToggleButton.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">Console focus — graph hidden · compact stream</ToolTip>
              </ToggleButton.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="16" Height="16">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.LayFocus}"
                        StrokeThickness="{DynamicResource Icon.LayFocus.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </ToggleButton>
            <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Border}" Margin="5,0" VerticalAlignment="Center" />
            <Button x:Name="GearButton" Style="{DynamicResource Ds.IconButton}" Click="OnSettings"
                    AutomationProperties.Name="Settings">
              <Button.ToolTip>
                <ToolTip controls:AppTooltip.Side="Bottom">Settings — layer definitions</ToolTip>
              </Button.ToolTip>
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Style="{StaticResource TitleBarIcon}" Data="{DynamicResource Icon.Gear}"
                        StrokeThickness="{DynamicResource Icon.Gear.StrokeThickness}" />
                </Canvas>
              </Viewbox>
            </Button>
          </StackPanel>

          <!-- Logo + ürün adı + mono bağlam metni (sürükleme alanı — hit-test-visible DEĞİL) -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <!-- [T35] delta-logo-dark.svg → XAML Path'ler (design-v1 assets), 15px. Renkler token'dan
                 (amber accent + text-primary; hardcode YASAK). SVG grup/parça transform'ları birebir korunur. -->
            <Viewbox Height="15" Stretch="Uniform" VerticalAlignment="Center">
              <Canvas Width="132.574" Height="33">
                <Canvas Canvas.Left="0.5">
                  <Path Fill="{DynamicResource Brush.Amber}"
                        Data="M81.069,13.488a18.731,18.731,0,0,0-9.387-2.131q-10.078,1.258-14.308,9.1c-.09.164-.141.241-.141.241l-5.213-2.886.039-.085A23.486,23.486,0,0,1,66.288,6.258Q75.98,3.83,83.921,8.192Z">
                    <Path.RenderTransform><TranslateTransform X="48.153" Y="9.906" /></Path.RenderTransform>
                  </Path>
                  <Path Fill="{DynamicResource Brush.TextPrimary}"
                        Data="M3005.135-525.887h-5.406c0-.036,0-2.456-.007-4.057,0-.751,0-1.319,0-1.371a15.187,15.187,0,0,0-.754-4.8,16.807,16.807,0,0,1,4.247,1.6l1.228-2.259a22.232,22.232,0,0,1,.7,5.623l-.005,5.264Zm-21.159,0h-5.329l-.006-.172V-552.5l.164,0h5l.169,0v.045a19.672,19.672,0,0,1,7.76,1.533,24.336,24.336,0,0,1,6.99,4.6,24.465,24.465,0,0,1,3.743,4.93,23.149,23.149,0,0,0-7.361-1.18l-.343,0a22.99,22.99,0,0,0-2.541-2.1,16.3,16.3,0,0,0-8.247-2.405v21.011l0,.171Zm-21.043,0h-5l-.164-.008v-21.521c-.372.043-.749.095-1.151.159a17.271,17.271,0,0,0-7.721,4.281l-3.835-3.811a20.64,20.64,0,0,1,6.669-4.462,24.381,24.381,0,0,1,8.309-1.75,23.48,23.48,0,0,1,8.45,1.631,20.786,20.786,0,0,1,6.874,4.581l.051.06-3.823,3.807s-.058-.059-.177-.172a14.931,14.931,0,0,0-8.315-4.255v21.453Zm-12.848,0h-16.178l0-.172v-4.971l0-.164v-21.147l0-.168h5.333l.007.168v21.147h10.841l.168-.007v5.305Zm-19.369,0H2903.96a.2.2,0,0,1,0-.02c0-.033-.005-.112-.005-.229a25.179,25.179,0,0,1,1.854-9.569,29.1,29.1,0,0,1,5.567-8.594,26.844,26.844,0,0,1,7.666-5.552,25.648,25.648,0,0,1,11-2.655h.671l0,.168v5.213a3.3,3.3,0,0,1-.382.012,28.8,28.8,0,0,0-2.955.163c-1.134.114-2.848.285-6.581,2.157a17.988,17.988,0,0,0-3.541,2.388h13.29l.169.162v5.058l0,.168h-18.193a20.056,20.056,0,0,0-2.484,5.74h20.5l.169.166v5.054l0,.171Zm-29.953,0H2874v-26.62h1.419a21.185,21.185,0,0,1,7.074,1.287,33.344,33.344,0,0,1,7.428,3.856c7.193,5.733,10.841,12.959,10.841,21.476Zm-21.426-20.646v15.255h15.338a22.076,22.076,0,0,0-4.584-8.7,22.167,22.167,0,0,0-10.754-6.551Z">
                    <Path.RenderTransform><TranslateTransform X="-2874" Y="557.887" /></Path.RenderTransform>
                  </Path>
                </Canvas>
              </Canvas>
            </Viewbox>
            <TextBlock Text="Build Orchestrator" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="{DynamicResource FontSize.Xs}" Foreground="{DynamicResource Brush.TextDim}" />
            <!-- [A13/T2 · 2.1] design-v1 §2.1 bağlamı: mono 11px, gövde text-dim + worktree eki text-faint.
                 METİN ARTIK KOD-TARAFI sürülür (MainWindow.RefreshTitleContext → TitleBarContext) — XAML'de
                 literal YOKTUR. Eski hâlinde "no repository" burada DONMUŞTU: repo/branch/worktree hiçbir
                 zaman başlığa ulaşmıyordu. İki AYRI TextBlock zorunlu: tek Text literali iki ton veremez. -->
            <TextBlock x:Name="ContextText" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.2xs}"
                       Foreground="{DynamicResource Brush.TextDim}" />
            <TextBlock x:Name="ContextWorktreeText" VerticalAlignment="Center" Margin="8,0,0,0"
                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                       FontFamily="{x:Static controls:AppFonts.Mono}" FontSize="{DynamicResource FontSize.2xs}"
                       Foreground="{DynamicResource Brush.TextFaint}" />
          </StackPanel>
        </DockPanel>
      </Grid>

      <!-- ==================================== GÖVDE ==================================== -->
      <local:ShellRoot x:Name="Shell" Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True" />

      <!-- [D7/T66] İlk modal: Settings diyaloğu. Scrim tüm pencereyi (başlık bandı dahil) kaplar; caption
           bölgesi üzerinde de tıklama alsın diye IsHitTestVisibleInChrome=True. Varsayılan Collapsed. -->
      <views:SettingsDialog x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
    </Grid>
  </Border>
</Window>
