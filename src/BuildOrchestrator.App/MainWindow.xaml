<Window x:Class="BuildOrchestrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appConsole="clr-namespace:BuildOrchestrator.App.Console"
        Title="Build Orchestrator" Width="1400" Height="800"
        Icon="pack://application:,,,/BuildOrchestrator.App;component/Assets/app-icon.ico"
        MinWidth="{DynamicResource Size.WindowMinWidth}" MinHeight="{DynamicResource Size.WindowMinHeight}"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.SurfaceBase}" Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- [T62] Title bar buton şablonu. GEREKÇE: maximize butonu Snap Layouts için WM_NCHITTEST'te HTMAXBUTTON
         döndürür → o bölge NON-CLIENT olur ve WPF'in IsMouseOver'ı ORADA HİÇ TETİKLENMEZ; hover görseli elle
         (MainWindow.SetMaxButtonHover → Button.Background) sürülmek zorundadır ve bunun için Background'ı
         gerçekten boyayan bir şablon gerekir. Renkler token'dan (hardcode YASAK). Tasarımın tam title bar
         birebirliği (10x10 1px stroke ikonlar, close hover = status-fail) T60'tır. -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- [T64] Caption glyph'leri artık KARAKTER değil, Icons.xaml'deki çizilmiş 10x10 1px-stroke geometri.
         Stretch="None": geometri kendi viewBox koordinatlarında (0..10) çizilir, ölçeklenmez — SVG ile birebir.
         Stroke, butonun Foreground'unu izler (hover/close-fail rengi T60'ta oradan sürülecek). -->
    <Style x:Key="CaptionGlyph" TargetType="Path">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
  </Window.Resources>
  <Border x:Name="RootShell">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" /><RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Background="{DynamicResource Brush.Surface}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- DynamicResource (StaticResource DEĞİL): merge zinciri olmayan bir bağlamda StaticResource
               yükleme anında throw ederdi; DynamicResource sessizce çözümsüz kalır (LatestPill ile aynı gerekçe). -->
          <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="OnMinimize">
            <Path Style="{StaticResource CaptionGlyph}" Data="{DynamicResource Icon.CaptionMinimize}" />
          </Button>
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore">
            <!-- Data'yı CaptionGlyphs.BindMaxButton sürer (K8: maximize'da restore glyph'i) -->
            <Path x:Name="MaxGlyph" Style="{StaticResource CaptionGlyph}" />
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="OnClose">
            <Path Style="{StaticResource CaptionGlyph}" Data="{DynamicResource Icon.CaptionClose}" />
          </Button>
        </StackPanel>
        <TextBlock Text="Build Orchestrator" VerticalAlignment="Center" Margin="12,0" />
      </DockPanel>

      <!-- [Task 12] It-2 fonksiyonel iskele: repo kökü + Rebuild/Stop/Continue + proje listesi + konsol.
           design-v1 birebirliği (kartlar, graf paneli, sticky şerit) It-4'tür — burada YOK (YAGNI). -->
      <Grid Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10" WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock x:Name="EngineStatusText" Text="engine: starting…" FontSize="12" />
          <Button x:Name="RestartEngineButton" Content="Restart engine" Margin="0,4,0,8"
                  Visibility="Collapsed" Click="OnRestartEngine" HorizontalAlignment="Left" />

          <TextBlock Text="Repo kökü" FontSize="11" Margin="0,8,0,2" />
          <TextBox x:Name="RootPathBox" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Rebuild" Command="{Binding RebuildCommand}" Margin="0,0,6,0" />
            <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,6,0" />
            <Button Content="Continue" Command="{Binding ContinueCommand}" />
          </StackPanel>

          <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="12" Margin="0,8,0,8" />

          <ListBox x:Name="ProjectsList" ItemsSource="{Binding Projects}" Height="420"
                   SelectionChanged="OnProjectSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" Width="170" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding State}" Width="70" />
                  <TextBlock Text="{Binding DurationMsText}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="0,10,10,10">
          <appConsole:ConsoleHeader x:Name="ConsoleHeaderControl" DockPanel.Dock="Top" Margin="0,0,0,6" />
          <appConsole:ConsoleView x:Name="ConsoleViewControl" />
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
