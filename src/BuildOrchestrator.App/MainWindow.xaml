<Window x:Class="BuildOrchestrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Orchestrator" Width="1400" Height="800" MinWidth="1240" MinHeight="620"
        WindowStyle="SingleBorderWindow" Background="#0F1115" Foreground="#D7DBE0"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border x:Name="RootShell">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" /><RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Background="#14171C">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinButton" Content="&#x2013;" Width="46" Click="OnMinimize" />
          <Button x:Name="MaxButton" Content="&#x25A1;" Width="46" Click="OnMaximizeRestore" />
          <Button x:Name="CloseButton" Content="&#x2715;" Width="46" Click="OnClose" />
        </StackPanel>
        <TextBlock Text="Build Orchestrator" VerticalAlignment="Center" Margin="12,0" />
      </DockPanel>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="EngineStatusText" Text="engine: starting…" FontSize="13" HorizontalAlignment="Center" />
        <Button x:Name="RestartEngineButton" Content="Restart engine" Margin="0,8,0,0"
                Visibility="Collapsed" Click="OnRestartEngine" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
