<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- [D1] Dağıtım kimliği — TEK yer. Version'dan Assembly/File/InformationalVersion türetilir; Supervisor
         motor sürümünü kendi assembly'sinden okuyup EngineReadyEvent ile bildirdiğinden (SupervisorHost.cs)
         buradaki değer App'in "engine v…" göstergesine kadar akar. Publish edilen exe'nin dosya özelliklerinde
         de Product/Version bu değerlerdir.
         [sürüm notları] Yalnız bir sürüm çıkarılırken artar (CLAUDE.md "Sürüm çıkarma"): CHANGELOG.md'deki en üst
         sürüm bu değere eşit olmak zorundadır (WhatsNewTests) ve git tag'i v + bu değerdir. InformationalVersion
         ayrıca yazılmaz — SDK onu Version'dan türetir, ekran yalın "1.7.0" gösterir (PublishLayoutTests). -->
    <Version>1.8.0</Version>
    <!-- SDK varsayılanı InformationalVersion'a commit sha ekler ("1.7.0+<sha>"): sürüm hem deterministik
         kalsın hem de ekranda ve konsolun boot satırında yalın okunsun diye kapatıldı. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Build Orchestrator</Product>
    <Company>Delta</Company>
    <!-- [About] Telif TEK PARÇA burada yazılır: About sekmesinin Copyright satırı (ve exe'nin dosya
         özellikleri) AssemblyCopyrightAttribute'tan okur, yıl ile şirket adını UI'da birleştirmez (DateTime.Now.Year bir telif yılı DEĞİLDİR). -->
    <Copyright>© 2026 Delta Yazılım</Copyright>
  </PropertyGroup>
</Project>
